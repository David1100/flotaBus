---
import Base from '../layouts/Base.astro';
---
<Base title="Acceso · flotaBus">
  <main class="relative grid min-h-screen place-items-center overflow-hidden p-[clamp(1.25rem,4vw,3.5rem)] max-md:p-4">
    <div class="absolute top-[-24rem] right-[-10rem] h-[42rem] w-[42rem] rounded-full border border-[rgba(72,228,224,.12)] shadow-[0_0_100px_rgba(27,55,64,.55)] pointer-events-none max-md:hidden" aria-hidden="true"></div>
    <div class="absolute bottom-[-19rem] left-[-12rem] h-[28rem] w-[28rem] rounded-full border border-[rgba(72,228,224,.12)] pointer-events-none max-md:hidden" aria-hidden="true"></div>
    <div class="relative z-[1] grid w-[min(1160px,100%)] items-center gap-[clamp(3rem,8vw,8rem)] grid-cols-[minmax(0,1.08fr)_minmax(360px,.72fr)] max-[800px]:max-w-[520px] max-[800px]:grid-cols-1 max-[800px]:gap-8 max-md:block max-md:max-w-[28rem]">
      <section class="fade-in max-w-[590px] py-4 max-[800px]:p-0 max-md:hidden" aria-labelledby="login-intro-title">
        <div class="text-[.64rem] font-extrabold uppercase tracking-[.2em] text-[var(--amber)]">OPERACIONES · 04:20 UTC</div>
        <div class="my-[1.65rem] mb-[1.35rem] h-px w-16 bg-[var(--amber)] shadow-[0_0_18px_rgba(245,173,75,.65)]" aria-hidden="true"></div>
        <h1 id="login-intro-title" class="m-0 font-display text-[clamp(3.5rem,7vw,6.6rem)] font-bold leading-[.9] tracking-[-.07em] text-[var(--ink)] max-[800px]:text-[clamp(3rem,13vw,5rem)]">Cada salida empieza con <span class="text-[var(--cyan)]">control.</span></h1>
        <p class="mt-8 max-w-[30rem] text-[1.08rem] leading-[1.65] text-[var(--muted)]">La consola nocturna para mantener tu flota en movimiento, con el equipo correcto detrás de cada volante.</p>
        <div class="mt-14 flex flex-wrap gap-[.6rem] max-[800px]:hidden" aria-label="Características de la plataforma">
          <span class="rounded-full border border-[rgba(234,239,226,.14)] px-[.8rem] py-[.6rem] text-[.66rem] font-bold tracking-[.12em] text-[var(--subtle)]">RUTA SEGURA</span><span class="rounded-full border border-[rgba(234,239,226,.14)] px-[.8rem] py-[.6rem] text-[.66rem] font-bold tracking-[.12em] text-[var(--subtle)]">LIVE OPS</span>
        </div>
      </section>

      <section class="glass fade-in mx-auto flex w-full max-w-[440px] flex-col rounded-[2rem] p-[clamp(1.6rem,4vw,2.7rem)] max-md:max-w-none max-md:p-[clamp(1.35rem,6vw,2rem)]" aria-labelledby="login-title">
        <div class="text-[.64rem] font-extrabold uppercase tracking-[.2em] text-[var(--amber)]">BIENVENIDO DE VUELTA</div>
        <h2 id="login-title" class="mx-0 mb-[.45rem] mt-[.7rem] font-display text-[2rem] font-bold leading-[1.1] tracking-[-.04em] text-[var(--ink)]">Inicia sesión</h2>
        <p class="mb-8 mt-0 text-[.88rem] text-[var(--muted)]">Entra con tus credenciales de operación.</p>
        <form id="login" class="grid gap-4" data-login-form>
          <label for="username" class="text-[.82rem] text-[#c9d2cc]">Usuario<input id="username" class="input mt-2 block px-4 py-[.9rem] max-md:text-base" autocomplete="username" required minlength="3" /></label>
          <label for="password" class="text-[.82rem] text-[#c9d2cc]">Contraseña<input id="password" class="input mt-2 block px-4 py-[.9rem] max-md:text-base" type="password" autocomplete="current-password" required minlength="8" /></label>
          <p id="error" class="-mt-[.1rem] min-h-5 text-[.8rem] leading-[1.4] text-[#ff9daa]" aria-live="polite"></p>
          <button id="submit" class="btn btn-primary flex w-full items-center justify-between px-[1.1rem] py-[.95rem] disabled:cursor-wait disabled:translate-y-0 disabled:opacity-70" type="submit">Entrar a la consola <span aria-hidden="true">↗</span></button>
        </form>
        <p class="mb-0 mt-8 text-center text-[.68rem] text-[var(--subtle)]"><span class="mr-[.3rem] text-[var(--amber)]" aria-hidden="true">◈</span> Acceso protegido · Sesión cifrada</p>
        <footer class="mt-[2.4rem] flex items-center justify-end gap-3 border-t border-[var(--line)] pt-[1.6rem] max-md:mt-6 max-md:justify-center max-md:pt-[1.1rem]" aria-label="Marca flotaBus">
          <div class="grid h-10 w-10 place-items-center rounded-[.8rem] bg-[linear-gradient(135deg,var(--amber),#f8d477)] font-display text-[.95rem] font-bold text-[#10211c] shadow-[0_8px_22px_rgba(245,173,75,.18)]" aria-hidden="true">fb</div>
          <div class="text-right max-md:text-left"><strong class="block font-display text-base font-bold tracking-[-.02em] text-[var(--ink)]">flotaBus</strong><span class="mt-[.15rem] block text-[.7rem] uppercase tracking-[.12em] text-[var(--subtle)] max-md:hidden">control de operaciones</span></div>
        </footer>
      </section>
    </div>
  </main>
</Base>

<script>
  import { api, ApiError, CSRF_TOKEN_KEY, SESSION_TOKEN_KEY, clearAuthTokens } from '../lib/api';
  import { feedback, Swal } from '../lib/feedback';
  function initLogin() {
    const form = document.querySelector<HTMLFormElement>('[data-login-form]');
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';
    const button = form.querySelector<HTMLButtonElement>('#submit');
    const error = form.querySelector<HTMLParagraphElement>('#error');
    const usernameInput = form.querySelector<HTMLInputElement>('#username');
    const passwordInput = form.querySelector<HTMLInputElement>('#password');
    if (!button || !error || !usernameInput || !passwordInput) return;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      event.stopPropagation();
      button.disabled = true;
      button.innerHTML = '<span class="inline-flex items-center gap-2">Verificando <span class="animate-pulse">•••</span></span>';
      error.textContent = '';
      let loginSucceeded = false;
      try {
        feedback.loading('Verificando tus credenciales…');
        clearAuthTokens();
        const result = await api('/auth/login', { method: 'POST', body: JSON.stringify({ username: usernameInput.value.trim(), password: passwordInput.value }) });
        if (result.token && result.csrfToken) {
          sessionStorage.setItem(SESSION_TOKEN_KEY, result.token);
          sessionStorage.setItem(CSRF_TOKEN_KEY, result.csrfToken);
        }
        loginSucceeded = true;
        // Confirm the HttpOnly session cookie is usable before changing the page.
        const me = await api('/auth/me');
        Swal.close();
        await feedback.success('Sesión iniciada. Preparando tu consola…', 'Acceso concedido');
        const target = me?.rol === 'CHOFER' ? '/chofer/dashboard' : '/admin';
        window.location.assign(target);
      } catch (cause) {
        const message = cause instanceof ApiError && cause.status === 401 && !loginSucceeded
          ? 'Usuario o contraseña incorrectos. Verifica tus datos e inténtalo de nuevo.'
          : cause instanceof Error ? cause.message : 'No pudimos verificar la sesión.';
        if (!loginSucceeded) clearAuthTokens();
        error.textContent = message;
        Swal.close();
        await feedback.error(message, cause instanceof ApiError && cause.status === 401 && !loginSucceeded ? 'Credenciales no válidas' : 'No se pudo verificar la sesión');
      } finally {
        button.disabled = false;
        button.innerHTML = 'Entrar a la consola <span>↗</span>';
      }
    });
  }

  document.addEventListener('astro:page-load', initLogin);
  initLogin();
</script>
