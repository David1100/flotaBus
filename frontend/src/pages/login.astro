---
import Base from '../layouts/Base.astro';
---
<Base title="Acceso · flotaBus">
  <main class="login-page">
    <div class="login-orbit login-orbit-one" aria-hidden="true"></div>
    <div class="login-orbit login-orbit-two" aria-hidden="true"></div>
    <div class="login-layout">
      <section class="login-intro fade-in" aria-labelledby="login-intro-title">
        <div class="eyebrow">OPERACIONES · 04:20 UTC</div>
        <div class="intro-rule" aria-hidden="true"></div>
        <h1 id="login-intro-title">Cada salida empieza con <span>control.</span></h1>
        <p>La consola nocturna para mantener tu flota en movimiento, con el equipo correcto detrás de cada volante.</p>
        <div class="intro-pills" aria-label="Características de la plataforma">
          <span>RUTA SEGURA</span><span>LIVE OPS</span>
        </div>
      </section>

      <section class="login-card fade-in" aria-labelledby="login-title">
        <div class="eyebrow">BIENVENIDO DE VUELTA</div>
        <h2 id="login-title">Inicia sesión</h2>
        <p class="login-subtitle">Entra con tus credenciales de operación.</p>
        <form id="login" class="login-form" data-login-form>
          <label for="username">Usuario<input id="username" class="input" autocomplete="username" required minlength="3" /></label>
          <label for="password">Contraseña<input id="password" class="input" type="password" autocomplete="current-password" required minlength="8" /></label>
          <p id="error" class="login-error" aria-live="polite"></p>
          <button id="submit" class="btn btn-primary login-submit" type="submit">Entrar a la consola <span aria-hidden="true">↗</span></button>
        </form>
        <p class="login-security"><span aria-hidden="true">◈</span> Acceso protegido · Sesión cifrada</p>
        <footer class="login-brand" aria-label="Marca flotaBus">
          <div class="brand-mark" aria-hidden="true">fb</div>
          <div><strong>flotaBus</strong><span>control de operaciones</span></div>
        </footer>
      </section>
    </div>
  </main>
</Base>

<style>
  .login-page { min-height: 100vh; position: relative; overflow: hidden; padding: clamp(1.25rem, 4vw, 3.5rem); display: grid; place-items: center; }
  .login-layout { width: min(1160px, 100%); display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(360px, .72fr); gap: clamp(3rem, 8vw, 8rem); align-items: center; position: relative; z-index: 1; }
  .login-intro { max-width: 590px; padding: 1rem 0; }
  .intro-rule { width: 4rem; height: 1px; margin: 1.65rem 0 1.35rem; background: var(--amber); box-shadow: 0 0 18px rgba(245, 173, 75, .65); }
  .login-intro h1 { font: 700 clamp(3.5rem, 7vw, 6.6rem)/.9 'Outfit', sans-serif; letter-spacing: -.07em; margin: 0; color: var(--ink); }
  .login-intro h1 span { color: var(--cyan); }
  .login-intro p { color: var(--muted); font-size: 1.08rem; line-height: 1.65; max-width: 30rem; margin: 2rem 0 0; }
  .intro-pills { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 3.5rem; }
  .intro-pills span { border: 1px solid rgba(234, 239, 226, .14); border-radius: 999px; color: var(--subtle); font-size: .66rem; font-weight: 700; letter-spacing: .12em; padding: .6rem .8rem; }
  .login-card { width: 100%; max-width: 440px; border-radius: 2rem; padding: clamp(1.6rem, 4vw, 2.7rem); margin-inline: auto; display: flex; flex-direction: column; }
  .login-card h2 { font: 700 2rem/1.1 'Outfit', sans-serif; letter-spacing: -.04em; margin: .7rem 0 .45rem; color: var(--ink); }
  .login-subtitle { color: var(--muted); font-size: .88rem; margin: 0 0 2rem; }
  .login-form { display: grid; gap: 1rem; }
  .login-form label { color: #c9d2cc; font-size: .82rem; }
  .login-form .input { display: block; margin-top: .5rem; padding: .9rem 1rem; }
  .login-error { min-height: 1.25rem; color: #ff9daa; font-size: .8rem; line-height: 1.4; margin: -.1rem 0 0; }
  .login-submit { width: 100%; display: flex; align-items: center; justify-content: space-between; padding: .95rem 1.1rem; }
  .login-submit:disabled { cursor: wait; opacity: .7; transform: none; }
  .login-security { color: var(--subtle); font-size: .68rem; text-align: center; margin: 2rem 0 0; }
  .login-security span { color: var(--amber); margin-right: .3rem; }
  .login-brand { display: flex; align-items: center; justify-content: flex-end; gap: .75rem; margin-top: 2.4rem; padding-top: 1.6rem; border-top: 1px solid var(--line); }
  .login-brand > div:last-child { text-align: right; }
  .brand-mark { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: .8rem; color: #10211c; background: linear-gradient(135deg, var(--amber), #f8d477); font: 700 .95rem 'Outfit', sans-serif; box-shadow: 0 8px 22px rgba(245, 173, 75, .18); }
  .login-brand strong, .login-brand span { display: block; }
  .login-brand strong { font: 700 1rem 'Outfit', sans-serif; color: var(--ink); letter-spacing: -.02em; }
  .login-brand span { color: var(--subtle); font-size: .7rem; margin-top: .15rem; letter-spacing: .12em; text-transform: uppercase; }
  .login-orbit { position: absolute; border: 1px solid rgba(72, 228, 224, .12); border-radius: 50%; pointer-events: none; }
  .login-orbit-one { width: 42rem; height: 42rem; top: -24rem; right: -10rem; box-shadow: 0 0 100px rgba(27, 55, 64, .55); }
  .login-orbit-two { width: 28rem; height: 28rem; bottom: -19rem; left: -12rem; }
  @media (max-width: 800px) { .login-layout { grid-template-columns: 1fr; gap: 2rem; max-width: 520px; } .login-intro { padding: 0; } .login-intro h1 { font-size: clamp(3rem, 13vw, 5rem); } .login-intro p, .intro-pills { margin-top: 1.2rem; } .intro-pills { display: none; } .login-brand { justify-content: center; } .login-brand > div:last-child { text-align: left; } }
</style>
<script>
  import { api, ApiError } from '../lib/api';
  import { feedback, Swal } from '../lib/feedback';
  function initLogin() {
    const form = document.querySelector<HTMLFormElement>('[data-login-form]');
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';
    const button = form.querySelector<HTMLButtonElement>('#submit');
    const error = form.querySelector<HTMLParagraphElement>('#error');
    const usernameInput = form.querySelector<HTMLInputElement>('#username');
    const passwordInput = form.querySelector<HTMLInputElement>('#password');
    if (!button || !error || !usernameInput || !passwordInput) return;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      event.stopPropagation();
      button.disabled = true;
      button.innerHTML = '<span class="inline-flex items-center gap-2">Verificando <span class="animate-pulse">•••</span></span>';
      error.textContent = '';
      try {
        feedback.loading('Verificando tus credenciales…');
        await api('/auth/login', { method: 'POST', body: JSON.stringify({ username: usernameInput.value.trim(), password: passwordInput.value }) });
        // Confirm the HttpOnly session cookie is usable before changing the page.
        await api('/auth/me');
        Swal.close();
        await feedback.success('Sesión iniciada. Preparando tu consola…', 'Acceso concedido');
        window.location.assign('/admin');
      } catch (cause) {
        const message = cause instanceof ApiError && cause.status === 401 ? 'Usuario o contraseña incorrectos. Verifica tus datos e inténtalo de nuevo.' : cause instanceof Error ? cause.message : 'No pudimos iniciar sesión.';
        error.textContent = message;
        Swal.close();
        await feedback.error(message, cause instanceof ApiError && cause.status === 401 ? 'Credenciales no válidas' : 'No se pudo iniciar sesión');
      } finally {
        button.disabled = false;
        button.innerHTML = 'Entrar a la consola <span>↗</span>';
      }
    });
  }

  document.addEventListener('astro:page-load', initLogin);
  initLogin();
</script>
