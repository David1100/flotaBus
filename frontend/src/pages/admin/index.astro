---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Dashboard · flotaBus" active="dashboard">
  <div class="mx-auto min-w-0 max-w-[1260px]">
     <header class="fade-in mb-[2.2rem] flex items-end justify-between gap-8 border-b border-[var(--line)] pb-7 max-md:mb-6 max-md:flex-col max-md:items-start max-md:gap-[1.4rem]">
        <div class="min-w-0">
        <div class="text-[.64rem] font-extrabold uppercase tracking-[.2em] text-[var(--amber)]">CONTROL DE FLOTA <span class="text-[var(--subtle)]">/</span> TURNO 01</div>
         <h1 class="my-[.6rem] mb-[.8rem] font-display text-[clamp(3.2rem,7vw,6.4rem)] font-semibold leading-[.84] tracking-[-.08em] text-[var(--ink)] max-[430px]:text-[clamp(2.9rem,15vw,4.4rem)] max-[430px]:[overflow-wrap:anywhere]">La operación<br /><em class="not-italic text-[var(--cyan)]">en una mirada.</em></h1>
         <p class="m-0 text-[.83rem] text-[var(--muted)] max-[430px]:max-w-[28ch] max-[430px]:leading-[1.45]">Lectura en tiempo real de disponibilidad, cobertura y asignaciones.</p>
      </div>
        <div class="grid min-w-56 gap-[.45rem] border-l border-[var(--amber)] py-0 pb-[.2rem] pl-4 max-md:w-full max-md:min-w-0 max-md:pl-3" aria-label="Estado del sistema">
        <span class="flex items-center gap-2 text-[.68rem] font-extrabold uppercase tracking-[.11em] text-[var(--cyan)]"><i class="status-dot" aria-hidden="true"></i> Sistema operativo</span>
        <strong id="period-note" class="font-display text-base font-medium text-[var(--ink)]">Periodo actual</strong>
        <small class="text-[.64rem] text-[var(--subtle)]">Última consulta del centro de control</small>
      </div>
    </header>

      <section class="fade-in grid grid-cols-[1.15fr_repeat(4,minmax(7rem,1fr))_auto] items-end gap-[.9rem] border-b border-[var(--line)] py-3 pb-4 max-lg:grid-cols-4 max-md:grid-cols-2 max-md:gap-[.65rem] mb-5" style="animation-delay:.05s" aria-label="Filtros del dashboard">
       <div class="grid min-w-0 content-center gap-1 pl-[.2rem] max-lg:col-span-full"><span class="text-[.64rem] font-extrabold uppercase tracking-[.2em] text-[var(--amber)]">CONSULTA</span><strong class="font-display text-base font-medium text-[var(--ink)]">Rango operativo</strong></div>
      <label><span>Desde</span><input class="input" id="from" type="date" /></label>
      <label><span>Hasta</span><input class="input" id="to" type="date" /></label>
      <label><span>Bus</span><select class="input" id="bus"><option value="">Todos los buses</option></select></label>
      <label><span>Estado</span><select class="input" id="status"><option value="">Todos</option><option value="AVAILABLE">Disponible</option><option value="ASSIGNED">Asignado</option><option value="IN_TRANSIT">En ruta</option><option value="MAINTENANCE">Mantenimiento</option><option value="STOPPED">Detenido</option><option value="INCIDENT">Incidente</option></select></label>
       <button class="btn btn-primary max-lg:col-start-4 max-md:col-span-full max-md:col-start-auto" id="apply" type="button">Actualizar <span aria-hidden="true">↗</span></button>
    </section>

    <div id="dashboard-state" class="my-4 text-center text-[.78rem] text-[var(--muted)]" role="status" aria-live="polite">Cargando resumen…</div>

      <main id="dashboard-content" class="grid min-w-0 grid-cols-[minmax(0,1.35fr)_minmax(15rem,.65fr)] gap-[.85rem] max-md:block" hidden>
        <section class="min-h-[24rem] min-w-0 overflow-hidden rounded-[1.25rem] border border-[rgba(72,228,224,.16)] bg-[linear-gradient(110deg,rgba(22,42,45,.88),rgba(10,17,21,.98)_70%)] px-[clamp(1.1rem,3vw,2.25rem)] pb-[1.7rem] pt-[1.35rem] shadow-[0_16px_34px_rgba(0,0,0,.12),inset_0_1px_rgba(255,255,255,.025)] max-md:min-h-[21rem] max-md:px-4" aria-labelledby="readiness-title">
        <div class="flex items-center gap-[.55rem] text-[.6rem] font-extrabold uppercase tracking-[.14em] text-[var(--subtle)] max-md:flex-wrap max-md:gap-y-[.35rem]"><span class="font-display text-[var(--amber)]">01</span><span>Señal principal</span><i class="h-px w-[2.3rem] bg-[rgba(234,239,226,.15)] max-md:flex-1 max-md:min-w-4"></i><time class="text-[var(--cyan)]">LIVE</time></div>
         <div class="mt-[2.2rem] flex items-start justify-between gap-4 max-md:mt-7 max-[379px]:gap-[.55rem]"><div class="min-w-0"><h2 id="readiness-title" class="m-0 font-display text-[clamp(1.65rem,3vw,2.5rem)] font-medium leading-[.94] tracking-[-.06em] text-[var(--ink)] max-md:text-[clamp(1.55rem,6vw,2.5rem)]">Disponibilidad<br /><em class="not-italic text-[var(--cyan)]">de flota</em></h2><p id="coverage-summary" class="mb-0 mt-[.6rem] text-[.74rem] leading-[1.45] text-[var(--muted)] max-[379px]:max-w-[24ch]">Lectura de unidades listas para sostener la operación.</p></div><span class="flex-none text-[4rem] leading-[.6] text-[var(--cyan)] opacity-75" aria-hidden="true">◌</span></div>
         <div class="mb-[1.3rem] mt-[2.6rem] flex items-baseline gap-4 max-md:my-8 max-md:mb-4 max-[379px]:gap-[.65rem]"><strong id="coverage-percent" class="font-display text-[clamp(5rem,12vw,9rem)] font-medium leading-[.7] tracking-[-.1em] text-[var(--cyan)] max-md:text-[clamp(4rem,25vw,7rem)] max-[379px]:text-[clamp(4rem,24vw,5.5rem)]">—</strong><span class="text-[.68rem] uppercase leading-[1.3] tracking-[.1em] text-[var(--muted)] max-[379px]:text-[.58rem]">cobertura<br />operativa</span></div>
        <div class="h-[.45rem] overflow-hidden rounded-[.35rem] bg-[rgba(234,239,226,.1)]" aria-label="Cobertura operativa"><i id="coverage-meter" class="block h-full w-0 bg-[var(--cyan)] transition-[width] duration-700 ease-out"></i></div>
       <div class="mt-4 flex flex-wrap gap-x-[1.4rem] gap-y-[.8rem] text-[.67rem] text-[var(--muted)] max-[430px]:grid max-[430px]:gap-[.55rem]"><span class="inline-flex items-center gap-[.35rem] min-w-0"><i class="h-[.45rem] w-[.45rem] rounded-full bg-[var(--cyan)]"></i><b id="coverage-covered" class="text-[var(--ink)]">—</b> disponibles / en ruta</span><span class="inline-flex items-center gap-[.35rem] min-w-0"><i class="h-[.45rem] w-[.45rem] rounded-full bg-[var(--amber)]"></i><b id="coverage-maintenance" class="text-[var(--ink)]">—</b> mantenimiento</span><span class="inline-flex items-center gap-[.35rem] min-w-0"><i class="h-[.45rem] w-[.45rem] rounded-full bg-[var(--subtle)]"></i><b id="coverage-unassigned" class="text-[var(--ink)]">—</b> sin asignación</span></div>
      </section>

        <aside class="min-w-0 overflow-hidden rounded-[1.25rem] border border-[rgba(72,228,224,.12)] bg-[rgba(11,18,22,.96)] p-5 pt-[1.35rem] pb-[1.2rem] shadow-[0_16px_34px_rgba(0,0,0,.12)] max-md:mt-[.85rem] max-md:px-4 max-[430px]:px-[.9rem]" aria-label="Lecturas rápidas">
        <div class="flex items-center gap-[.55rem] text-[.6rem] font-extrabold uppercase tracking-[.14em] text-[var(--subtle)] max-md:flex-wrap max-md:gap-y-[.35rem]"><span class="font-display text-[var(--amber)]">02</span><span>Lecturas rápidas</span></div>
        <div id="kpis" class="mt-9 grid grid-cols-2 gap-[.65rem] max-[379px]:grid-cols-1"></div>
      </aside>

        <section class="min-w-0 overflow-hidden rounded-[1.25rem] border border-[rgba(234,239,226,.1)] bg-[rgba(11,18,22,.96)] px-[clamp(1.1rem,3vw,2.25rem)] pb-[1.6rem] pt-[1.35rem] shadow-[0_16px_34px_rgba(0,0,0,.12)] max-md:mt-[.85rem] max-md:px-4" aria-labelledby="assignments-title">
        <div class="flex items-center gap-[.55rem] text-[.6rem] font-extrabold uppercase tracking-[.14em] text-[var(--subtle)] max-md:flex-wrap max-md:gap-y-[.35rem]"><span class="font-display text-[var(--amber)]">03</span><span>Despacho</span><i class="h-px w-[2.3rem] bg-[rgba(234,239,226,.15)] max-md:flex-1 max-md:min-w-4"></i><span id="assignment-count">Asignaciones activas</span></div>
        <div class="mt-[1.35rem] flex items-start justify-between gap-4"><div class="min-w-0"><h2 id="assignments-title" class="m-0 font-display text-[1.6rem] font-medium leading-[.94] tracking-[-.06em] text-[var(--ink)]">Operación en curso</h2><p class="mb-0 mt-[.6rem] text-[.74rem] leading-[1.45] text-[var(--muted)]">Recursos que están moviendo la red ahora.</p></div><span class="font-[Outfit] text-[.7rem] text-[var(--subtle)] whitespace-nowrap">A / 01</span></div>
        <div id="active-trips" class="mt-[1.4rem] grid gap-[.55rem]"></div>
      </section>

        <aside class="min-w-0 overflow-hidden rounded-[1.25rem] border border-[rgba(245,173,75,.16)] bg-[rgba(11,18,22,.96)] p-[1.35rem] pb-[1.6rem] shadow-[0_16px_34px_rgba(0,0,0,.12)] max-md:mt-[.85rem] max-md:px-4" aria-labelledby="watch-title">
        <div class="flex items-center gap-[.55rem] text-[.6rem] font-extrabold uppercase tracking-[.14em] text-[var(--subtle)] max-md:flex-wrap max-md:gap-y-[.35rem]"><span class="font-display text-[var(--amber)]">04</span><span>Atención</span></div>
        <div class="mt-[1.35rem] flex items-start justify-between gap-4"><div class="min-w-0"><h2 id="watch-title" class="m-0 font-display text-[1.6rem] font-medium leading-[.94] tracking-[-.06em] text-[var(--ink)]">Fuera de servicio</h2><p class="mb-0 mt-[.6rem] text-[.74rem] leading-[1.45] text-[var(--muted)]">Buses que requieren seguimiento.</p></div></div>
        <div id="maintenance-buses" class="mt-[1.4rem] grid gap-[.55rem]"></div>
      </aside>

        <section class="col-span-full min-w-0 overflow-hidden rounded-[1.25rem] border border-[rgba(245,173,75,.16)] bg-[rgba(11,18,22,.96)] px-[clamp(1.1rem,3vw,2.25rem)] pb-[1.6rem] pt-[1.35rem] shadow-[0_16px_34px_rgba(0,0,0,.12)] max-md:mt-[.85rem] max-md:px-4" aria-labelledby="spend-title">
        <div class="flex items-center gap-[.55rem] text-[.6rem] font-extrabold uppercase tracking-[.14em] text-[var(--subtle)] max-md:flex-wrap max-md:gap-y-[.35rem]"><span class="font-display text-[var(--amber)]">05</span><span>Registro financiero</span></div>
         <div class="mt-[1.35rem] flex items-end justify-between gap-4 max-md:flex-col max-md:items-start max-md:gap-3"><div><h2 id="spend-title" class="m-0 font-display text-[1.6rem] font-medium leading-[.94] tracking-[-.06em] text-[var(--ink)] max-md:text-[1.45rem]">Mantenimiento por bus</h2><p class="mb-0 mt-[.6rem] text-[.74rem] leading-[1.45] text-[var(--muted)]">Inversión registrada en el periodo consultado.</p></div><strong id="period-cost" class="font-display text-[1.8rem] font-medium tracking-[-.05em] text-[var(--amber)] max-md:max-w-full max-md:break-words max-[430px]:text-[1.5rem]">$0</strong></div>
        <div id="spend-empty" class="mt-5 grid grid-cols-[auto_1fr] items-center gap-x-[.8rem] gap-y-[.1rem] rounded-[.8rem] border border-dashed border-[rgba(245,173,75,.3)] bg-[rgba(245,173,75,.035)] p-4" hidden><span class="row-span-2 font-display text-[2rem] text-[var(--amber)]" aria-hidden="true">$</span><strong class="text-[.8rem] text-[var(--ink)]">Sin inversión registrada</strong><p class="m-0 text-[.68rem] text-[var(--muted)]">El periodo no contiene costos de mantenimiento.</p></div>
        <div class="mt-5 overflow-hidden rounded-[.8rem] border border-white/10" id="spend-table-wrap"><table class="w-full border-collapse text-[.82rem]"><thead class="max-md:sr-only"><tr class="[&_th]:px-2 [&_th]:py-[.7rem] [&_th]:text-left [&_th]:text-[.63rem] [&_th]:font-bold [&_th]:uppercase [&_th]:tracking-[.14em] [&_th]:text-[var(--subtle)] [&_th:first-child]:pl-[.8rem] [&_th:last-child]:pr-[.8rem] [&_th:last-child]:text-right"><th>Unidad</th><th>Registros</th><th>Costo</th></tr></thead><tbody id="maintenance-rows" class="max-md:block"></tbody></table></div>
      </section>
    </main>
  </div>
</AdminShell>

<script>
  import { api } from '../../lib/api';
  type Overview = { period: { from: string; to: string; defaulted: boolean }; kpis: { totalBuses: number; availableBuses: number; operationalBuses: number; maintenanceBuses: number; activeDrivers: number; activeTrips: number; maintenanceCost: number }; maintenanceByBus: Array<{ busId: number; placa: string; total: number; records: number }>; busesInMaintenance: Array<{ id: number; placa: string; marca: string; modelo: string }>; activeTrips: Array<{ code: string; origin: string; status: string; initialStartAt: string; assignments: Array<{ bus: { placa: string }; driver: { nombres: string } }> }>; unassignedBuses: Array<{ id: number; placa: string; status: string; defaultDriver: { nombres: string } | null }> };
  type Bus = { id: number; placa: string };
  const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector)!;
  const currency = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 });
  const date = new Intl.DateTimeFormat('es-CO', { dateStyle: 'medium', timeStyle: 'short' });
  const statusLabel: Record<string, string> = { PLANNED: 'Planeado', ASSIGNED: 'Asignado', IN_TRANSIT: 'En ruta', STOPPED: 'Detenido', PAUSED_LUNCH: 'Pausa', INCIDENT: 'Incidente', AVAILABLE: 'Disponible', MAINTENANCE: 'Mantenimiento' };
  const escapeHtml = (value: string) => value.replace(/[&<>'"]/g, (char) => ({ '&': '&#38;', '<': '&#60;', '>': '&#62;', "'": '&#39;', '"': '&#34;' }[char] ?? char));
  const empty = (message: string) => `<div class="py-[1.35rem] text-[.73rem] text-[var(--subtle)]">${message}</div>`;
  function render(data: Overview) {
    const k = data.kpis;
    const covered = k.availableBuses + k.operationalBuses;
    const coverage = k.totalBuses ? Math.round(covered / k.totalBuses * 100) : 0;
    $('#coverage-percent').textContent = `${coverage}%`;
    $('#coverage-meter').style.width = `${coverage}%`;
    $('#coverage-summary').textContent = k.totalBuses ? `${covered} de ${k.totalBuses} buses sostienen la operación entre disponibilidad y ruta.` : 'Aún no hay buses registrados para calcular cobertura.';
    $('#coverage-covered').textContent = String(covered); $('#coverage-maintenance').textContent = String(k.maintenanceBuses); $('#coverage-unassigned').textContent = String(data.unassignedBuses.length);
    const signals = [{ label: 'Inventario total', value: k.totalBuses, note: 'Buses registrados', mark: 'FI', kind: '' }, { label: 'Choferes activos', value: k.activeDrivers, note: 'Personal disponible', mark: 'CH', kind: '' }, { label: 'Viajes activos', value: k.activeTrips, note: k.activeTrips ? 'Asignaciones abiertas' : 'Sin asignaciones', mark: 'VI', kind: 'is-cyan' }, { label: 'Mantenimiento', value: k.maintenanceBuses, note: k.maintenanceBuses ? 'Fuera de servicio' : 'Sin unidades fuera', mark: 'MT', kind: 'is-amber' }];
     $('#kpis').innerHTML = signals.map((signal) => `<div class="relative grid min-w-0 grid-cols-[auto_1fr] grid-rows-[auto_1fr_auto] gap-x-[.65rem] gap-y-[.45rem] rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(11,18,22,.62)] p-[.85rem_.75rem_.8rem] max-[379px]:min-h-[7.4rem]"><span class="grid h-6 w-6 place-items-center rounded-[.55rem] border border-[rgba(72,228,224,.35)] bg-[rgba(72,228,224,.09)] text-[.58rem] font-bold text-[var(--cyan)]" aria-hidden="true">${signal.mark}</span><small class="col-[2] self-center text-[.56rem] font-extrabold uppercase leading-tight tracking-[.08em] text-[var(--subtle)]">${signal.label}</small><span class="col-span-full inline-grid min-h-9 min-w-11 place-items-center justify-self-start self-end rounded-[.65rem] bg-[var(--amber)] px-2 py-1 text-[clamp(1.65rem,3vw,2.35rem)] font-semibold leading-[.9] tracking-[-.07em] text-[#101813]">${signal.value}</span><p class="col-span-full m-0 min-w-0 self-end break-words text-[.62rem] leading-tight text-[var(--muted)] ">${signal.value === 0 ? '<span class="text-[var(--subtle)]">— </span>' : ''}${signal.note}</p></div>`).join('');
    $('#assignment-count').textContent = `${k.activeTrips} asignación${k.activeTrips === 1 ? '' : 'es'} activa${k.activeTrips === 1 ? '' : 's'}`;
    $('#maintenance-rows').innerHTML = data.maintenanceByBus.length ? data.maintenanceByBus.map((row) => `<tr class="border-t border-white/[.055] transition-colors hover:bg-[rgba(72,228,224,.045)] max-md:flex max-md:flex-wrap max-md:items-center max-md:justify-between max-md:gap-x-3 max-md:gap-y-1 max-md:px-3 max-md:py-3"><td class="px-2 py-[.7rem] pl-[.8rem] align-middle max-md:block max-md:min-w-0 max-md:flex-1 max-md:p-0"><strong class="block font-semibold text-[var(--ink)]">${escapeHtml(row.placa)}</strong><small class="block text-[.65rem] text-[var(--muted)]">Bus #${row.busId}</small></td><td class="px-2 py-[.7rem] align-middle text-[#b4c0bd] max-md:p-0 max-md:text-[.72rem] max-md:text-[var(--muted)]"><span class="md:hidden">Registros: </span>${row.records}</td><td class="px-2 py-[.7rem] pr-[.8rem] text-right align-middle whitespace-nowrap max-md:p-0"><span class="font-bold text-[var(--amber)]">${currency.format(row.total)}</span></td></tr>`).join('') : `<tr><td class="px-6 py-[2.8rem] text-center text-[var(--subtle)]" colspan="3">No hay mantenimientos en este periodo.</td></tr>`;
     $('#maintenance-buses').innerHTML = data.busesInMaintenance.length ? data.busesInMaintenance.map((bus) => `<div class="flex min-w-0 items-start justify-between gap-3 rounded-[.8rem] border border-[rgba(245,173,75,.12)] bg-[rgba(5,11,14,.24)] p-[.85rem_.8rem] max-md:flex-wrap"><span class="min-w-0"><strong class="block truncate text-[var(--ink)]">${escapeHtml(bus.placa)}</strong><small class="mt-1 block truncate text-[.66rem] text-[var(--muted)]">${escapeHtml(bus.marca)} · ${escapeHtml(bus.modelo)}</small></span><span class="shrink-0 text-[.61rem] font-extrabold text-[var(--amber)] max-md:ml-auto">Revisión</span></div>`).join('') : empty('No hay buses fuera de servicio.');
     $('#active-trips').innerHTML = data.activeTrips.length ? data.activeTrips.map((trip) => { const assignment = trip.assignments[0]; return `<div class="grid min-w-0 grid-cols-[2.2rem_minmax(8rem,1fr)_minmax(8rem,1fr)_auto] items-center gap-3 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.85rem] max-md:grid-cols-[2rem_minmax(0,1fr)_auto] max-md:gap-[.65rem] max-[379px]:grid-cols-[1.8rem_minmax(0,1fr)]"><span class="grid h-8 w-8 place-items-center rounded-[.55rem] border-l-2 border-[var(--cyan)] bg-[rgba(72,228,224,.06)] text-[var(--cyan)]" aria-hidden="true">↝</span><span class="min-w-0"><span class="mb-1 block truncate text-[.57rem] font-extrabold uppercase tracking-[.1em] text-[var(--subtle)]">Viaje · ${escapeHtml(trip.code)}</span><strong class="block truncate text-[.78rem] text-[var(--ink)]">${escapeHtml(trip.origin)}</strong><small class="mt-1 block truncate text-[.66rem] text-[var(--muted)]">${date.format(new Date(trip.initialStartAt))}</small></span><span class="min-w-0"><span class="mb-1 block truncate text-[.57rem] font-extrabold uppercase tracking-[.1em] text-[var(--subtle)]">Recursos</span><strong class="block truncate text-[.78rem] text-[var(--ink)]">${assignment ? escapeHtml(assignment.bus.placa) : 'Bus pendiente'}</strong><small class="mt-1 block truncate text-[.66rem] text-[var(--muted)]">${assignment ? escapeHtml(assignment.driver.nombres) : 'Chofer pendiente'}</small></span><span class="shrink-0 text-[.61rem] font-extrabold text-[var(--cyan)]">${statusLabel[trip.status] ?? escapeHtml(trip.status)}</span></div>`; }).join('') : empty('No hay asignaciones activas para mostrar.');
    const totalCost = k.maintenanceCost;
    $('#period-cost').textContent = currency.format(totalCost);
    $('#spend-empty').hidden = totalCost !== 0 || data.maintenanceByBus.length > 0;
    $('#spend-table-wrap').hidden = totalCost === 0 && data.maintenanceByBus.length === 0;
    $('#period-note').textContent = `Periodo: ${date.format(new Date(data.period.from))} — ${date.format(new Date(data.period.to))}`;
  }
  async function loadBuses() { try { const result = await api('/buses/catalog'); const buses: Bus[] = result.data ?? result; $('#bus').innerHTML += buses.map((bus) => `<option value="${bus.id}">${escapeHtml(bus.placa)}</option>`).join(''); } catch { /* El filtro sigue disponible aunque el catálogo falle. */ } }
  async function load() { const state = $('#dashboard-state'); state.hidden = false; state.textContent = 'Actualizando resumen…'; state.classList.remove('error'); const params = new URLSearchParams(); for (const id of ['from', 'to', 'bus', 'status']) { const value = ($(`#${id}`) as HTMLInputElement | HTMLSelectElement).value; if (value) params.set(id === 'bus' ? 'busId' : id, value); } try { const data: Overview = await api(`/dashboard/overview?${params}`); render(data); $('#dashboard-content').hidden = false; state.hidden = true; } catch (error) { state.textContent = error instanceof Error ? error.message : 'No se pudo cargar el dashboard.'; state.classList.add('error'); } }
  function init() { const apply = $('#apply'); if (apply.dataset.bound === 'true') return; apply.dataset.bound = 'true'; apply.addEventListener('click', load); loadBuses(); load(); }
  document.addEventListener('astro:page-load', init); init();
</script>
