---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Consola · flotaBus" active="dashboard">
  <div class="drivers-page">
     <section class="page-header drivers-hero fade-in"><div><div class="eyebrow">PANEL ADMINISTRATIVO · 01</div><h1>Tripulación <em>activa.</em></h1><p>Gestiona los perfiles que mantienen la ruta en movimiento.</p></div></section>
     <section class="glass fleet-card drivers-table-card fade-in" style="animation-delay:.08s"><div class="toolbar"><label class="search-field"><span aria-hidden="true">⌕</span><input id="search" class="input" placeholder="Buscar por nombre o usuario…" aria-label="Buscar choferes" /></label><button id="new" class="btn btn-primary">+ Añadir chofer</button></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Chofer</th><th>Teléfono</th><th>Estado</th><th class="table-actions">Acciones</th></tr></thead><tbody id="rows"><tr><td class="table-state" colspan="4">Cargando tripulación…</td></tr></tbody></table></div></section>
  </div>
    <div id="modal" class="modal-backdrop" hidden aria-hidden="true"><div class="glass modal-card admin-modal-card" role="dialog" aria-modal="true" aria-labelledby="modal-title"><div class="modal-heading"><div><div class="eyebrow">PERFIL DE CHOFER</div><h2 id="modal-title" class="font-display">Nuevo chofer</h2></div><button id="close" class="icon-button" type="button" aria-label="Cerrar">×</button></div><form id="driver-form" class="space-y-4"><input type="hidden" id="driver-id"/><label class="form-label">Usuario<input id="driver-username" class="input mt-2" required minlength="3"/></label><label class="form-label">Nombres<input id="driver-name" class="input mt-2" required minlength="2"/></label><label class="form-label">Teléfono<input id="driver-phone" class="input mt-2"/></label><label class="form-label">Contraseña<input id="driver-password" type="password" class="input mt-2" minlength="8"/><small id="password-help" class="muted">Mínimo 8 caracteres.</small></label><div class="form-actions flex justify-end gap-3 pt-3"><button id="cancel" class="btn btn-secondary" type="button">Cancelar</button><button id="save" class="btn btn-primary" type="submit">Guardar cambios</button></div></form></div></div>
</AdminShell>
<script>
  import { api } from '../../lib/api';
  import { feedback, Swal } from '../../lib/feedback';
  type Driver = { id: number; username: string; fullName?: string; nombres?: string; phone?: string; telefono?: string; isActive: boolean };
  function initDrivers() {
    if (!document.querySelector('#rows') || document.querySelector('#rows')?.getAttribute('data-ready') === 'true') return;
    document.querySelector('#rows')?.setAttribute('data-ready', 'true');
    const $ = <T extends Element>(selector: string) => document.querySelector<T>(selector);
    const rows = $('#rows')!, modal = $('#modal')!, form = $('#driver-form') as HTMLFormElement, save = $('#save') as HTMLButtonElement;
    let drivers: Driver[] = [];
    const showError = (cause: unknown, title = 'No se pudo completar la acción') => feedback.error(cause instanceof Error ? cause.message : 'Error inesperado.', title);
     function render() { const query = ($('#search') as HTMLInputElement).value.toLowerCase(); const filtered = drivers.filter((d) => `${d.username} ${d.fullName ?? d.nombres ?? ''}`.toLowerCase().includes(query)); rows.innerHTML = filtered.length ? filtered.map((d) => { const name = d.fullName ?? d.nombres ?? '—'; const initials = name.split(' ').filter(Boolean).slice(0, 2).map((part) => part[0]).join('').toUpperCase(); return `<tr><td><div class="person-cell"><span class="avatar">${initials}</span><span><strong>${name}</strong><small>@${d.username}</small></span></div></td><td>${d.phone ?? d.telefono ?? 'Sin teléfono'}</td><td><span class="status-pill ${d.isActive ? 'is-active' : 'is-inactive'}"><i></i>${d.isActive ? 'Activo' : 'Inactivo'}</span></td><td class="table-actions"><button class="link-button" data-edit="${d.id}">Editar</button>${d.isActive ? `<button class="danger-link" data-delete="${d.id}">Desactivar</button>` : ''}</td></tr>`; }).join('') : '<tr><td class="table-state" colspan="4">No hay perfiles que coincidan.</td></tr>'; }
    async function load() { rows.innerHTML = '<tr><td class="table-state" colspan="4">Actualizando tripulación…</td></tr>'; try { const result = await api('/drivers'); drivers = result.data ?? result; render(); } catch (cause) { rows.innerHTML = '<tr><td class="table-state error" colspan="4">No pudimos cargar los choferes. Intenta actualizar.</td></tr>'; await showError(cause, 'Error al cargar la tripulación'); } }
      let lastFocused: HTMLElement | null = null; let closeTimer: number | undefined; let closeFinish: ((event?: TransitionEvent) => void) | null = null; let transitionVersion = 0;
      function open(driver?: Driver) { if(closeTimer !== undefined){ window.clearTimeout(closeTimer); closeTimer=undefined; } if(closeFinish){ modal.removeEventListener('transitionend',closeFinish); closeFinish=null; } const openVersion=++transitionVersion; lastFocused=document.activeElement as HTMLElement; (modal as HTMLElement).classList.remove('is-closing'); (modal as HTMLElement).hidden=false; modal.setAttribute('aria-hidden','false'); requestAnimationFrame(()=>{ if(!(modal as HTMLElement).hidden && openVersion===transitionVersion) modal.classList.add('is-open'); }); $('#modal-title')!.textContent = driver ? 'Editar chofer' : 'Nuevo chofer'; ($('#driver-id') as HTMLInputElement).value = driver ? String(driver.id) : ''; ($('#driver-username') as HTMLInputElement).value = driver?.username ?? ''; ($('#driver-username') as HTMLInputElement).disabled = !!driver; ($('#driver-name') as HTMLInputElement).value = driver?.fullName ?? driver?.nombres ?? ''; ($('#driver-phone') as HTMLInputElement).value = driver?.phone ?? driver?.telefono ?? ''; ($('#driver-password') as HTMLInputElement).value = ''; $('#password-help')!.textContent = driver ? 'Déjalo vacío para conservar la actual.' : 'Mínimo 8 caracteres.'; setTimeout(()=>($('#driver-username') as HTMLInputElement).focus(),40); }
      function close() { if((modal as HTMLElement).hidden || modal.classList.contains('is-closing')) return; const closeVersion=++transitionVersion; modal.classList.remove('is-open'); modal.classList.add('is-closing'); const finish=(event?:TransitionEvent)=>{ if(closeVersion!==transitionVersion || (event && (event.target!==modal || event.propertyName!=='opacity'))) return; modal.removeEventListener('transitionend',finish); closeFinish=null; if(closeTimer !== undefined){ window.clearTimeout(closeTimer); closeTimer=undefined; } modal.classList.remove('is-open','is-closing'); (modal as HTMLElement).hidden=true; modal.setAttribute('aria-hidden','true'); lastFocused?.focus(); }; closeFinish=finish; modal.addEventListener('transitionend',finish); closeTimer=window.setTimeout(finish,260); }
     $('#new')?.addEventListener('click', () => open()); $('#close')?.addEventListener('click', close); $('#cancel')?.addEventListener('click', close); $('#search')?.addEventListener('input', render); modal.addEventListener('click',(event)=>{if(event.target===modal)close();}); document.addEventListener('keydown',(event)=>{if(event.key==='Escape'&&!((modal as HTMLElement).hidden))close();});
    rows.addEventListener('click', async (event) => { const target = event.target as HTMLElement; const id = Number(target.dataset.edit ?? target.dataset.delete); const driver = drivers.find((item) => item.id === id); if (!driver) return; if (target.dataset.edit) return open(driver); const confirmation = await feedback.confirm(`Se desactivará a @${driver.username}. Podrás conservar su trazabilidad, pero ya no podrá iniciar sesión.`, '¿Desactivar chofer?'); if (!confirmation.isConfirmed) return; try { feedback.loading('Desactivando perfil…'); await api(`/drivers/${id}`, { method: 'DELETE' }); Swal.close(); await feedback.success('El perfil fue desactivado.'); await load(); } catch (cause) { Swal.close(); await showError(cause, 'No se pudo desactivar'); } });
    form.addEventListener('submit', async (event) => { event.preventDefault(); save.disabled = true; save.textContent = 'Guardando…'; const id = ($('#driver-id') as HTMLInputElement).value; const password = ($('#driver-password') as HTMLInputElement).value; const payload = { username: ($('#driver-username') as HTMLInputElement).value.trim(), nombres: ($('#driver-name') as HTMLInputElement).value.trim(), telefono: ($('#driver-phone') as HTMLInputElement).value.trim(), ...(password ? { password } : {}) }; try { feedback.loading(id ? 'Guardando cambios…' : 'Creando perfil…'); await api(id ? `/drivers/${id}` : '/drivers', { method: id ? 'PATCH' : 'POST', body: JSON.stringify(id ? { nombres: payload.nombres, telefono: payload.telefono, ...(password ? { password } : {}) } : payload) }); Swal.close(); close(); await feedback.success(id ? 'Los cambios fueron guardados.' : 'El nuevo chofer ya está en la tripulación.', id ? 'Perfil actualizado' : 'Chofer creado'); await load(); } catch (cause) { Swal.close(); await showError(cause, id ? 'No se pudo actualizar' : 'No se pudo crear'); } finally { save.disabled = false; save.textContent = 'Guardar cambios'; } });
    load();
  }
  document.addEventListener('astro:page-load', initDrivers); initDrivers();
</script>
