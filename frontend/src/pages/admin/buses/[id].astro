---
import AdminShell from '../../../components/AdminShell.astro';

export function getStaticPaths() { return [{ params: { id: 'detail' } }]; }
---

<AdminShell title="Ficha del bus · flotaBus" active="buses">
  <div class="bus-detail-page mx-auto max-w-[1240px]">
    <section class="fade-in flex flex-col gap-8 md:flex-row md:items-end md:justify-between mb-8">
      <div>
        <div class="eyebrow">FICHA OPERATIVA · UNIDAD DE FLOTA</div>
        <h1 id="bus-name">Bus <em>cargando.</em></h1>
        <p id="bus-subtitle">Consultando historial del vehículo…</p>
      </div>
      <a class="inline-flex flex-[0_0_auto] items-center gap-[.45rem] text-[.8rem] font-bold text-[var(--cyan)] no-underline transition-all hover:-translate-x-[3px] hover:text-[var(--amber)]" href="/admin/buses" data-spa-link><span aria-hidden="true">←</span> Volver a buses</a>
    </section>

    <div id="bus-error" class="state error-state" role="alert" hidden></div>

    <div id="bus-content" class="bus-detail-grid grid min-w-0 gap-[1.1rem] lg:grid-cols-[minmax(0,360px)_minmax(0,1fr)]" hidden>
      <aside class="bus-detail-aside">
        <article class="glass fleet-card min-w-0 rounded-[1.25rem] p-[1.25rem]">
          <div class="bus-photo-wrap relative grid h-[180px] place-items-center overflow-hidden rounded-[1rem] border border-[rgba(234,239,226,.08)] bg-[radial-gradient(circle_at_50%_42%,rgba(72,228,224,.13),transparent_45%),linear-gradient(135deg,#1b3035,#0b1216_72%)]">
            <img id="bus-photo" class="absolute inset-0 h-full w-full object-cover" alt="" hidden />
            <div id="bus-photo-fallback" class="model-fallback-mark grid h-[3.4rem] w-[3.4rem] place-items-center rounded-[.9rem] border border-[rgba(72,228,224,.3)] font-display text-base font-semibold text-[var(--cyan)]" aria-hidden="true">BUS</div>
          </div>

          <div class="mt-5 flex min-w-0 items-start justify-between gap-3">
            <div class="grid min-w-0 gap-1">
              <span class="text-[.6rem] font-bold uppercase tracking-[.12em] text-[var(--subtle)]">Placa</span>
              <strong id="bus-placa" class="truncate font-display text-[1.6rem] tracking-[-.04em] text-[var(--ink)]">—</strong>
            </div>
            <span id="bus-type-pill" class="flex-none rounded-full border border-[rgba(245,173,75,.18)] bg-[rgba(245,173,75,.1)] px-2 py-[.28rem] text-[.6rem] font-extrabold tracking-[.03em] text-[var(--amber)]">—</span>
          </div>

          <dl class="mt-4 grid grid-cols-1 gap-3">
            <div class="grid gap-1 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.85rem]">
              <dt class="text-[.6rem] uppercase tracking-[.12em] text-[var(--subtle)]">Marca y modelo</dt>
              <dd id="bus-brand" class="m-0 text-[.84rem] text-[var(--ink)]">—</dd>
            </div>
            <div class="grid gap-1 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.85rem]">
              <dt class="text-[.6rem] uppercase tracking-[.12em] text-[var(--subtle)]">Kilometraje actual</dt>
              <dd id="bus-km" class="m-0 text-[.84rem] font-extrabold text-[var(--cyan)]">—</dd>
            </div>
            <div class="grid gap-1 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.85rem]">
              <dt class="text-[.6rem] uppercase tracking-[.12em] text-[var(--subtle)]">Estado</dt>
              <dd id="bus-status" class="m-0">—</dd>
            </div>
          </dl>

          <div class="mt-5">
            <div class="eyebrow">CONDUCTORES POR DEFECTO</div>
            <h3 class="m-0 mt-1 font-display text-base text-[var(--ink)]">Asignación habitual</h3>
          </div>
          <ul id="bus-default-drivers" class="m-0 mt-3 grid list-none gap-[.4rem] p-0"></ul>

          <div class="mt-5">
            <div class="eyebrow">EN OPERACIÓN</div>
            <h3 class="m-0 mt-1 font-display text-base text-[var(--ink)]">Viaje actual</h3>
          </div>
          <div id="bus-current" class="mt-3"></div>
        </article>
      </aside>

      <section class="bus-detail-main grid min-w-0 gap-[1.1rem]">
        <article class="glass fleet-card min-w-0 rounded-[1.25rem] p-[1.25rem]">
          <div class="eyebrow">INDICADORES</div>
          <h2 class="m-0 mt-1 font-display text-[1.3rem] text-[var(--ink)]">Resumen de actividad</h2>
          <div id="bus-stats" class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5"></div>
        </article>

        <article class="glass fleet-card min-w-0 rounded-[1.25rem] p-[1.25rem]">
          <div class="flex items-start justify-between gap-3">
            <div>
              <div class="eyebrow">MANTENIMIENTOS</div>
              <h2 class="m-0 mt-1 font-display text-[1.3rem] text-[var(--ink)]">Gasto por categoría</h2>
            </div>
            <strong id="bus-category-total" class="whitespace-nowrap font-display text-[1.15rem] tracking-[-.03em] text-[var(--amber)]">—</strong>
          </div>
          <p class="m-0 mt-[.4rem] text-[.72rem] text-[var(--muted)]">Cuánto aporta cada tipo de gasto al total de la unidad.</p>
          <div id="bus-category-empty" class="mt-4 rounded-[.8rem] border border-dashed border-[rgba(72,228,224,.25)] bg-[rgba(72,228,224,.035)] p-[.85rem] text-[.72rem] text-[var(--muted)]" hidden>Sin gastos registrados en esta unidad.</div>
          <ul id="bus-category-chart" class="mt-4 grid gap-[.85rem]"></ul>
        </article>

        <article class="glass fleet-card min-w-0 rounded-[1.25rem] p-[1.25rem]">
          <div class="flex items-start justify-between gap-3">
            <div>
              <div class="eyebrow">HISTORIAL DE VIAJES</div>
              <h2 class="m-0 mt-1 font-display text-[1.3rem] text-[var(--ink)]">Asignaciones del bus</h2>
            </div>
            <span id="bus-trips-count" class="text-[.8rem] text-[var(--muted)]">—</span>
          </div>
          <div id="bus-trips" class="mt-4 grid gap-[.5rem]"></div>
        </article>

        <article class="glass fleet-card min-w-0 rounded-[1.25rem] p-[1.25rem]">
          <div class="flex items-start justify-between gap-3">
            <div>
              <div class="eyebrow">MANTENIMIENTOS</div>
              <h2 class="m-0 mt-1 font-display text-[1.3rem] text-[var(--ink)]">Historial técnico</h2>
            </div>
            <span id="bus-maint-count" class="text-[.8rem] text-[var(--muted)]">—</span>
          </div>
          <div id="bus-maintenance" class="mt-4 grid gap-[.5rem]"></div>
        </article>
      </section>
    </div>
  </div>
</AdminShell>

<script>
  import { api, ApiError } from '../../../lib/api';
  import { busStatusClass, busStatusLabel } from '../../../lib/trip-labels';
  import { openPhotoLightbox } from '../../../lib/photo-lightbox';

  const areaLabel = (area) => {
    const map = {
      CAJA: 'Caja',
      TRANSMISION: 'Transmisión',
      RETARDADOR: 'Retardador',
      LLANTAS: 'Llantas',
      AIRE_ACONDICIONADO: 'Aire acondicionado',
      MOTOR: 'Motor'
    };
    return (area && map[area]) || 'Sin área específica';
  };
  const categoryLabel = (category) => ({
    MANTENIMIENTO: 'Mantenimiento',
    COMBUSTIBLE: 'Combustible',
    PINCHAZO: 'Pinchazo',
    OTRO: 'Otro gasto',
  }[category] ?? 'Gasto operativo');

  const formatDate = (value) => value ? new Date(value).toLocaleString('es-CO', { dateStyle: 'medium', timeStyle: 'short' }) : '—';
  const formatMoney = (value) => Number(value || 0).toLocaleString('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 });
  const escape = (value) => String(value ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] ?? c));

  const init = () => {
    const content = document.querySelector<HTMLElement>('#bus-content');
    if (!content) return;
    const requestedId = new URLSearchParams(window.location.search).get('id');
    const busId = requestedId || '';
    if (content.dataset.ready === busId) return;
    content.dataset.ready = busId;

    const error = document.querySelector<HTMLElement>('#bus-error');
    if (!/^\d+$/.test(busId)) { error.hidden = false; error.textContent = 'No se indicó un bus válido.'; return; }

    const $ = (id: string) => document.getElementById(id) as HTMLElement;

    const render = (bus) => {
      $('bus-name').innerHTML = `${escape(bus.placa)} <em>${bus.isActive ? 'activo' : 'inactivo'}.</em>`;
      $('bus-subtitle').textContent = `${bus.marca} · ${bus.modelo} · ${(bus.kilometraje || 0).toLocaleString('es-ES')} km`;

      if (bus.photoUrl) { const img = $('bus-photo') as HTMLImageElement; img.src = bus.photoUrl; img.alt = `Foto del bus ${bus.placa}`; img.hidden = false; $('bus-photo-fallback').hidden = true; }
      else { ($('bus-photo') as HTMLImageElement).hidden = true; $('bus-photo-fallback').hidden = false; $('bus-photo-fallback').textContent = bus.placa.slice(0, 4) || 'BUS'; }

      $('bus-placa').textContent = bus.placa;
      $('bus-type-pill').textContent = bus.busType === 'DOBLE_PISO' ? 'Doble piso' : 'Normal';
      $('bus-brand').textContent = `${bus.marca} · ${bus.modelo}`;
      $('bus-km').textContent = `${(bus.kilometraje || 0).toLocaleString('es-ES')} km`;

      const statusPill = document.createElement('span');
      const derivedStatus = !bus.isActive ? 'INACTIVE' : bus.currentAssignment?.trip.status ?? bus.manualStatus ?? 'AVAILABLE';
      statusPill.className = `status-pill ${busStatusClass(derivedStatus)}`;
      statusPill.innerHTML = `<i></i>${busStatusLabel(derivedStatus)}`;
      const statusEl = $('bus-status'); statusEl.textContent = ''; statusEl.append(statusPill);

      const driversList = $('bus-default-drivers');
      driversList.innerHTML = bus.defaultDrivers?.length
        ? bus.defaultDrivers.map(d => `<li class="grid grid-cols-[1.8rem_minmax(0,1fr)] items-center gap-2 rounded-[.7rem] border border-[rgba(72,228,224,.16)] bg-[rgba(72,228,224,.06)] px-[.7rem] py-[.45rem]"><span class="grid h-[1.6rem] w-[1.6rem] place-items-center rounded-[.45rem] bg-[rgba(72,228,224,.15)] text-[.7rem] font-extrabold text-[var(--cyan)]" aria-hidden="true">${escape((d.codigo || '@').slice(0, 2).toUpperCase())}</span><span class="min-w-0 truncate text-[.78rem] text-[var(--ink)]" title="${escape(d.nombres || d.username)}">${escape(d.nombres || `@${d.username}`)}<small class="ml-[.4rem] text-[.62rem] text-[var(--muted)]">@${escape(d.username)}</small></span></li>`).join('')
        : '<li class="text-[.72rem] text-[var(--muted)]">Sin conductores asignados por defecto.</li>';

      const current = $('bus-current');
      if (bus.currentAssignment) {
        const a = bus.currentAssignment;
        const lastLeg = a.trip.legs?.at(-1);
        current.innerHTML = `<div class="grid gap-2 rounded-[.8rem] border border-[rgba(245,173,75,.2)] bg-[rgba(245,173,75,.08)] p-[.85rem]"><a href="/admin/trips/detail?id=${encodeURIComponent(a.trip.id)}" data-spa-link class="inline-flex items-center gap-[.4rem] text-[.84rem] font-extrabold text-[var(--ink)] no-underline hover:text-[var(--amber)]">${escape(a.trip.code)}<span aria-hidden="true">↗</span></a><span class="status-pill ${busStatusClass(a.trip.status)}"><i></i>${busStatusLabel(a.trip.status)}</span><small class="text-[.7rem] text-[var(--muted)]">${escape(a.trip.origin)}${lastLeg ? ` → ${escape(lastLeg.destination)}` : ''}</small><small class="text-[.7rem] text-[var(--muted)]">Conductor: ${escape(a.driver.nombres || a.driver.username)}</small></div>`;
      } else {
        current.innerHTML = '<p class="m-0 text-[.72rem] text-[var(--muted)]">Este bus no tiene viajes en operación.</p>';
      }

      const stats = bus.stats || { tripsTotal: 0, tripsActive: 0, tripsCompleted: 0, maintenanceTotal: 0, maintenanceCostTotal: 0 };
      $('bus-stats').innerHTML = [
        { label: 'Viajes totales', value: stats.tripsTotal },
        { label: 'En operación', value: stats.tripsActive },
        { label: 'Completados', value: stats.tripsCompleted },
        { label: 'Mantenimientos', value: stats.maintenanceTotal },
        { label: 'Inversión MT.', value: formatMoney(stats.maintenanceCostTotal) },
      ].map(s => `<div class="grid gap-1 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.7rem_.85rem]"><span class="text-[.58rem] font-bold uppercase tracking-[.12em] text-[var(--subtle)]">${escape(s.label)}</span><strong class="font-display text-[1.2rem] tracking-[-.03em] text-[var(--ink)]">${escape(s.value)}</strong></div>`).join('');

      const history = Array.isArray(bus.maintenanceHistory) ? bus.maintenanceHistory : [];
      const categoryTotals = new Map();
      for (const m of history) {
        const bucket = categoryTotals.get(m.category) ?? { total: 0, records: 0 };
        bucket.total += Number(m.cost || 0);
        bucket.records += 1;
        categoryTotals.set(m.category, bucket);
      }
      const categoryRows = [...categoryTotals].map(([category, bucket]) => ({ category, ...bucket })).sort((a, b) => b.total - a.total);
      const maxCategory = categoryRows.reduce((peak, row) => Math.max(peak, row.total), 0);
      const categoryGrand = categoryRows.reduce((sum, row) => sum + row.total, 0);
      $('bus-category-total').textContent = formatMoney(categoryGrand);
      $('bus-category-empty').hidden = categoryRows.length > 0;
      $('bus-category-chart').innerHTML = categoryRows.map(row => {
        const width = maxCategory > 0 ? Math.max(Math.round(row.total / maxCategory * 100), 2) : 0;
        const share = categoryGrand > 0 ? Math.round(row.total / categoryGrand * 100) : 0;
        return `<li class="grid gap-[.35rem]"><div class="flex items-baseline justify-between gap-3"><strong class="truncate text-[.78rem] text-[var(--ink)]">${escape(categoryLabel(row.category))}</strong><span class="whitespace-nowrap text-[.72rem] font-bold text-[var(--amber)]">${escape(formatMoney(row.total))}</span></div><div class="h-[.55rem] overflow-hidden rounded-full bg-[rgba(234,239,226,.08)]"><i class="block h-full rounded-full bg-[var(--amber)] transition-[width] duration-700 ease-out" style="width:${width}%"></i></div><small class="text-[.64rem] text-[var(--muted)]">${row.records} registro${row.records === 1 ? '' : 's'} · ${share}% del total</small></li>`;
      }).join('');

      $('bus-trips-count').textContent = `${new Set(bus.tripHistory.map(t => t.trip.id)).size} rutas`;
      const groupedTrips = bus.tripHistory.reduce((groups, item) => {
        const existing = groups.get(item.trip.id);
        if (existing) existing.drivers.push(item.driver);
        else groups.set(item.trip.id, { trip: item.trip, assignedAt: item.assignedAt, drivers: [item.driver] });
        return groups;
      }, new Map());
      $('bus-trips').innerHTML = groupedTrips.size
        ? [...groupedTrips.values()].map(({ trip, assignedAt, drivers }) => `<a href="/admin/trips/detail?id=${encodeURIComponent(trip.id)}" data-spa-link class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-3 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.85rem] no-underline transition-colors duration-200 hover:border-[rgba(72,228,224,.2)] hover:bg-[rgba(72,228,224,.05)]"><span class="grid h-[1.9rem] w-[1.9rem] place-items-center rounded-[.55rem] bg-[rgba(72,228,224,.12)] font-display text-[.7rem] font-semibold text-[var(--cyan)]" aria-hidden="true">→</span><div class="grid min-w-0 gap-1"><strong class="truncate text-[.82rem] text-[var(--ink)]">${escape(trip.code)}</strong><small class="text-[.66rem] text-[var(--muted)]">${escape(formatDate(assignedAt))} · ${escape(tripRoute(trip))}</small><div class="mt-[.2rem] flex flex-wrap gap-[.3rem]">${drivers.map((d, index) => `<span class="max-w-full truncate rounded-[.45rem] border border-[rgba(72,228,224,.16)] bg-[rgba(72,228,224,.06)] px-[.4rem] py-[.2rem] text-[.66rem] text-[var(--ink)]" title="${escape(d.nombres || `@${d.username}`)}">Chofer ${index + 1} · ${escape(d.nombres || `@${d.username}`)}</span>`).join('')}</div></div><span class="status-pill ${busStatusClass(trip.status)}"><i></i>${busStatusLabel(trip.status)}</span></a>`).join('')
        : '<p class="m-0 py-[1.5rem] text-center text-[.72rem] text-[var(--subtle)]">Sin asignaciones registradas.</p>';

      $('bus-maint-count').textContent = `${bus.maintenanceHistory.length} registros`;
      $('bus-maintenance').innerHTML = bus.maintenanceHistory.length
        ? bus.maintenanceHistory.map(m => `<div class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-start gap-3 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.85rem]"><span class="h-[3rem] w-[3rem] overflow-hidden rounded-[.55rem] border border-[rgba(234,239,226,.1)]">${m.photoUrl ? `<img src="${escape(m.photoUrl)}" alt="Foto del registro" class="record-photo-thumb" loading="lazy" />` : `<span class="grid h-full w-full place-items-center rounded-[.55rem] bg-[rgba(245,173,75,.12)] font-display text-[.7rem] font-extrabold text-[var(--amber)]" aria-hidden="true">${escape(areaLabel(m.area).slice(0, 2).toUpperCase())}</span>`}</span><div class="grid min-w-0 gap-1"><strong class="text-[.82rem] text-[var(--ink)]">${escape(categoryLabel(m.category))}</strong><small class="text-[.66rem] text-[var(--muted)]">${escape(formatDate(m.recordedAt))} · ${escape(areaLabel(m.area))}</small><p class="m-0 text-[.72rem] text-[var(--muted)]">${escape(m.detail)}</p>${m.photoUrl ? `<button class="photo-view-btn mt-[.35rem] self-start" type="button" data-photo="${escape(m.photoUrl)}" aria-label="Ver foto del registro en grande">Ver foto</button>` : ''}</div><strong class="font-display text-[.85rem] text-[var(--amber)]">${escape(formatMoney(m.cost))}</strong></div>`).join('')
        : '<p class="m-0 py-[1.5rem] text-center text-[.72rem] text-[var(--subtle)]">Sin mantenimientos registrados.</p>';

      content.hidden = false;
    };

    const tripRoute = (trip) => {
      const lastLeg = trip.legs?.at(-1);
      return `${trip.origin} → ${lastLeg?.destination ?? '—'}`;
    };

    const load = async () => {
      // Esqueleto mientras llega la ficha.
      const skeleton = (width: string, height = '.7rem') => `<span class="skeleton skeleton-line" style="width:${width};height:${height}"></span>`;
      $('bus-name').innerHTML = `<span class="skeleton skeleton-line" style="height:1.6rem;width:55%"></span>`;
      $('bus-subtitle').textContent = 'Cargando información de la unidad…';
      $('bus-stats').innerHTML = Array.from({ length: 3 }, () => `<div class="grid gap-[.3rem]">${skeleton('3.5rem')}${skeleton('4.5rem')}</div>`).join('');
      $('bus-trips').innerHTML = Array.from({ length: 2 }, () => `<div class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-3 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.85rem]"><span class="skeleton h-[1.9rem] w-[1.9rem] rounded-[.55rem]"></span><div class="grid min-w-0 gap-[.45rem]">${skeleton('40%')}${skeleton('75%')}</div></div>`).join('');
      $('bus-maintenance').innerHTML = Array.from({ length: 2 }, () => `<div class="grid grid-cols-[auto_minmax(0,1fr)] items-start gap-3 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.85rem]"><span class="skeleton h-[3rem] w-[3rem] rounded-[.55rem]"></span><div class="grid min-w-0 gap-[.45rem]">${skeleton('45%')}${skeleton('85%')}${skeleton('60%')}</div></div>`).join('');
      $('bus-trips-count').textContent = '…';
      $('bus-maint-count').textContent = '…';
      content.hidden = false;

      try { render(await api(`/buses/${busId}/detail`)); }
      catch (cause) {
        const message = cause instanceof ApiError && cause.status === 404 ? 'No encontramos este bus. Verifica el identificador.' : 'No pudimos cargar la ficha del bus. Intenta actualizar.';
        error.hidden = false; error.textContent = message; content.hidden = true;
      }
    };

    const $maintenance = document.getElementById('bus-maintenance');
    $maintenance?.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-photo]');
      if (trigger) openPhotoLightbox(trigger.dataset.photo);
    });

    void load();
  };

  document.addEventListener('astro:page-load', init);
  init();
</script>