---
import AdminShell from '../../../components/AdminShell.astro';

// This route is generated statically, so query parameters are resolved in the browser.
---

<AdminShell title="Mantenimiento · Bus" active="buses">
   <div class="maintenance-page mx-auto max-w-[1120px]">
    <section class="maintenance-hero fade-in mb-[2.4rem] flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div>
        <div class="eyebrow">HOJA DE MANTENIMIENTO · PLACA <span data-bus-plate>—</span></div>
       <h1 class="max-md:max-w-[10ch]">Cuida cada <em>sistema.</em></h1>
        <p>Consulta y registra el historial técnico de esta unidad cuando esté disponible.</p>
      </div>
      <a class="inline-flex flex-[0_0_auto] items-center gap-[.45rem] text-[.8rem] font-bold text-[var(--cyan)] no-underline transition-all hover:-translate-x-[3px] hover:text-[var(--amber)]" href="/admin/buses" data-spa-link>
        <span aria-hidden="true">←</span> Volver a buses
      </a>
    </section>

     <section class="maintenance-panel glass fade-in p-[1.4rem] max-md:p-[.9rem]" style="animation-delay:.08s" aria-labelledby="systems-title">
       <div class="maintenance-panel-heading flex items-center justify-between gap-4 px-1 pb-5 pt-1 max-md:items-start max-md:flex-col max-md:pb-4">
        <div>
          <div class="eyebrow">SISTEMAS DE LA UNIDAD</div>
          <h2 id="systems-title">Historial por área</h2>
        </div>
         <span class="unit-badge" data-unit-plate>PLACA —</span>
       </div>
        <div class="maintenance-grid grid grid-cols-3 gap-3 max-md:grid-cols-2 max-[460px]:grid-cols-1" data-maintenance-areas>
          <a class="maintenance-card min-h-[8.8rem] p-[1.1rem] max-md:min-h-[8.2rem] max-md:p-[.9rem] max-[460px]:min-h-28" data-area="CAJA" data-spa-link aria-label="Abrir mantenimiento de Caja">
          <span class="system-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 8.5 12 5l8 3.5-8 3-8-3Z"/><path d="M4 8.5v7l8 3.5 8-3.5v-7M8 10v6m8-6v6"/></svg></span><span>Caja</span><span class="card-arrow" aria-hidden="true">↗</span>
        </a>
          <a class="maintenance-card min-h-[8.8rem] p-[1.1rem] max-md:min-h-[8.2rem] max-md:p-[.9rem] max-[460px]:min-h-28" data-area="TRANSMISION" data-spa-link aria-label="Abrir mantenimiento de Transmisión">
          <span class="system-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><circle cx="7" cy="12" r="3"/><circle cx="17" cy="7" r="3"/><circle cx="17" cy="17" r="3"/><path d="M10 12h4m0 0V7m0 5v5"/></svg></span><span>Transmisión</span><span class="card-arrow" aria-hidden="true">↗</span>
        </a>
          <a class="maintenance-card min-h-[8.8rem] p-[1.1rem] max-md:min-h-[8.2rem] max-md:p-[.9rem] max-[460px]:min-h-28" data-area="RETARDADOR" data-spa-link aria-label="Abrir mantenimiento de Retardador">
          <span class="system-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 3v4m0 10v4M3 12h4m10 0h4M5.6 5.6l2.8 2.8m7.2 7.2 2.8 2.8m0-12.8-2.8 2.8m-7.2 7.2-2.8 2.8"/><circle cx="12" cy="12" r="4"/></svg></span><span>Retardador</span><span class="card-arrow" aria-hidden="true">↗</span>
        </a>
          <a class="maintenance-card min-h-[8.8rem] p-[1.1rem] max-md:min-h-[8.2rem] max-md:p-[.9rem] max-[460px]:min-h-28" data-area="LLANTAS" data-spa-link aria-label="Abrir mantenimiento de Llantas">
          <span class="system-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M7 4h10l2 4v9a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V8l2-4Z"/><path d="M8 9h8m-7 4h1m4 0h1m-6 4h6"/></svg></span><span>Llantas</span><span class="card-arrow" aria-hidden="true">↗</span>
        </a>
          <a class="maintenance-card min-h-[8.8rem] p-[1.1rem] max-md:min-h-[8.2rem] max-md:p-[.9rem] max-[460px]:min-h-28" data-area="AIRE_ACONDICIONADO" data-spa-link aria-label="Abrir mantenimiento de Aire acondicionado">
          <span class="system-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 8h14M5 12h14M5 16h14"/><path d="M8 5v14m8-14v14"/><circle cx="8" cy="8" r="1"/><circle cx="16" cy="16" r="1"/></svg></span><span>Aire acondicionado</span><span class="card-arrow" aria-hidden="true">↗</span>
        </a>
          <a class="maintenance-card min-h-[8.8rem] p-[1.1rem] max-md:min-h-[8.2rem] max-md:p-[.9rem] max-[460px]:min-h-28" data-area="MOTOR" data-spa-link aria-label="Abrir mantenimiento de Motor">
          <span class="system-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 10h3l2-3h5l2 3h3v7H4v-7Z"/><path d="M7 17v2h3v-2m4 0v2h3v-2M9 11h5"/><path d="M19 12h2v3h-2"/></svg></span><span>Motor</span><span class="card-arrow" aria-hidden="true">↗</span>
        </a>
       </div>
    </section>
  </div>
</AdminShell>

<script>
  import { api } from '../../../lib/api';

  const isValidBusId = (value: string) => /^[1-9]\d*$/.test(value.trim()) && Number.isSafeInteger(Number(value));
  async function initMaintenanceAreas() {
    const grid = document.querySelector<HTMLElement>('[data-maintenance-areas]');
    if (!grid) return;
    const busId = new URLSearchParams(window.location.search).get('id')?.trim() || '';
    const maintenanceKey = busId;
    if (grid.dataset.initialized === maintenanceKey) return;
    grid.dataset.initialized = maintenanceKey;
    grid.dataset.maintenanceKey = maintenanceKey;
    const valid = isValidBusId(busId);
    const plateNodes = document.querySelectorAll<HTMLElement>('[data-bus-plate]');
    const badge = document.querySelector<HTMLElement>('[data-unit-plate]');
    plateNodes.forEach((element) => { element.textContent = valid ? 'Cargando placa…' : '—'; });
    badge?.classList.toggle('invalid-badge', !valid);
    if (badge) badge.textContent = valid ? 'PLACA · Cargando…' : 'PLACA —';
    document.title = valid ? 'Mantenimiento · Cargando placa…' : 'Mantenimiento · Bus no válido';
    document.querySelectorAll<HTMLAnchorElement>('[data-area]').forEach((link) => {
      if (valid) {
        link.href = `/admin/buses/mantenimiento/historial?busId=${encodeURIComponent(busId)}&area=${encodeURIComponent(link.dataset.area || '')}`;
        link.removeAttribute('aria-disabled');
        link.removeAttribute('tabindex');
      } else {
        link.removeAttribute('href');
        link.setAttribute('aria-disabled', 'true');
        link.tabIndex = -1;
      }
    });
    if (!valid) return;

    try {
      const bus = await api(`/buses/${encodeURIComponent(busId)}`) as { placa?: string };
      if (!grid.isConnected || grid.dataset.maintenanceKey !== maintenanceKey) return;
      const plate = bus.placa?.trim() || 'Placa no disponible';
      plateNodes.forEach((element) => { element.textContent = plate; });
      if (badge) badge.textContent = `PLACA · ${plate}`;
      document.title = `Mantenimiento · ${plate}`;
    } catch {
      if (!grid.isConnected || grid.dataset.maintenanceKey !== maintenanceKey) return;
      plateNodes.forEach((element) => { element.textContent = 'Placa no disponible'; });
      if (badge) badge.textContent = 'PLACA · No disponible';
      document.title = 'Mantenimiento · Placa no disponible';
    }
  }
  document.addEventListener('astro:page-load', initMaintenanceAreas);
  initMaintenanceAreas();
</script>
