---
import AdminShell from '../../../../components/AdminShell.astro';
---

<AdminShell title="Historial de mantenimiento · flotaBus" active="buses">
  <main class="mx-auto max-w-[1120px]">
    <section class="fade-in mb-[2.8rem] flex flex-col items-start gap-5 md:flex-row md:items-end md:justify-between" aria-labelledby="history-title">
      <div class="min-w-0">
        <nav class="mb-5 flex gap-[.55rem] text-[.7rem] font-bold tracking-[.05em] text-[var(--subtle)]" aria-label="Ruta de navegación">
          <a href="/admin/buses" data-spa-link class="text-[var(--cyan)] no-underline hover:text-[var(--amber)]">Flota</a><span aria-hidden="true">/</span><span>Mantenimiento</span>
        </nav>
        <div class="text-[.64rem] font-extrabold uppercase tracking-[.2em] text-[var(--amber)]">ÁREA TÉCNICA · PLACA <span data-bus-plate>—</span></div>
        <h1 id="history-title" class="my-[.55rem] mb-[.9rem] font-display text-[clamp(3rem,7vw,6.2rem)] font-semibold leading-[.86] tracking-[-.075em] text-[var(--ink)] max-md:max-w-full [overflow-wrap:anywhere]"><span data-area-label>Área</span><br /><em class="not-italic text-[var(--cyan)]">en seguimiento.</em></h1>
        <p class="m-0 max-w-[39rem] leading-[1.65] text-[var(--muted)]">Registro operativo de intervenciones, costos y evidencias para mantener la unidad lista para ruta.</p>
        <div class="mt-[1.35rem] flex flex-wrap gap-[.55rem]">
          <span class="inline-flex items-center gap-2 rounded-full border border-[rgba(72,228,224,.2)] bg-[rgba(72,228,224,.07)] px-[.7rem] py-[.46rem] text-[.63rem] font-extrabold uppercase tracking-[.08em] text-[var(--cyan)]"><span class="status-dot" aria-hidden="true"></span>Seguimiento activo</span>
          <span class="inline-flex items-center gap-2 rounded-full border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.28)] px-[.7rem] py-[.46rem] text-[.63rem] font-extrabold uppercase tracking-[.08em] text-[var(--muted)]">PLACA <strong data-bus-plate class="text-[var(--ink)]">—</strong></span>
          <span class="inline-flex items-center gap-2 rounded-full border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.28)] px-[.7rem] py-[.46rem] text-[.63rem] font-extrabold uppercase tracking-[.08em] text-[var(--muted)]">ÁREA <strong data-area-label class="text-[var(--ink)]">Área</strong></span>
        </div>
      </div>
      <div class="flex w-full items-center justify-end gap-4 md:w-auto">
        <div class="grid h-[4.5rem] w-[4.5rem] place-items-center rounded-[1.3rem] border border-[rgba(245,173,75,.3)] bg-[linear-gradient(145deg,rgba(245,173,75,.16),rgba(245,173,75,.025))] text-[var(--amber)] shadow-[0_0_45px_rgba(245,173,75,.06)]" aria-hidden="true"><svg class="h-8 w-8 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18.5V6.8a1.8 1.8 0 0 1 1.8-1.8h12.4A1.8 1.8 0 0 1 20 6.8v11.7M3 18.5h18M7 15V9m5 6V9m5 6v-3M4 21h16" /></svg></div>
        <a class="inline-flex flex-[0_0_auto] items-center gap-[.45rem] text-[.8rem] font-bold text-[var(--cyan)] no-underline transition-all hover:-translate-x-[3px] hover:text-[var(--amber)]" href="/admin/buses" data-spa-link><span aria-hidden="true">←</span> Volver a buses</a>
      </div>
    </section>

    <section class="glass fade-in overflow-hidden rounded-[1.4rem]" style="animation-delay:.08s" aria-labelledby="records-title">
      <header class="flex items-center justify-between gap-6 border-b border-[rgba(234,239,226,.09)] bg-[linear-gradient(100deg,rgba(72,228,224,.065),transparent_55%)] px-[1.65rem] pb-[1.35rem] pt-6 max-md:flex-col max-md:items-stretch max-md:px-4 max-md:py-[1.2rem]">
        <div>
          <div class="text-[.64rem] font-extrabold uppercase tracking-[.2em] text-[var(--amber)]">BITÁCORA DE INTERVENCIONES</div>
          <div class="mb-1 mt-[.42rem] flex items-center gap-3"><h2 id="records-title" class="m-0 text-[clamp(1.35rem,2vw,1.8rem)] tracking-[-.04em] text-[var(--ink)]">Registros de mantenimiento</h2><span id="record-count" class="grid h-8 min-w-8 place-items-center rounded-[.65rem] border border-[rgba(245,173,75,.3)] bg-[rgba(245,173,75,.1)] px-[.45rem] text-[.72rem] font-extrabold text-[var(--amber)]" aria-label="Cantidad de registros">—</span></div>
          <p class="m-0 text-[.75rem] text-[var(--muted)]">De la intervención más reciente a la más antigua.</p>
        </div>
        <button id="new-maintenance" class="btn btn-primary min-h-12 whitespace-nowrap max-md:w-full" type="button"><span class="align-[-.08em] text-xl" aria-hidden="true">+</span> Nuevo mantenimiento</button>
      </header>
      <div id="history-state" class="py-4 text-center text-[.78rem] text-[var(--muted)]" role="status" aria-live="polite">Cargando historial…</div>
      <div id="history-list" class="grid gap-[.65rem] px-[1.1rem] pb-[1.2rem] pt-4 empty:hidden max-md:gap-[.55rem] max-md:px-[.65rem] max-md:pb-4 max-md:pt-3"></div>
    </section>
  </main>

  <div id="maintenance-modal" class="modal-backdrop" hidden aria-hidden="true">
    <div class="glass modal-card admin-modal-card maintenance-modal" role="dialog" aria-modal="true" aria-labelledby="maintenance-modal-title">
      <div class="modal-heading"><div><div class="eyebrow">NUEVA INTERVENCIÓN · <span data-modal-area>ÁREA</span></div><h2 id="maintenance-modal-title" class="font-display">Registrar mantenimiento</h2><p class="m-0 text-[.75rem] text-[var(--muted)]">La fecha se asigna automáticamente al guardar.</p></div><button id="close-maintenance" class="icon-button" type="button" aria-label="Cerrar">×</button></div>
      <form id="maintenance-form" class="maintenance-form">
        <div class="maintenance-form-scroll">
          <section class="grid gap-4 rounded-2xl border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.22)] p-[1.1rem]"><div class="flex items-start gap-[.7rem]"><span class="font-display text-[var(--amber)]">01</span><div><h3>Valor de la intervención</h3><p>Registra el costo total en pesos colombianos.</p></div></div><label class="grid gap-[.45rem] text-[.82rem] text-[#c9d2cc]">Valor / costo (COP)<input id="maintenance-cost" class="input" required inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" placeholder="Ej. 850000.00" /></label></section>
          <section class="grid gap-4 rounded-2xl border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.22)] p-[1.1rem]"><div class="flex items-start gap-[.7rem]"><span class="font-display text-[var(--amber)]">02</span><div><h3>Detalle del trabajo</h3><p>Describe la intervención realizada.</p></div></div><label class="grid gap-[.45rem] text-[.82rem] text-[#c9d2cc]">Detalle<textarea id="maintenance-detail" class="input" required minlength="1" maxlength="2000" rows="5" placeholder="Ej. Cambio y calibración de…"></textarea></label></section>
          <section class="grid gap-4 rounded-2xl border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.22)] p-[1.1rem]"><div class="flex items-start gap-[.7rem]"><span class="font-display text-[var(--amber)]">03</span><div><h3>Soporte visual</h3><p>Adjunta una referencia si está disponible.</p></div></div><label class="grid gap-[.45rem] text-[.82rem] text-[#c9d2cc]"><span class="flex min-h-[3.25rem] flex-wrap items-start gap-3 rounded-[.8rem] border border-dashed border-[rgba(72,228,224,.22)] bg-[rgba(72,228,224,.045)] p-[.85rem]"><span class="grid h-[2.2rem] w-[2.2rem] place-items-center rounded-[.65rem] bg-[rgba(72,228,224,.1)] text-[1.4rem] text-[var(--cyan)]" aria-hidden="true">⌁</span><span><strong>Seleccionar foto</strong><small>JPG, PNG o WEBP · máximo 5 MB</small></span></span><input id="maintenance-photo" class="input p-[.55rem] sr-only" type="file" accept="image/jpeg,image/png,image/webp" /><small class="mt-[.18rem] text-[.68rem] text-[var(--muted)]">La evidencia se conserva junto al registro.</small></label></section>
        </div>
      </form>
      <div class="form-actions" aria-label="Acciones del formulario"><button id="cancel-maintenance" class="btn btn-secondary" type="button">Cancelar</button><button id="save-maintenance" class="btn btn-primary" type="submit" form="maintenance-form">Guardar</button></div>
    </div>
  </div>
</AdminShell>

<script>
  import { api } from '../../../../lib/api';
  import { feedback, Swal } from '../../../../lib/feedback';

  const labels: Record<string, string> = { CAJA: 'Caja', TRANSMISION: 'Transmisión', RETARDADOR: 'Retardador', LLANTAS: 'Llantas', AIRE_ACONDICIONADO: 'Aire acondicionado', MOTOR: 'Motor' };
  type Context = { busId: string; area: keyof typeof labels | ''; label: string; valid: boolean; plate: string };
  type RecordItem = { id: number; cost: string | number; detail: string; photoUrl?: string | null; recordedAt: string };

  const getContext = (): Context => {
    const params = new URLSearchParams(window.location.search);
    const busId = params.get('busId')?.trim() || '';
    const areaValue = params.get('area')?.trim().toUpperCase() || '';
    const area = Object.prototype.hasOwnProperty.call(labels, areaValue) ? areaValue as keyof typeof labels : '';
    return { busId, area, label: area ? labels[area] : 'Área', valid: /^[1-9]\d*$/.test(busId) && Number.isSafeInteger(Number(busId)) && Boolean(area), plate: '' };
  };

  async function initHistory() {
    const context = getContext();
    document.querySelectorAll<HTMLElement>('[data-bus-plate]').forEach((node) => { node.textContent = context.valid ? 'Cargando placa…' : '—'; });
    document.querySelectorAll<HTMLElement>('[data-area-label]').forEach((node) => { node.textContent = context.label; });
    const modalArea = document.querySelector<HTMLElement>('[data-modal-area]'); if (modalArea) modalArea.textContent = context.label.toUpperCase();
    document.title = `${context.label} · Cargando placa…`;
    const list = document.querySelector<HTMLElement>('#history-list'); if (!list || !context.valid || list.dataset.historyKey === `${context.busId}:${context.area}`) return;
    list.dataset.historyKey = `${context.busId}:${context.area}`;
    const state = document.querySelector<HTMLElement>('#history-state')!;
    const count = document.querySelector<HTMLElement>('#record-count')!;
    const modal = document.querySelector<HTMLElement>('#maintenance-modal')!;
    const form = document.querySelector<HTMLFormElement>('#maintenance-form')!;
    const file = document.querySelector<HTMLInputElement>('#maintenance-photo')!;
    const money = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 2 });
    const dateFormat = new Intl.DateTimeFormat('es-CO', { dateStyle: 'medium', timeStyle: 'short' });
    const historyKey = `${context.busId}:${context.area}`;
    let lastFocused: HTMLElement | null = null;
    const close = () => { if (modal.hidden || modal.classList.contains('is-closing')) return; modal.classList.remove('is-open'); modal.classList.add('is-closing'); window.setTimeout(() => { modal.hidden = true; modal.classList.remove('is-closing'); modal.setAttribute('aria-hidden', 'true'); lastFocused?.focus(); }, 230); };
    const open = () => { lastFocused = document.activeElement as HTMLElement; modal.hidden = false; modal.setAttribute('aria-hidden', 'false'); requestAnimationFrame(() => modal.classList.add('is-open')); window.setTimeout(() => document.querySelector<HTMLInputElement>('#maintenance-cost')?.focus(), 40); };
    const render = (items: RecordItem[]) => {
      list.replaceChildren(); state.className = 'state'; count.textContent = String(items.length).padStart(2, '0'); count.setAttribute('aria-label', `${items.length} registros`);
      if (!items.length) { state.innerHTML = '<div class="mx-auto grid max-w-[31rem] justify-items-center gap-[.65rem] px-4 pb-[4.5rem] pt-16 text-center"><span class="mb-[.45rem] grid h-20 w-20 place-items-center rounded-[1.5rem] border border-[rgba(72,228,224,.25)] bg-[radial-gradient(circle,rgba(72,228,224,.15),rgba(72,228,224,.035))] text-[var(--cyan)] shadow-[0_0_45px_rgba(72,228,224,.08)]" aria-hidden="true"><svg class="h-[2.1rem] w-[2.1rem] stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4.5h12A1.5 1.5 0 0 1 19.5 6v12a1.5 1.5 0 0 1-1.5 1.5H6A1.5 1.5 0 0 1 4.5 18V6A1.5 1.5 0 0 1 6 4.5Z"/><path d="M8 9h8M8 13h5M8 17h3"/></svg></span><strong class="font-display text-[1.3rem] font-semibold text-[var(--ink)]">Aún no hay intervenciones</strong><span class="text-[.78rem] leading-[1.6] text-[var(--muted)]">Construye la trazabilidad de esta área registrando el primer trabajo realizado.</span><button class="btn btn-secondary mt-[.55rem]" type="button">Registrar primera intervención</button></div>'; state.querySelector('button')?.addEventListener('click', open); return; }
      state.textContent = '';
       items.forEach((item) => {
const card = document.createElement('article'); card.className = 'group relative grid grid-cols-[6.5rem_minmax(0,1fr)_12rem] gap-4 min-h-28 rounded-[.85rem] border border-[rgba(234,239,226,.12)] bg-[linear-gradient(120deg,rgba(23,43,46,.78),rgba(7,15,19,.68))] py-[.8rem] pl-[.75rem] pr-[.85rem] shadow-[0_7px_18px_rgba(0,0,0,.13),inset_0_1px_rgba(255,255,255,.035)] transition-[transform,border-color,box-shadow] duration-200 hover:-translate-y-0.5 hover:border-[rgba(72,228,224,.42)] focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-[var(--amber)] max-md:grid-cols-1 max-md:gap-[.65rem] max-md:p-[.8rem]'; card.tabIndex = 0;
          card.innerHTML = `<div class="flex flex-col items-start gap-[.45rem] max-md:flex-row max-md:items-center"><span class="h-[.65rem] w-[.65rem] rounded-full border-2 border-[#101a1f] bg-[var(--cyan)] shadow-[0_0_0_1px_rgba(72,228,224,.4),0_0_10px_rgba(72,228,224,.2)]" aria-hidden="true"></span><time class="block max-w-[5.5rem] text-[.68rem] leading-[1.35] text-[var(--muted)] max-md:max-w-none" datetime="${item.recordedAt}">${dateFormat.format(new Date(item.recordedAt))}</time></div><div class="min-w-0"><div class="flex min-w-0 items-baseline gap-[.55rem]"><span class="whitespace-nowrap text-[.53rem] tracking-[.12em] text-[var(--subtle)]">MANTENIMIENTO</span><h3 class="m-0 overflow-hidden text-ellipsis whitespace-nowrap text-base text-[var(--ink)]">${context.label}</h3></div><div class="mb-[.55rem] mt-[.45rem] flex items-start gap-[.5rem]"><span class="grid h-5 w-5 flex-none place-items-center text-[var(--cyan)]" aria-hidden="true"><svg class="h-[.8rem] w-[.8rem] stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 6.5A2.5 2.5 0 0 1 7.5 4h9A2.5 2.5 0 0 1 19 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-9A2.5 2.5 0 0 1 5 17.5v-11Z"/><path d="M8 8h8M8 12h6M8 16h4"/></svg></span><p class="m-0 line-clamp-2 overflow-hidden text-[.77rem] leading-[1.4] text-[var(--ink)]"></p></div><div class="flex flex-wrap gap-x-[.8rem] gap-y-[.35rem] text-[.57rem] text-[var(--subtle)]"><span><b class="text-[var(--muted)]">PLACA</b> <span class="record-plate"></span></span><span><b class="text-[var(--muted)]">ÁREA</b> ${context.label}</span><span><b class="text-[var(--muted)]">ESTADO</b> Seguimiento</span></div></div><div class="grid grid-cols-[minmax(0,1fr)_5rem] items-center gap-[.7rem] border-l border-[rgba(234,239,226,.1)] pl-[.85rem] max-md:grid-cols-[minmax(0,1fr)_4.5rem] max-md:border-l-0 max-md:border-t max-md:pb-0 max-md:pl-0 max-md:pt-[.65rem]"><div><div class="mb-[.15rem] text-[.52rem] tracking-[.12em] text-[var(--subtle)]">COSTO TOTAL</div><strong class="record-cost block overflow-hidden text-ellipsis whitespace-nowrap font-display text-base leading-[1.1] text-[var(--amber)]"></strong></div><div class="maintenance-record-visual col-start-2 row-start-1"></div></div>`;
         card.querySelector<HTMLElement>('.record-cost')!.textContent = money.format(Number(item.cost)); card.querySelector('p')!.textContent = item.detail;
         card.querySelector<HTMLElement>('.record-plate')!.textContent = context.plate;
        const visual = card.querySelector<HTMLElement>('.maintenance-record-visual')!;
        if (item.photoUrl) { const link = document.createElement('a'); link.className = 'group block h-20 w-20 overflow-hidden rounded-[.6rem] max-md:h-[4.5rem] max-md:w-[4.5rem]'; link.href = item.photoUrl; link.target = '_blank'; link.rel = 'noreferrer'; link.setAttribute('aria-label', 'Abrir foto del mantenimiento en una pestaña nueva'); const image = document.createElement('img'); image.src = item.photoUrl; image.alt = 'Foto del mantenimiento'; link.append(image); visual.append(link); }
        else visual.innerHTML = '<div class="grid h-20 w-20 place-items-center gap-[.15rem] rounded-[.6rem] border border-dashed border-[rgba(72,228,224,.25)] text-[1.15rem] text-[var(--subtle)] max-md:h-[4.5rem] max-md:w-[4.5rem]"><span aria-hidden="true">⌁</span><small class="text-[.48rem]">Sin evidencia</small></div>';
        list.append(card);
      });
    };
    const load = async () => { state.textContent = 'Cargando historial…'; try { const [bus, records] = await Promise.all([api(`/buses/${encodeURIComponent(context.busId)}`) as Promise<{ placa?: string }>, api(`/maintenance-records?busId=${encodeURIComponent(context.busId)}&area=${encodeURIComponent(context.area)}`) as Promise<RecordItem[]>]); if (!list.isConnected || list.dataset.historyKey !== historyKey) return; context.plate = bus.placa?.trim() || 'Placa no disponible'; document.querySelectorAll<HTMLElement>('[data-bus-plate]').forEach((node) => { node.textContent = context.plate; }); document.title = `${context.label} · ${context.plate}`; render(records); } catch (cause) { if (!list.isConnected || list.dataset.historyKey !== historyKey) return; state.textContent = 'No pudimos cargar el historial. Intenta actualizar.'; state.className = 'state error-state'; await feedback.error(cause instanceof Error ? cause.message : 'Error inesperado.', 'Error al cargar'); } };
    document.querySelector<HTMLButtonElement>('#new-maintenance')?.addEventListener('click', open); document.querySelector('#close-maintenance')?.addEventListener('click', close); document.querySelector('#cancel-maintenance')?.addEventListener('click', close); modal.addEventListener('click', (event) => { if (event.target === modal) close(); }); document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !modal.hidden) close(); });
    file.addEventListener('change', () => { const selected = file.files?.[0]; if (selected && (!selected.type.startsWith('image/') || selected.size > 5 * 1024 * 1024)) { file.value = ''; void feedback.error('La foto debe ser JPG, PNG o WEBP y pesar máximo 5 MB.', 'Foto no válida'); } });
    form.addEventListener('submit', async (event) => { event.preventDefault(); const save = document.querySelector<HTMLButtonElement>('#save-maintenance')!; save.disabled = true; try { feedback.loading('Guardando mantenimiento…'); const detail = document.querySelector<HTMLTextAreaElement>('#maintenance-detail')!.value.trim(); await api(`/maintenance-records/buses/${encodeURIComponent(context.busId)}`, { method: 'POST', body: JSON.stringify({ area: context.area, cost: document.querySelector<HTMLInputElement>('#maintenance-cost')!.value.trim(), detail }) }); const incidentParams = new URLSearchParams(window.location.search); const tripId = incidentParams.get('tripId'); if (incidentParams.get('incident') === '1' && tripId) { try { await api(`/trips/${encodeURIComponent(tripId)}/events`, { method: 'POST', body: JSON.stringify({ type: 'INCIDENT', notes: detail }) }); } catch (cause) { await feedback.error('El mantenimiento se guardó pero no pudimos actualizar el estado del viaje.', 'Aviso'); } const cleanSearch = new URLSearchParams(window.location.search); cleanSearch.delete('incident'); cleanSearch.delete('tripId'); const remaining = cleanSearch.toString(); window.history.replaceState({}, '', `${window.location.pathname}${remaining ? `?${remaining}` : ''}`); } Swal.close(); close(); form.reset(); await feedback.success('El mantenimiento fue registrado.'); await load(); } catch (cause) { Swal.close(); await feedback.error(cause instanceof Error ? cause.message : 'Error inesperado.', 'No se pudo guardar'); } finally { save.disabled = false; } });
    const incidentParams = new URLSearchParams(window.location.search);
    if (incidentParams.get('incident') === '1') {
      const banner = document.createElement('div');
      banner.className = 'mb-4 rounded-[.8rem] border border-[rgba(255,116,116,.35)] bg-[rgba(255,116,116,.08)] px-4 py-3 text-[.78rem] text-[#ff9daa]';
      banner.innerHTML = '<strong>Modo incidencia.</strong> Registra el mantenimiento del área afectada para actualizar el estado del viaje. Si cancelas, el viaje sigue igual.';
      document.querySelector('main')?.prepend(banner);
    }
    void load();
  }
  document.addEventListener('astro:page-load', initHistory); initHistory();
</script>

