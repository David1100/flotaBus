---
import AdminShell from '../../../../components/AdminShell.astro';
---

<AdminShell title="Historial de mantenimiento · flotaBus" active="buses">
  <main class="maintenance-history-page">
    <section class="history-hero page-header fade-in" aria-labelledby="history-title">
      <div class="history-hero-copy">
        <nav class="history-breadcrumb" aria-label="Ruta de navegación">
          <a href="/admin/buses" data-spa-link>Flota</a><span aria-hidden="true">/</span><span>Mantenimiento</span>
        </nav>
        <div class="eyebrow">ÁREA TÉCNICA · PLACA <span data-bus-plate>—</span></div>
        <h1 id="history-title"><span data-area-label>Área</span><br /><em>en seguimiento.</em></h1>
        <p class="history-hero-summary">Registro operativo de intervenciones, costos y evidencias para mantener la unidad lista para ruta.</p>
        <div class="history-context-row">
          <span class="history-context-pill"><span class="status-dot" aria-hidden="true"></span>Seguimiento activo</span>
          <span class="history-context-id">PLACA <strong data-bus-plate>—</strong></span>
          <span class="history-context-id">ÁREA <strong data-area-label>Área</strong></span>
        </div>
      </div>
      <div class="history-hero-side">
        <div class="history-area-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 18.5V6.8a1.8 1.8 0 0 1 1.8-1.8h12.4A1.8 1.8 0 0 1 20 6.8v11.7M3 18.5h18M7 15V9m5 6V9m5 6v-3M4 21h16" /></svg></div>
        <a class="back-link" href="/admin/buses" data-spa-link><span aria-hidden="true">←</span> Volver a buses</a>
      </div>
    </section>

    <section class="history-workspace glass fade-in" style="animation-delay:.08s" aria-labelledby="records-title">
      <header class="history-toolbar">
        <div>
          <div class="eyebrow">BITÁCORA DE INTERVENCIONES</div>
          <div class="history-toolbar-title"><h2 id="records-title">Registros de mantenimiento</h2><span id="record-count" class="record-count" aria-label="Cantidad de registros">—</span></div>
          <p class="panel-description">De la intervención más reciente a la más antigua.</p>
        </div>
        <button id="new-maintenance" class="btn btn-primary new-maintenance-button" type="button"><span aria-hidden="true">+</span> Nuevo mantenimiento</button>
      </header>
      <div id="history-state" class="state" role="status" aria-live="polite">Cargando historial…</div>
      <div id="history-list" class="maintenance-history-list"></div>
    </section>
  </main>

  <div id="maintenance-modal" class="modal-backdrop" hidden aria-hidden="true">
    <div class="glass modal-card admin-modal-card maintenance-modal" role="dialog" aria-modal="true" aria-labelledby="maintenance-modal-title">
      <div class="modal-heading"><div><div class="eyebrow">NUEVA INTERVENCIÓN · <span data-modal-area>ÁREA</span></div><h2 id="maintenance-modal-title" class="font-display">Registrar mantenimiento</h2><p class="modal-subtitle">La fecha se asigna automáticamente al guardar.</p></div><button id="close-maintenance" class="icon-button" type="button" aria-label="Cerrar">×</button></div>
      <form id="maintenance-form" class="maintenance-form">
        <div class="maintenance-form-scroll">
          <section class="maintenance-form-section"><div class="maintenance-section-title"><span class="section-index">01</span><div><h3>Valor de la intervención</h3><p>Registra el costo total en pesos colombianos.</p></div></div><label class="form-label full">Valor / costo (COP)<input id="maintenance-cost" class="input" required inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" placeholder="Ej. 850000.00" /></label></section>
          <section class="maintenance-form-section"><div class="maintenance-section-title"><span class="section-index">02</span><div><h3>Detalle del trabajo</h3><p>Describe la intervención realizada.</p></div></div><label class="form-label full">Detalle<textarea id="maintenance-detail" class="input" required minlength="1" maxlength="2000" rows="5" placeholder="Ej. Cambio y calibración de…"></textarea></label></section>
          <section class="maintenance-form-section"><div class="maintenance-section-title"><span class="section-index">03</span><div><h3>Soporte visual</h3><p>Adjunta una referencia si está disponible.</p></div></div><label class="form-label full photo-input-label"><span class="photo-input-control"><span class="photo-input-icon" aria-hidden="true">⌁</span><span><strong>Seleccionar foto</strong><small>JPG, PNG o WEBP · máximo 5 MB</small></span></span><input id="maintenance-photo" class="input photo-input" type="file" accept="image/jpeg,image/png,image/webp" /><small class="photo-note">La evidencia se conserva junto al registro.</small></label></section>
        </div>
        <div class="form-actions"><button id="cancel-maintenance" class="btn btn-secondary" type="button">Cancelar</button><button id="save-maintenance" class="btn btn-primary" type="submit">Guardar registro</button></div>
      </form>
    </div>
  </div>
</AdminShell>

<script>
  import { api } from '../../../../lib/api';
  import { feedback, Swal } from '../../../../lib/feedback';

  const labels: Record<string, string> = { CAJA: 'Caja', TRANSMISION: 'Transmisión', RETARDADOR: 'Retardador', LLANTAS: 'Llantas', AIRE_ACONDICIONADO: 'Aire acondicionado', MOTOR: 'Motor' };
  type Context = { busId: string; area: keyof typeof labels | ''; label: string; valid: boolean; plate: string };
  type RecordItem = { id: number; cost: string | number; detail: string; photoUrl?: string | null; recordedAt: string };

  const getContext = (): Context => {
    const params = new URLSearchParams(window.location.search);
    const busId = params.get('busId')?.trim() || '';
    const areaValue = params.get('area')?.trim().toUpperCase() || '';
    const area = Object.prototype.hasOwnProperty.call(labels, areaValue) ? areaValue as keyof typeof labels : '';
    return { busId, area, label: area ? labels[area] : 'Área', valid: /^[1-9]\d*$/.test(busId) && Number.isSafeInteger(Number(busId)) && Boolean(area), plate: '' };
  };

  async function initHistory() {
    const context = getContext();
    document.querySelectorAll<HTMLElement>('[data-bus-plate]').forEach((node) => { node.textContent = context.valid ? 'Cargando placa…' : '—'; });
    document.querySelectorAll<HTMLElement>('[data-area-label]').forEach((node) => { node.textContent = context.label; });
    const modalArea = document.querySelector<HTMLElement>('[data-modal-area]'); if (modalArea) modalArea.textContent = context.label.toUpperCase();
    document.title = `${context.label} · Cargando placa…`;
    const list = document.querySelector<HTMLElement>('#history-list'); if (!list || !context.valid || list.dataset.historyKey === `${context.busId}:${context.area}`) return;
    list.dataset.historyKey = `${context.busId}:${context.area}`;
    const state = document.querySelector<HTMLElement>('#history-state')!;
    const count = document.querySelector<HTMLElement>('#record-count')!;
    const modal = document.querySelector<HTMLElement>('#maintenance-modal')!;
    const form = document.querySelector<HTMLFormElement>('#maintenance-form')!;
    const file = document.querySelector<HTMLInputElement>('#maintenance-photo')!;
    const money = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 2 });
    const dateFormat = new Intl.DateTimeFormat('es-CO', { dateStyle: 'medium', timeStyle: 'short' });
    const historyKey = `${context.busId}:${context.area}`;
    let lastFocused: HTMLElement | null = null;
    const close = () => { if (modal.hidden || modal.classList.contains('is-closing')) return; modal.classList.remove('is-open'); modal.classList.add('is-closing'); window.setTimeout(() => { modal.hidden = true; modal.classList.remove('is-closing'); modal.setAttribute('aria-hidden', 'true'); lastFocused?.focus(); }, 230); };
    const open = () => { lastFocused = document.activeElement as HTMLElement; modal.hidden = false; modal.setAttribute('aria-hidden', 'false'); requestAnimationFrame(() => modal.classList.add('is-open')); window.setTimeout(() => document.querySelector<HTMLInputElement>('#maintenance-cost')?.focus(), 40); };
    const render = (items: RecordItem[]) => {
      list.replaceChildren(); state.className = 'state'; count.textContent = String(items.length).padStart(2, '0'); count.setAttribute('aria-label', `${items.length} registros`);
      if (!items.length) { state.innerHTML = '<div class="empty-history"><span class="empty-history-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M6 4.5h12A1.5 1.5 0 0 1 19.5 6v12a1.5 1.5 0 0 1-1.5 1.5H6A1.5 1.5 0 0 1 4.5 18V6A1.5 1.5 0 0 1 6 4.5Z"/><path d="M8 9h8M8 13h5M8 17h3"/></svg></span><strong>Aún no hay intervenciones</strong><span>Construye la trazabilidad de esta área registrando el primer trabajo realizado.</span><button class="btn btn-secondary empty-history-action" type="button">Registrar primera intervención</button></div>'; state.querySelector('button')?.addEventListener('click', open); return; }
      state.textContent = '';
       items.forEach((item) => {
         const card = document.createElement('article'); card.className = 'maintenance-record'; card.tabIndex = 0;
         card.innerHTML = `<div class="record-rail"><span class="maintenance-record-marker" aria-hidden="true"></span><time class="record-date" datetime="${item.recordedAt}">${dateFormat.format(new Date(item.recordedAt))}</time></div><div class="maintenance-record-content"><div class="record-heading"><span class="record-kicker">MANTENIMIENTO</span><h3>${context.label}</h3></div><div class="record-detail"><span class="record-detail-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 6.5A2.5 2.5 0 0 1 7.5 4h9A2.5 2.5 0 0 1 19 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-9A2.5 2.5 0 0 1 5 17.5v-11Z"/><path d="M8 8h8M8 12h6M8 16h4"/></svg></span><p></p></div><div class="record-meta"><span><b>PLACA</b> <span class="record-plate"></span></span><span><b>ÁREA</b> ${context.label}</span><span><b>ESTADO</b> Seguimiento</span></div></div><div class="record-aside"><div class="cost-label">COSTO TOTAL</div><strong class="record-cost"></strong><div class="maintenance-record-visual"></div></div>`;
         card.querySelector<HTMLElement>('.record-cost')!.textContent = money.format(Number(item.cost)); card.querySelector('p')!.textContent = item.detail;
         card.querySelector<HTMLElement>('.record-plate')!.textContent = context.plate;
        const visual = card.querySelector<HTMLElement>('.maintenance-record-visual')!;
        if (item.photoUrl) { const link = document.createElement('a'); link.className = 'record-photo'; link.href = item.photoUrl; link.target = '_blank'; link.rel = 'noreferrer'; link.setAttribute('aria-label', 'Abrir foto del mantenimiento en una pestaña nueva'); const image = document.createElement('img'); image.src = item.photoUrl; image.alt = 'Foto del mantenimiento'; link.append(image); visual.append(link); }
        else visual.innerHTML = '<div class="record-photo record-photo-placeholder"><span aria-hidden="true">⌁</span><small>Sin evidencia</small></div>';
        list.append(card);
      });
    };
    const load = async () => { state.textContent = 'Cargando historial…'; try { const [bus, records] = await Promise.all([api(`/buses/${encodeURIComponent(context.busId)}`) as Promise<{ placa?: string }>, api(`/maintenance-records?busId=${encodeURIComponent(context.busId)}&area=${encodeURIComponent(context.area)}`) as Promise<RecordItem[]>]); if (!list.isConnected || list.dataset.historyKey !== historyKey) return; context.plate = bus.placa?.trim() || 'Placa no disponible'; document.querySelectorAll<HTMLElement>('[data-bus-plate]').forEach((node) => { node.textContent = context.plate; }); document.title = `${context.label} · ${context.plate}`; render(records); } catch (cause) { if (!list.isConnected || list.dataset.historyKey !== historyKey) return; state.textContent = 'No pudimos cargar el historial. Intenta actualizar.'; state.className = 'state error-state'; await feedback.error(cause instanceof Error ? cause.message : 'Error inesperado.', 'Error al cargar'); } };
    document.querySelector<HTMLButtonElement>('#new-maintenance')?.addEventListener('click', open); document.querySelector('#close-maintenance')?.addEventListener('click', close); document.querySelector('#cancel-maintenance')?.addEventListener('click', close); modal.addEventListener('click', (event) => { if (event.target === modal) close(); }); document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !modal.hidden) close(); });
    file.addEventListener('change', () => { const selected = file.files?.[0]; if (selected && (!selected.type.startsWith('image/') || selected.size > 5 * 1024 * 1024)) { file.value = ''; void feedback.error('La foto debe ser JPG, PNG o WEBP y pesar máximo 5 MB.', 'Foto no válida'); } });
    form.addEventListener('submit', async (event) => { event.preventDefault(); const save = document.querySelector<HTMLButtonElement>('#save-maintenance')!; save.disabled = true; try { feedback.loading('Guardando mantenimiento…'); await api(`/maintenance-records/buses/${encodeURIComponent(context.busId)}`, { method: 'POST', body: JSON.stringify({ area: context.area, cost: document.querySelector<HTMLInputElement>('#maintenance-cost')!.value.trim(), detail: document.querySelector<HTMLTextAreaElement>('#maintenance-detail')!.value.trim() }) }); Swal.close(); close(); form.reset(); await feedback.success('El mantenimiento fue registrado.'); await load(); } catch (cause) { Swal.close(); await feedback.error(cause instanceof Error ? cause.message : 'Error inesperado.', 'No se pudo guardar'); } finally { save.disabled = false; } });
    void load();
  }
  document.addEventListener('astro:page-load', initHistory); initHistory();
</script>

<style>
  .maintenance-history-page { max-width:1120px; margin:0 auto; }
  .history-hero { align-items:end; margin-bottom:2.8rem; }
  .history-hero-copy { min-width:0; }
  .history-breadcrumb { display:flex; gap:.55rem; margin-bottom:1.25rem; color:var(--subtle); font-size:.7rem; font-weight:700; letter-spacing:.05em; }
  .history-breadcrumb a { color:var(--cyan); text-decoration:none; }.history-breadcrumb a:hover { color:var(--amber); }
  .history-hero-copy h1 { margin:.55rem 0 .9rem; font-size:clamp(3rem,7vw,6.2rem); line-height:.86; letter-spacing:-.075em; }.history-hero-copy h1 em { color:var(--cyan); font-style:normal; }
  .history-hero-summary { max-width:39rem; margin:0; color:var(--muted); line-height:1.65; }
  .history-context-row { display:flex; flex-wrap:wrap; gap:.55rem; margin-top:1.35rem; }.history-context-pill,.history-context-id { display:inline-flex; align-items:center; gap:.5rem; padding:.46rem .7rem; border:1px solid rgba(234,239,226,.1); border-radius:999px; color:var(--muted); background:rgba(5,11,14,.28); font-size:.63rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }.history-context-pill { color:var(--cyan); border-color:rgba(72,228,224,.2); background:rgba(72,228,224,.07); }.history-context-id strong { color:var(--ink); }
  .history-hero-side { display:flex; align-items:center; gap:1rem; }.history-area-mark { display:grid; place-items:center; width:4.5rem; height:4.5rem; border:1px solid rgba(245,173,75,.3); border-radius:1.3rem; color:var(--amber); background:linear-gradient(145deg,rgba(245,173,75,.16),rgba(245,173,75,.025)); box-shadow:0 0 45px rgba(245,173,75,.06); }.history-area-mark svg { width:2rem; height:2rem; stroke:currentColor; stroke-linecap:round; stroke-linejoin:round; stroke-width:1.25; }
  .history-workspace { overflow:hidden; border-radius:1.4rem; }.history-toolbar { display:flex; align-items:center; justify-content:space-between; gap:1.5rem; padding:1.5rem 1.65rem 1.35rem; border-bottom:1px solid rgba(234,239,226,.09); background:linear-gradient(100deg,rgba(72,228,224,.065),transparent 55%); }.history-toolbar-title { display:flex; align-items:center; gap:.75rem; margin:.42rem 0 .25rem; }.history-toolbar h2 { margin:0; color:var(--ink); font-size:clamp(1.35rem,2vw,1.8rem); letter-spacing:-.04em; }.record-count { display:grid; place-items:center; min-width:2rem; height:2rem; padding:0 .45rem; border:1px solid rgba(245,173,75,.3); border-radius:.65rem; color:var(--amber); background:rgba(245,173,75,.1); font-size:.72rem; font-weight:800; }.panel-description { margin:0; color:var(--muted); font-size:.75rem; }.new-maintenance-button { min-height:3rem; white-space:nowrap; }.new-maintenance-button span { font-size:1.25rem; vertical-align:-.08em; }
  .maintenance-history-list { display:grid; gap:1rem; padding:1.25rem 1.35rem 1.5rem; }.maintenance-history-list:empty { display:none; }
  .maintenance-record { position:relative; display:grid; grid-template-columns:3.2rem minmax(0,1fr) 11rem; gap:1rem; min-width:0; padding:1.1rem 1.15rem 1.1rem .7rem; border:1px solid rgba(234,239,226,.12); border-radius:1.15rem; background:linear-gradient(120deg,rgba(23,43,46,.78),rgba(7,15,19,.68)); box-shadow:0 12px 30px rgba(0,0,0,.16),inset 0 1px rgba(255,255,255,.04); transition:transform .22s,border-color .22s,box-shadow .22s,background .22s; }.maintenance-record::after { content:''; position:absolute; inset:0 auto 0 0; width:3px; border-radius:1.15rem 0 0 1.15rem; background:linear-gradient(var(--cyan),var(--amber)); opacity:.7; }.maintenance-record:hover { transform:translateY(-4px); border-color:rgba(72,228,224,.42); background:linear-gradient(120deg,rgba(27,57,59,.86),rgba(8,18,22,.74)); box-shadow:0 20px 40px rgba(0,0,0,.3),0 0 0 1px rgba(72,228,224,.05); }.maintenance-record:focus-visible { outline:2px solid var(--amber); outline-offset:3px; }.record-rail { position:relative; display:flex; flex-direction:column; align-items:center; gap:.55rem; }.record-rail::after { content:''; position:absolute; top:1.7rem; bottom:-1.7rem; width:1px; background:linear-gradient(var(--cyan),transparent); opacity:.35; }.maintenance-record:last-child .record-rail::after { display:none; }.maintenance-record-marker { z-index:1; width:1rem; height:1rem; border:3px solid #101a1f; border-radius:50%; background:var(--cyan); box-shadow:0 0 0 1px rgba(72,228,224,.5),0 0 16px rgba(72,228,224,.28); }.record-ordinal { color:var(--subtle); font-size:.63rem; font-weight:800; letter-spacing:.1em; writing-mode:vertical-rl; }.maintenance-record-content { min-width:0; }.record-topline { display:flex; justify-content:space-between; gap:1rem; align-items:flex-start; }.record-kicker { color:var(--amber); font-size:.58rem; font-weight:800; letter-spacing:.15em; }.record-heading h3 { margin:.28rem 0 0; color:var(--ink); font-size:1.14rem; }.record-date { display:grid; gap:.15rem; justify-items:end; text-align:right; }.record-date span,.cost-label { color:var(--subtle); font-size:.57rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }.record-date time { color:var(--ink); font-size:.71rem; white-space:nowrap; }.record-detail { display:flex; gap:.6rem; margin-top:.9rem; padding-top:.8rem; border-top:1px solid rgba(234,239,226,.08); }.record-detail-icon { display:grid; place-items:center; width:1.7rem; height:1.7rem; flex:0 0 auto; border-radius:.55rem; color:var(--cyan); background:rgba(72,228,224,.08); }.record-detail-icon svg { width:1rem; height:1rem; stroke:currentColor; stroke-linecap:round; stroke-linejoin:round; stroke-width:1.5; }.maintenance-record p { margin:0; color:#c8d2ce; font-size:.78rem; line-height:1.6; white-space:pre-wrap; }.record-meta { display:flex; flex-wrap:wrap; gap:.45rem .9rem; margin-top:.85rem; color:var(--muted); font-size:.61rem; letter-spacing:.04em; }.record-meta span { display:inline-flex; gap:.3rem; }.record-meta b { color:var(--subtle); font-size:.55rem; letter-spacing:.1em; }.record-aside { display:flex; flex-direction:column; align-items:flex-end; gap:.3rem; padding-left:1rem; border-left:1px solid rgba(234,239,226,.1); }.record-cost { color:var(--cyan); font:700 clamp(1.05rem,2vw,1.35rem)/1.1 'Outfit',sans-serif; letter-spacing:-.04em; text-align:right; }.maintenance-record-visual { margin-top:auto; padding-top:.75rem; }.record-photo { display:grid; place-items:center; width:9.2rem; height:4.8rem; overflow:hidden; border:1px solid rgba(72,228,224,.2); border-radius:.8rem; color:var(--cyan); background:linear-gradient(135deg,rgba(72,228,224,.1),rgba(5,11,14,.6)); text-decoration:none; transition:transform .2s,border-color .2s; }.record-photo:hover { transform:scale(1.03); border-color:var(--cyan); }.record-photo img { width:100%; height:100%; object-fit:cover; }.record-photo-placeholder { gap:.08rem; color:var(--subtle); border-style:dashed; }.record-photo-placeholder span { color:var(--amber); font-size:1.2rem; }.record-photo-placeholder small { font-size:.58rem; }
  .empty-history { display:grid; justify-items:center; gap:.65rem; max-width:31rem; margin:0 auto; padding:4rem 1rem 4.5rem; text-align:center; }.empty-history-icon { display:grid; place-items:center; width:5rem; height:5rem; margin-bottom:.45rem; border:1px solid rgba(72,228,224,.25); border-radius:1.5rem; color:var(--cyan); background:radial-gradient(circle,rgba(72,228,224,.15),rgba(72,228,224,.035)); box-shadow:0 0 45px rgba(72,228,224,.08); }.empty-history-icon svg { width:2.1rem; height:2.1rem; stroke:currentColor; stroke-linecap:round; stroke-linejoin:round; stroke-width:1.3; }.empty-history strong { color:var(--ink); font:600 1.3rem 'Outfit',sans-serif; }.empty-history > span:not(.empty-history-icon) { color:var(--muted); font-size:.78rem; line-height:1.6; }.empty-history-action { margin-top:.55rem; }
   .maintenance-modal { width:min(100%,42rem); }.maintenance-form { display:grid; min-height:0; grid-template-rows:minmax(0,1fr) auto; gap:1rem; }.maintenance-form-scroll { display:grid; gap:1rem; min-height:0; max-height:58vh; overflow-y:auto; padding:.1rem .35rem .3rem 0; }.maintenance-form-section { display:grid; gap:1rem; padding:1.1rem; border:1px solid rgba(234,239,226,.1); border-radius:1rem; background:rgba(5,11,14,.22); }.maintenance-section-title { display:flex; align-items:flex-start; gap:.7rem; }.maintenance-section-title h3 { margin:.05rem 0 .18rem; color:var(--ink); font-size:1rem; }.maintenance-section-title p,.modal-subtitle { margin:0; color:var(--muted); font-size:.75rem; }.maintenance-modal label { display:grid; gap:.45rem; color:#c9d2cc; font-size:.82rem; }.photo-input-control { display:flex; align-items:center; gap:.75rem; padding:.85rem; border:1px dashed rgba(72,228,224,.22); border-radius:.8rem; background:rgba(72,228,224,.045); }.photo-input-control strong,.photo-input-control small { display:block; }.photo-input-control small,.photo-note { margin-top:.18rem; color:var(--muted); font-size:.68rem; }.photo-input-icon { display:grid; place-items:center; width:2.2rem; height:2.2rem; border-radius:.65rem; color:var(--cyan); background:rgba(72,228,224,.1); font-size:1.4rem; }.photo-input { padding:.55rem; }.btn:disabled { cursor:not-allowed; opacity:.48; transform:none; box-shadow:none; }
  @media(max-width:760px) { .history-hero { align-items:flex-start; flex-direction:column; }.history-hero-side { width:100%; justify-content:flex-end; }.history-toolbar { align-items:stretch; flex-direction:column; }.new-maintenance-button { width:100%; } }
  @media(max-width:640px) { .maintenance-history-list { padding:.9rem .65rem 1rem; }.maintenance-record { grid-template-columns:2rem minmax(0,1fr); padding:.95rem .8rem .95rem .5rem; }.record-aside { grid-column:2; align-items:flex-start; padding:1rem 0 0; border-top:1px solid rgba(234,239,226,.1); border-left:0; }.record-cost { text-align:left; }.record-photo { width:100%; height:6rem; }.record-date { justify-items:start; text-align:left; }.record-topline { flex-direction:column; gap:.5rem; }.history-toolbar { padding:1.2rem 1rem; }.maintenance-modal { padding:1.25rem; } }
  @media(prefers-reduced-motion:reduce) { .maintenance-record:hover,.record-photo:hover { transform:none; } }
