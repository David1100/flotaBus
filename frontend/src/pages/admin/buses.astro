---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Buses · flotaBus" active="buses">
  <div class="buses-page">
    <section class="buses-hero fade-in flex flex-col gap-8 md:flex-row md:items-end md:justify-between"><div><div class="eyebrow">FLOTA OPERATIVA · 02</div><h1>Unidades <em>en ruta.</em></h1><p>Controla los vehículos que mantienen cada recorrido en movimiento.</p></div></section>
    <section class="glass fleet-card buses-card fade-in" style="animation-delay:.08s"><div class="toolbar"><label class="search-field"><span aria-hidden="true">⌕</span><input id="search" class="input" placeholder="Buscar por placa, marca o modelo…" aria-label="Buscar buses" /></label><button id="new-bus" class="btn btn-primary" type="button">+ Añadir bus</button></div><div id="state" class="state" role="status" aria-live="polite">Cargando flota…</div><div id="bus-grid" class="bus-grid"></div></section>
  </div>
   <div id="modal" class="modal-backdrop" hidden aria-hidden="true"><div class="glass modal-card admin-modal-card modal-bus" role="dialog" aria-modal="true" aria-labelledby="modal-title"><div class="modal-heading"><div><div class="eyebrow">UNIDAD DE FLOTA</div><h2 id="modal-title" class="font-display">Nuevo bus</h2></div><button id="close" class="icon-button" type="button" aria-label="Cerrar">×</button></div><form id="bus-form" class="form-grid"><input id="bus-id" type="hidden" /><label>Placa<input id="bus-placa" class="input" required minlength="2" maxlength="16" /></label><label>Kilometraje<input id="bus-km" class="input" required type="number" min="0" max="2147483647" step="1" /></label><label>Marca<input id="bus-marca" class="input" required maxlength="80" /></label><label>Modelo<input id="bus-modelo" class="input" required maxlength="80" /></label><label class="full">Tipo de bus<select id="bus-type" class="input" required><option value="NORMAL">Normal</option><option value="DOBLE_PISO">Doble piso</option></select></label><label id="status-field" class="full">Estado operativo<select id="bus-status" class="input"><option value="AVAILABLE">Disponible</option><option value="ASSIGNED">Ruta asignada</option><option value="IN_TRANSIT">En ruta</option><option value="MAINTENANCE">En mantenimiento</option><option value="OUT_OF_ROUTE">Fuera de ruta</option><option value="STOPPED">Parada del chofer</option><option value="REFUELING">Tanqueando</option><option value="INCIDENT">Incidencia</option></select><small class="field-help">Un viaje activo conserva la prioridad sobre el estado manual.</small></label><div class="active-toggle full"><input id="bus-active" class="switch-input" type="checkbox" role="switch" aria-checked="true" aria-describedby="bus-active-help" checked /><label class="switch-label" for="bus-active"><span class="switch-track" aria-hidden="true"><span class="switch-thumb"></span></span><span class="switch-copy"><strong>Unidad activa</strong><small id="bus-active-help">Disponible para asignaciones · <span data-switch-state>Activa</span></small></span></label></div><div class="form-actions full"><button id="cancel" class="btn btn-secondary" type="button">Cancelar</button><button id="save" class="btn btn-primary" type="submit">Guardar</button></div></form></div></div>
</AdminShell>
<script>
  import { api } from '../../lib/api';
  import { feedback, Swal } from '../../lib/feedback';
  import { setupPhotoPicker } from '../../lib/photo-picker';
  const setupBusPhoto = () => {
    const form = document.querySelector<HTMLFormElement>('#bus-form'); if (!form || form.dataset.photoReady) return; form.dataset.photoReady = 'true';
    const picker = setupPhotoPicker(form, { inputId: 'bus-photo', title: 'Foto del bus' });
    const input = picker!.input;
    form.addEventListener('submit', async (event) => {
      event.stopImmediatePropagation(); event.preventDefault(); const idField = document.querySelector<HTMLInputElement>('#bus-id')!; const id = idField.value; const status = document.querySelector<HTMLSelectElement>('#bus-status')!; const saveButton = document.querySelector<HTMLButtonElement>('#save')!; saveButton.disabled = true; saveButton.textContent = 'Guardando…';
      const payload = { placa: document.querySelector<HTMLInputElement>('#bus-placa')!.value.trim(), kilometraje: Number(document.querySelector<HTMLInputElement>('#bus-km')!.value), marca: document.querySelector<HTMLInputElement>('#bus-marca')!.value.trim(), modelo: document.querySelector<HTMLInputElement>('#bus-modelo')!.value.trim(), busType: document.querySelector<HTMLSelectElement>('#bus-type')!.value, ...(id ? { isActive: document.querySelector<HTMLInputElement>('#bus-active')!.checked, ...(status.disabled ? {} : { manualStatus: status.value }) } : {}) };
      try { feedback.loading('Guardando unidad…'); const saved = await api(id ? `/buses/${id}` : '/buses', { method: id ? 'PATCH' : 'POST', body: JSON.stringify(payload) }); const photo = input.files?.[0]; if (photo) { const data = new FormData(); data.append('photo', photo); await api(`/buses/${id || saved.id}/photo`, { method: 'POST', body: data }); } Swal.close(); await feedback.success(photo ? 'Unidad y foto guardadas.' : 'La unidad fue guardada.'); document.dispatchEvent(new CustomEvent('buses:changed')); } catch (error) { Swal.close(); await feedback.error(error instanceof Error ? error.message : 'Error inesperado.', 'No se pudo guardar'); } finally { saveButton.disabled = false; saveButton.textContent = 'Guardar'; }
    }, true);
  };
  const decorateBusPhotos = async () => { try { const result = await api('/buses'); const buses = result.data ?? []; const paint = () => document.querySelectorAll<HTMLElement>('.bus-card').forEach((card, index) => { const url = buses[index]?.photoUrl; if (!url || card.querySelector('.bus-photo-avatar')) return; const image = document.createElement('img'); image.className = 'bus-photo-avatar absolute inset-[.65rem] z-[1] h-[4.5rem] w-[4.5rem] rounded-[.9rem] object-cover opacity-90'; image.src = url; image.alt = `Foto del bus ${buses[index].placa}`; card.querySelector('.bus-visual-stage')?.prepend(image); }); new MutationObserver(paint).observe(document.querySelector('#bus-grid')!, { childList: true }); paint(); } catch { /* La foto es decorativa; no bloquea la flota. */ } };
  document.addEventListener('astro:page-load', () => { setupBusPhoto(); decorateBusPhotos(); }); setupBusPhoto(); decorateBusPhotos();
</script>
<script>
  import { api } from '../../lib/api';
  import { feedback, Swal } from '../../lib/feedback';
  import { busStatusClass, busStatusLabel } from '../../lib/trip-labels';

   type DriverSummary = { id: number; codigo?: string | null; nombres: string; username: string; photoUrl?: string | null };
   type Assignment = { id: number; tripId: number; assignedAt: string; trip: { id: number; code: string; status: string }; driver: { id: number; nombres: string; username: string } };
    type Bus = { id: number; placa: string; kilometraje: number; modelo: string; marca: string; photoUrl?: string | null; busType: 'DOBLE_PISO' | 'NORMAL'; isActive: boolean; status: string; manualStatus?: string | null; currentAssignment: Assignment | null; defaultDrivers: DriverSummary[] };
   type PhotoForm = HTMLFormElement & { photoPicker?: { setCurrent: (url?: string) => void } };
  const MODEL_VIEWER_SRC = 'https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js';

  const ensureModelViewer = () => { if (customElements.get('model-viewer') || document.querySelector('script[data-model-viewer-loader="true"]')) return; const script = document.createElement('script'); script.type = 'module'; script.src = MODEL_VIEWER_SRC; script.dataset.modelViewerLoader = 'true'; script.onerror = () => document.documentElement.dataset.modelViewerUnavailable = 'true'; document.head.append(script); };
   const svgIcon = (paths: string[], attrs: Record<string, string> = {}) => { const icon = document.createElementNS('http://www.w3.org/2000/svg', 'svg'); icon.setAttribute('viewBox', '0 0 24 24'); icon.setAttribute('aria-hidden', 'true'); icon.setAttribute('fill', 'none'); icon.setAttribute('stroke', 'currentColor'); icon.setAttribute('stroke-width', '1.7'); icon.setAttribute('stroke-linecap', 'round'); icon.setAttribute('stroke-linejoin', 'round'); for (const attr in attrs) icon.setAttribute(attr, attrs[attr]); paths.forEach(d => { const path = document.createElementNS('http://www.w3.org/2000/svg', 'path'); path.setAttribute('d', d); icon.append(path); }); return icon; };
   const makeWrenchIcon = () => svgIcon(['M14.7 6.3a4 4 0 0 0-5.4 5.4l-6.1 6.1a1.5 1.5 0 0 0 2.1 2.1l6.1-6.1a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.4-.4-2.4 2.3-2.4Z']);
   const makeDocIcon = () => svgIcon(['M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z', 'M14 3v5h5', 'M9 13h6', 'M9 17h6', 'M9 9h2']);
   const makePencilIcon = () => svgIcon(['m12 20 9-9-3.5-3.5-9 9V20h3.5Z', 'm14.5 6.5 3 3']);
   const makeTrashIcon = () => svgIcon(['M4 7h16', 'M10 11v6M8 7l1 13h6l1-13', 'M9 7V4h6v3']);
   const makeActionLabel = (text: string) => { const label = document.createElement('span'); label.className = 'sr-only'; label.textContent = text; return label; };
  const makeModelStage = () => { const stage = document.createElement('div'); stage.className = 'bus-visual-stage relative h-[9.2rem] overflow-hidden border-b border-[rgba(234,239,226,.08)] bg-[radial-gradient(circle_at_50%_40%,rgba(72,228,224,.12),transparent_70%)]'; const model = document.createElement('model-viewer'); model.className = 'bus-model block h-full w-full'; model.setAttribute('src', '/buses/gafas_home.glb'); model.setAttribute('camera-controls', ''); model.setAttribute('auto-rotate', ''); model.setAttribute('interaction-prompt', 'none'); model.setAttribute('loading', 'lazy'); model.setAttribute('alt', 'Modelo 3D de un autobús de la flota'); model.setAttribute('shadow-intensity', '0.8'); model.setAttribute('exposure', '1.05'); const fallback = document.createElement('div'); fallback.className = 'model-fallback absolute inset-0 grid place-content-center justify-items-center gap-2 text-[var(--muted)] pointer-events-none'; fallback.setAttribute('aria-hidden', 'true'); const mark = document.createElement('span'); mark.className = 'model-fallback-mark grid h-12 w-12 place-items-center rounded-[1rem] border border-[rgba(72,228,224,.3)] font-display text-base font-semibold text-[var(--cyan)]'; mark.textContent = '3D'; const copy = document.createElement('span'); copy.className = 'model-fallback-copy text-[.65rem] uppercase tracking-[.12em]'; copy.textContent = 'Visor de unidad'; fallback.append(mark, copy); stage.append(model, fallback); return stage; };

  function initBuses() {
    const grid = document.querySelector<HTMLElement>('#bus-grid'); if (!grid || grid.dataset.ready === 'true') return; grid.dataset.ready = 'true'; ensureModelViewer();
     const $ = <T extends Element>(selector: string) => document.querySelector<T>(selector)!; const state = $('#state'); const modal = $('#modal') as HTMLElement; const form = $('#bus-form') as HTMLFormElement; const save = $('#save') as HTMLButtonElement; const statusField = $('#status-field') as HTMLElement; const actions = form.querySelector<HTMLElement>('.form-actions'); if (actions) { const body = document.createElement('div'); body.className = 'modal-form-scroll'; Array.from(form.children).filter((child) => child !== actions).forEach((child) => body.append(child)); form.append(body); modal.querySelector('.modal-card')?.append(actions); save.setAttribute('form', 'bus-form'); } let buses: Bus[] = [];
    const render = () => { const query = ($('#search') as HTMLInputElement).value.trim().toLowerCase(); const list = buses.filter(bus => `${bus.placa} ${bus.marca} ${bus.modelo}`.toLowerCase().includes(query)); grid.replaceChildren(); if (!list.length) { state.textContent = buses.length ? 'No hay unidades que coincidan con la búsqueda.' : 'Aún no hay buses registrados.'; state.className = 'state'; return; } state.textContent = ''; list.forEach(bus => {
      const card = document.createElement('article'); card.className = 'bus-card group relative grid min-h-[220px] overflow-hidden rounded-2xl border border-[var(--line)] bg-[linear-gradient(145deg,#162329,#0d1519)] transition-[transform,border-color,box-shadow] duration-200 hover:-translate-y-1 hover:border-[rgba(245,173,75,.35)] hover:shadow-[0_18px_36px_rgba(0,0,0,.25)] motion-reduce:transition-none motion-reduce:hover:translate-y-0'; card.setAttribute('aria-label', `Unidad ${bus.placa}, estado ${busStatusLabel(bus.status)}`); card.append(makeModelStage());
      const body = document.createElement('div'); body.className = 'flex min-w-0 flex-col p-[1.1rem]'; const heading = document.createElement('div'); heading.className = 'flex min-w-0 items-center justify-between gap-2'; const title = document.createElement('h3'); title.className = 'm-0 font-display text-[1.45rem] leading-none tracking-[-.045em] text-[var(--ink)]'; title.textContent = bus.placa; const type = document.createElement('span'); type.className = 'flex-none rounded-full border border-[rgba(245,173,75,.18)] bg-[rgba(245,173,75,.1)] px-2 py-[.28rem] text-[.6rem] font-extrabold tracking-[.03em] text-[var(--amber)]'; type.textContent = bus.busType === 'DOBLE_PISO' ? 'Doble piso' : 'Normal'; heading.append(title, type);
      const status = document.createElement('span'); status.className = `status-pill mt-[.8rem] self-start px-[.6rem] py-[.35rem] ${busStatusClass(bus.status)}`; status.textContent = busStatusLabel(bus.status); body.append(heading, status); const model = document.createElement('p'); model.className = 'mt-[.35rem] mb-0 truncate whitespace-nowrap text-[.76rem] text-[var(--muted)]'; model.textContent = `${bus.marca} · ${bus.modelo}`; body.append(model);
       const assignment = document.createElement('div'); assignment.className = 'mt-[.8rem] grid gap-[.35rem] rounded-[.75rem] border border-[rgba(234,239,226,.09)] bg-[rgba(5,11,14,.28)] p-[.7rem_.75rem]'; const defaultLabel = document.createElement('span'); defaultLabel.className = 'text-[.57rem] font-bold uppercase tracking-[.12em] text-[var(--subtle)]'; defaultLabel.textContent = 'Conductores asignados'; assignment.append(defaultLabel); const defaultDrivers = document.createElement('div'); defaultDrivers.className = 'flex flex-wrap gap-[.3rem]'; if (bus.defaultDrivers.length) { bus.defaultDrivers.forEach((assignedDriver) => { const driver = document.createElement('span'); driver.className = 'max-w-full overflow-hidden text-ellipsis whitespace-nowrap rounded-[.45rem] border border-[rgba(72,228,224,.16)] bg-[rgba(72,228,224,.06)] px-[.4rem] py-[.25rem] text-[.68rem] text-[var(--ink)]'; driver.textContent = `${assignedDriver.codigo ?? 'Sin código'} · ${assignedDriver.nombres || `@${assignedDriver.username}`}`; driver.title = `@${assignedDriver.username}`; defaultDrivers.append(driver); }); } else { const empty = document.createElement('span'); empty.className = 'text-[.72rem] text-[var(--muted)]'; empty.textContent = 'Sin conductor asignado'; defaultDrivers.append(empty); } assignment.append(defaultDrivers); if (bus.currentAssignment) { const currentLabel = document.createElement('span'); currentLabel.className = 'text-[.57rem] font-bold uppercase tracking-[.12em] text-[var(--amber)]'; currentLabel.textContent = 'En operación'; const currentDriver = document.createElement('strong'); currentDriver.textContent = `${bus.currentAssignment.driver.nombres} · @${bus.currentAssignment.driver.username}`; const trip = document.createElement('small'); trip.textContent = `${bus.currentAssignment.trip.code} · ${busStatusLabel(bus.currentAssignment.trip.status)}`; assignment.append(currentLabel, currentDriver, trip); } body.append(assignment);
      const stats = document.createElement('div'); stats.className = 'mt-[.95rem] flex items-baseline justify-between gap-[.6rem] border-t border-[rgba(234,239,226,.09)] pt-[.7rem]'; const kmLabel = document.createElement('span'); kmLabel.className = 'text-[.61rem] font-bold uppercase tracking-[.12em] text-[var(--subtle)]'; kmLabel.textContent = 'Kilometraje'; const km = document.createElement('strong'); km.className = 'm-0 p-0 text-[.78rem] font-extrabold text-[var(--cyan)]'; km.textContent = `${bus.kilometraje.toLocaleString('es-ES')} km`; stats.append(kmLabel, km); body.append(stats);
       const actions = document.createElement('div'); actions.className = 'bus-actions mt-auto grid grid-cols-2 gap-[.4rem] pt-[.85rem]'; const iconBtnClass = 'inline-flex min-h-10 min-w-0 items-center justify-center gap-[.35rem] overflow-hidden whitespace-nowrap rounded-[.55rem] border px-[.55rem] py-[.42rem] text-[.72rem] font-extrabold no-underline transition-[color,background,border-color,transform] duration-200 hover:-translate-y-px motion-reduce:transition-none'; const labelClass = 'bus-action-label hidden sm:inline';

      const ficha = document.createElement('a'); ficha.className = `${iconBtnClass} col-span-2 border-[rgba(245,173,75,.3)] bg-[rgba(245,173,75,.08)] text-[var(--amber)] hover:border-[rgba(245,173,75,.5)] hover:bg-[rgba(245,173,75,.14)]`; ficha.href = `/admin/buses/detail?id=${encodeURIComponent(bus.id)}`; ficha.dataset.spaLink = ''; ficha.setAttribute('aria-label', `Ver ficha de ${bus.placa}`); ficha.title = 'Ver ficha del bus'; const fichaIcon = makeDocIcon(); fichaIcon.classList.add('h-[1rem]', 'w-[1rem]', 'flex-none'); ficha.append(fichaIcon); const fichaLabel = document.createElement('span'); fichaLabel.className = labelClass; fichaLabel.textContent = 'Ver ficha'; ficha.append(fichaLabel);

      const maintenance = document.createElement('a'); maintenance.className = `${iconBtnClass} border-[rgba(72,228,224,.25)] bg-[rgba(72,228,224,.08)] text-[var(--cyan)] hover:border-[rgba(72,228,224,.45)] hover:bg-[rgba(72,228,224,.14)]`; maintenance.href = `/admin/buses/mantenimiento?id=${encodeURIComponent(bus.id)}`; maintenance.dataset.spaLink = ''; maintenance.setAttribute('aria-label', `Registrar mantenimiento de ${bus.placa}`); maintenance.title = 'Registrar mantenimiento'; const wrenchIcon = makeWrenchIcon(); wrenchIcon.classList.add('h-[1rem]', 'w-[1rem]', 'flex-none'); maintenance.append(wrenchIcon); const maintenanceText = document.createElement('span'); maintenanceText.className = labelClass; maintenanceText.textContent = 'Mantenimiento'; maintenance.append(maintenanceText);

      const edit = document.createElement('button'); edit.className = `${iconBtnClass} border-[rgba(234,239,226,.18)] bg-[rgba(234,239,226,.04)] text-[var(--ink)] hover:border-[rgba(234,239,226,.35)] hover:bg-[rgba(234,239,226,.08)] cursor-pointer`; edit.type = 'button'; edit.dataset.edit = String(bus.id); edit.setAttribute('aria-label', `Editar bus ${bus.placa}`); edit.title = 'Editar bus'; const pencilIcon = makePencilIcon(); pencilIcon.classList.add('h-[1rem]', 'w-[1rem]', 'flex-none'); edit.append(pencilIcon); const editText = document.createElement('span'); editText.className = labelClass; editText.textContent = 'Editar'; edit.append(editText);

      const remove = document.createElement('button'); remove.className = `${iconBtnClass} border-[rgba(245,99,99,.3)] bg-[rgba(245,99,99,.06)] text-[rgba(245,140,140,.95)] hover:border-[rgba(245,99,99,.55)] hover:bg-[rgba(245,99,99,.14)] cursor-pointer`; remove.type = 'button'; remove.dataset.delete = String(bus.id); remove.setAttribute('aria-label', `Eliminar bus ${bus.placa}`); remove.title = 'Eliminar bus'; const trashIcon = makeTrashIcon(); trashIcon.classList.add('h-[1rem]', 'w-[1rem]', 'flex-none'); remove.append(trashIcon); const removeText = document.createElement('span'); removeText.className = labelClass; removeText.textContent = 'Eliminar'; remove.append(removeText);

      actions.append(ficha, maintenance, edit, remove); body.append(actions); card.append(body); grid.append(card);
    }); };
    const makeSkeletonCard = () => { const card = document.createElement('article'); card.className = 'skeleton-card relative grid min-h-[220px] content-start gap-[.6rem] overflow-hidden rounded-2xl border border-[var(--line)] bg-[linear-gradient(145deg,#162329,#0d1519)] p-[1.1rem]'; card.setAttribute('aria-hidden', 'true'); card.innerHTML = '<span class="skeleton skeleton-line h-[1.45rem] w-[62%]"></span><span class="skeleton skeleton-line w-[38%]"></span><span class="skeleton skeleton-line w-[85%]"></span><span class="skeleton skeleton-line w-[72%]"></span><span class="skeleton skeleton-line w-[50%]"></span>'; return card; };
    const showSkeletons = (count = 6) => grid.replaceChildren(...Array.from({ length: count }, makeSkeletonCard));
    const load = async () => { state.textContent = 'Actualizando flota…'; showSkeletons(); try { const result = await api('/buses'); buses = result.data ?? []; render(); } catch (cause) { state.textContent = 'No pudimos cargar la flota. Intenta actualizar.'; state.className = 'state error-state'; grid.replaceChildren(); await feedback.error(cause instanceof Error ? cause.message : 'Error inesperado.', 'Error al cargar los buses'); } };
    let lastFocused: HTMLElement | null = null; let closeTimer: number | undefined; let closeFinish: ((event?: TransitionEvent) => void) | null = null; let transitionVersion = 0;
     const updateActiveToggle = () => { const active = $('#bus-active') as HTMLInputElement; active.setAttribute('aria-checked', String(active.checked)); const state = active.closest('.active-toggle')?.querySelector<HTMLElement>('[data-switch-state]'); if (state) state.textContent = active.checked ? 'Activa' : 'Inactiva'; };
      const open = (bus?: Bus) => { if (closeTimer !== undefined) window.clearTimeout(closeTimer); if (closeFinish) modal.removeEventListener('transitionend', closeFinish); const version = ++transitionVersion; lastFocused = document.activeElement as HTMLElement; modal.classList.remove('is-closing'); modal.hidden = false; modal.setAttribute('aria-hidden', 'false'); requestAnimationFrame(() => { if (!modal.hidden && version === transitionVersion) modal.classList.add('is-open'); }); $('#modal-title').textContent = bus ? 'Editar bus' : 'Nuevo bus'; statusField.hidden = !bus; ($('#bus-id') as HTMLInputElement).value = bus ? String(bus.id) : ''; ($('#bus-placa') as HTMLInputElement).value = bus?.placa ?? ''; ($('#bus-km') as HTMLInputElement).value = bus ? String(bus.kilometraje) : ''; ($('#bus-marca') as HTMLInputElement).value = bus?.marca ?? ''; ($('#bus-modelo') as HTMLInputElement).value = bus?.modelo ?? ''; ($('#bus-type') as HTMLSelectElement).value = bus?.busType ?? 'NORMAL'; ($('#bus-status') as HTMLSelectElement).value = bus?.manualStatus ?? (bus?.currentAssignment ? bus.currentAssignment.trip.status : 'AVAILABLE'); ($('#bus-status') as HTMLSelectElement).disabled = Boolean(bus?.currentAssignment); ($('#bus-active') as HTMLInputElement).checked = bus?.isActive ?? true; (form as PhotoForm).photoPicker?.setCurrent(bus?.photoUrl ?? ''); updateActiveToggle(); setTimeout(() => ($('#bus-placa') as HTMLInputElement).focus(), 40); };
    const close = () => { if (modal.hidden || modal.classList.contains('is-closing')) return; const version = ++transitionVersion; modal.classList.remove('is-open'); modal.classList.add('is-closing'); const finish = (event?: TransitionEvent) => { if (version !== transitionVersion || (event && (event.target !== modal || event.propertyName !== 'opacity'))) return; modal.removeEventListener('transitionend', finish); modal.classList.remove('is-open', 'is-closing'); modal.hidden = true; modal.setAttribute('aria-hidden', 'true'); lastFocused?.focus(); }; closeFinish = finish; modal.addEventListener('transitionend', finish); closeTimer = window.setTimeout(finish, 260); };
     $('#new-bus').addEventListener('click', () => open()); $('#close').addEventListener('click', close); $('#cancel').addEventListener('click', close); $('#search').addEventListener('input', render); ($('#bus-active') as HTMLInputElement).addEventListener('change', updateActiveToggle); modal.addEventListener('click', event => { if (event.target === modal) close(); }); document.addEventListener('keydown', event => { if (event.key === 'Escape' && !modal.hidden) close(); }); document.addEventListener('buses:changed', () => { close(); form.reset(); ($('#bus-id') as HTMLInputElement).value = ''; void load(); });
    grid.addEventListener('click', async event => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button'); if (!button) return; const id = Number(button.dataset.edit ?? button.dataset.delete); const bus = buses.find(item => item.id === id); if (!bus) return; if (button.dataset.edit) return open(bus); if (bus.defaultDrivers?.length) { await feedback.error('Este bus tiene choferes asignados. Desasócialos antes de eliminarlo.', 'No se puede eliminar'); return; } const answer = await feedback.confirm(`Se eliminará la unidad ${bus.placa} de forma permanente.`, '¿Eliminar bus?'); if (!answer.isConfirmed) return; try { feedback.loading('Eliminando bus…'); await api(`/buses/${id}`, { method: 'DELETE' }); Swal.close(); await feedback.success('La unidad fue eliminada.'); await load(); } catch (cause) { Swal.close(); await feedback.error(cause instanceof Error ? cause.message : 'Error inesperado.', 'No se pudo eliminar'); } });
    void load();
  }
  document.addEventListener('astro:page-load', initBuses); initBuses();
</script>
