---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Buses · flotaBus" active="buses">
  <div class="buses-page">
    <section class="page-header buses-hero fade-in"><div><div class="eyebrow">FLOTA OPERATIVA · 02</div><h1>Unidades <em>en ruta.</em></h1><p>Controla los vehículos que mantienen cada recorrido en movimiento.</p></div></section>
    <section class="glass fleet-card buses-card fade-in" style="animation-delay:.08s"><div class="toolbar"><label class="search-field"><span aria-hidden="true">⌕</span><input id="search" class="input" placeholder="Buscar por placa, marca o modelo…" aria-label="Buscar buses" /></label><button id="new-bus" class="btn btn-primary" type="button">+ Añadir bus</button></div><div id="state" class="state" role="status" aria-live="polite">Cargando flota…</div><div id="bus-grid" class="bus-grid"></div></section>
  </div>
   <div id="modal" class="modal-backdrop" hidden aria-hidden="true"><div class="glass modal-card admin-modal-card modal-bus" role="dialog" aria-modal="true" aria-labelledby="modal-title"><div class="modal-heading"><div><div class="eyebrow">UNIDAD DE FLOTA</div><h2 id="modal-title" class="font-display">Nuevo bus</h2></div><button id="close" class="icon-button" type="button" aria-label="Cerrar">×</button></div><form id="bus-form" class="form-grid"><input id="bus-id" type="hidden" /><label>Placa<input id="bus-placa" class="input" required minlength="2" maxlength="16" /></label><label>Kilometraje<input id="bus-km" class="input" required type="number" min="0" max="2147483647" step="1" /></label><label>Marca<input id="bus-marca" class="input" required maxlength="80" /></label><label>Modelo<input id="bus-modelo" class="input" required maxlength="80" /></label><label class="full">Tipo de bus<select id="bus-type" class="input" required><option value="NORMAL">Normal</option><option value="DOBLE_PISO">Doble piso</option></select></label><label id="status-field" class="full">Estado operativo<select id="bus-status" class="input"><option value="AVAILABLE">Disponible</option><option value="ASSIGNED">Ruta asignada</option><option value="IN_TRANSIT">En ruta</option><option value="MAINTENANCE">En mantenimiento</option><option value="OUT_OF_ROUTE">Fuera de ruta</option><option value="STOPPED">Parada del chofer</option><option value="REFUELING">Tanqueando</option><option value="INCIDENT">Incidencia</option></select><small class="field-help">Un viaje activo conserva la prioridad sobre el estado manual.</small></label><div class="active-toggle full"><input id="bus-active" class="switch-input" type="checkbox" role="switch" aria-checked="true" aria-describedby="bus-active-help" checked /><label class="switch-label" for="bus-active"><span class="switch-track" aria-hidden="true"><span class="switch-thumb"></span></span><span class="switch-copy"><strong>Unidad activa</strong><small id="bus-active-help">Disponible para asignaciones · <span data-switch-state>Activa</span></small></span></label></div><div class="form-actions full"><button id="cancel" class="btn btn-secondary" type="button">Cancelar</button><button id="save" class="btn btn-primary" type="submit">Guardar bus</button></div></form></div></div>
</AdminShell>
<script>
  import { api } from '../../lib/api';
  import { feedback, Swal } from '../../lib/feedback';
  import { setupPhotoPicker } from '../../lib/photo-picker';
  const setupBusPhoto = () => {
    const form = document.querySelector<HTMLFormElement>('#bus-form'); if (!form || form.dataset.photoReady) return; form.dataset.photoReady = 'true';
    const picker = setupPhotoPicker(form, { inputId: 'bus-photo', title: 'Foto del bus' });
    const input = picker!.input;
    form.addEventListener('submit', async (event) => {
      event.stopImmediatePropagation(); event.preventDefault(); const idField = document.querySelector<HTMLInputElement>('#bus-id')!; const id = idField.value; const status = document.querySelector<HTMLSelectElement>('#bus-status')!;
      const payload = { placa: document.querySelector<HTMLInputElement>('#bus-placa')!.value.trim(), kilometraje: Number(document.querySelector<HTMLInputElement>('#bus-km')!.value), marca: document.querySelector<HTMLInputElement>('#bus-marca')!.value.trim(), modelo: document.querySelector<HTMLInputElement>('#bus-modelo')!.value.trim(), busType: document.querySelector<HTMLSelectElement>('#bus-type')!.value, ...(id ? { isActive: document.querySelector<HTMLInputElement>('#bus-active')!.checked, ...(status.disabled ? {} : { manualStatus: status.value }) } : {}) };
      try { feedback.loading('Guardando unidad…'); const saved = await api(id ? `/buses/${id}` : '/buses', { method: id ? 'PATCH' : 'POST', body: JSON.stringify(payload) }); const photo = input.files?.[0]; if (photo) { const data = new FormData(); data.append('photo', photo); await api(`/buses/${id || saved.id}/photo`, { method: 'POST', body: data }); } Swal.close(); await feedback.success(photo ? 'Unidad y foto guardadas.' : 'La unidad fue guardada.'); window.location.reload(); } catch (error) { Swal.close(); await feedback.error(error instanceof Error ? error.message : 'Error inesperado.', 'No se pudo guardar'); }
    }, true);
  };
  const decorateBusPhotos = async () => { try { const result = await api('/buses'); const buses = result.data ?? []; const paint = () => document.querySelectorAll<HTMLElement>('.bus-card').forEach((card, index) => { const url = buses[index]?.photoUrl; if (!url || card.querySelector('.bus-photo-avatar')) return; const image = document.createElement('img'); image.className = 'bus-photo-avatar'; image.src = url; image.alt = `Foto del bus ${buses[index].placa}`; card.querySelector('.bus-visual-stage')?.prepend(image); }); new MutationObserver(paint).observe(document.querySelector('#bus-grid')!, { childList: true }); paint(); } catch { /* La foto es decorativa; no bloquea la flota. */ } };
  document.addEventListener('astro:page-load', () => { setupBusPhoto(); decorateBusPhotos(); }); setupBusPhoto(); decorateBusPhotos();
</script>
<script>
  import { api } from '../../lib/api';
  import { feedback, Swal } from '../../lib/feedback';
  import { busStatusClass, busStatusLabel } from '../../lib/trip-labels';

   type DriverSummary = { id: number; codigo?: string | null; nombres: string; username: string; photoUrl?: string | null };
   type Assignment = { id: number; tripId: number; assignedAt: string; trip: { id: number; code: string; status: string }; driver: { id: number; nombres: string; username: string } };
    type Bus = { id: number; placa: string; kilometraje: number; modelo: string; marca: string; photoUrl?: string | null; busType: 'DOBLE_PISO' | 'NORMAL'; isActive: boolean; status: string; manualStatus?: string | null; currentAssignment: Assignment | null; defaultDrivers: DriverSummary[] };
   type PhotoForm = HTMLFormElement & { photoPicker?: { setCurrent: (url?: string) => void } };
  const MODEL_VIEWER_SRC = 'https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js';

  const ensureModelViewer = () => { if (customElements.get('model-viewer') || document.querySelector('script[data-model-viewer-loader="true"]')) return; const script = document.createElement('script'); script.type = 'module'; script.src = MODEL_VIEWER_SRC; script.dataset.modelViewerLoader = 'true'; script.onerror = () => document.documentElement.dataset.modelViewerUnavailable = 'true'; document.head.append(script); };
   const makeIcon = () => { const icon = document.createElementNS('http://www.w3.org/2000/svg', 'svg'); icon.setAttribute('viewBox', '0 0 24 24'); icon.setAttribute('aria-hidden', 'true'); const path = document.createElementNS('http://www.w3.org/2000/svg', 'path'); path.setAttribute('d', 'm14.7 6.3 3 3M5 19l5.6-5.6m-1.3-2.1 5.8-5.8a3.1 3.1 0 0 1 4.4 4.4l-5.8 5.8m-4.4-2.3-2.2-2.2'); icon.append(path); return icon; };
   const makeDeleteIcon = () => { const icon = document.createElementNS('http://www.w3.org/2000/svg', 'svg'); icon.setAttribute('viewBox', '0 0 24 24'); icon.setAttribute('aria-hidden', 'true'); const path = document.createElementNS('http://www.w3.org/2000/svg', 'path'); path.setAttribute('d', 'M4 7h16m-10 4v6m4-6v6M9 7V4h6v3m-9 0 1 13h8l1-13'); icon.append(path); return icon; };
   const makeActionLabel = (text: string) => { const label = document.createElement('span'); label.className = 'sr-only'; label.textContent = text; return label; };
  const makeModelStage = () => { const stage = document.createElement('div'); stage.className = 'bus-visual-stage'; const model = document.createElement('model-viewer'); model.className = 'bus-model'; model.setAttribute('src', '/buses/gafas_home.glb'); model.setAttribute('camera-controls', ''); model.setAttribute('auto-rotate', ''); model.setAttribute('interaction-prompt', 'none'); model.setAttribute('loading', 'lazy'); model.setAttribute('alt', 'Modelo 3D de un autobús de la flota'); model.setAttribute('shadow-intensity', '0.8'); model.setAttribute('exposure', '1.05'); const fallback = document.createElement('div'); fallback.className = 'model-fallback'; fallback.setAttribute('aria-hidden', 'true'); const mark = document.createElement('span'); mark.className = 'model-fallback-mark'; mark.textContent = '3D'; const copy = document.createElement('span'); copy.className = 'model-fallback-copy'; copy.textContent = 'Visor de unidad'; fallback.append(mark, copy); stage.append(model, fallback); return stage; };

  function initBuses() {
    const grid = document.querySelector<HTMLElement>('#bus-grid'); if (!grid || grid.dataset.ready === 'true') return; grid.dataset.ready = 'true'; ensureModelViewer();
    const $ = <T extends Element>(selector: string) => document.querySelector<T>(selector)!; const state = $('#state'); const modal = $('#modal') as HTMLElement; const form = $('#bus-form') as HTMLFormElement; const save = $('#save') as HTMLButtonElement; const statusField = $('#status-field') as HTMLElement; const actions = form.querySelector<HTMLElement>('.form-actions'); if (actions) { modal.querySelector('.modal-card')?.append(actions); save.setAttribute('form', 'bus-form'); } let buses: Bus[] = [];
    const render = () => { const query = ($('#search') as HTMLInputElement).value.trim().toLowerCase(); const list = buses.filter(bus => `${bus.placa} ${bus.marca} ${bus.modelo}`.toLowerCase().includes(query)); grid.replaceChildren(); if (!list.length) { state.textContent = buses.length ? 'No hay unidades que coincidan con la búsqueda.' : 'Aún no hay buses registrados.'; state.className = 'state'; return; } state.textContent = ''; list.forEach(bus => {
      const card = document.createElement('article'); card.className = 'bus-card'; card.setAttribute('aria-label', `Unidad ${bus.placa}, estado ${busStatusLabel(bus.status)}`); card.append(makeModelStage());
      const body = document.createElement('div'); body.className = 'bus-info'; const heading = document.createElement('div'); heading.className = 'bus-heading'; const title = document.createElement('h3'); title.textContent = bus.placa; const type = document.createElement('span'); type.className = 'bus-type'; type.textContent = bus.busType === 'DOBLE_PISO' ? 'Doble piso' : 'Normal'; heading.append(title, type);
      const status = document.createElement('span'); status.className = `status-pill bus-status ${busStatusClass(bus.status)}`; status.textContent = busStatusLabel(bus.status); body.append(heading, status); const model = document.createElement('p'); model.className = 'bus-model-name'; model.textContent = `${bus.marca} · ${bus.modelo}`; body.append(model);
       const assignment = document.createElement('div'); assignment.className = 'bus-assignment'; const defaultLabel = document.createElement('span'); defaultLabel.className = 'bus-stat-label'; defaultLabel.textContent = 'Conductores asignados'; assignment.append(defaultLabel); const defaultDrivers = document.createElement('div'); defaultDrivers.className = 'bus-driver-list'; if (bus.defaultDrivers.length) { bus.defaultDrivers.forEach((assignedDriver) => { const driver = document.createElement('span'); driver.className = 'bus-driver-chip'; driver.textContent = `${assignedDriver.codigo ?? 'Sin código'} · ${assignedDriver.nombres || `@${assignedDriver.username}`}`; driver.title = `@${assignedDriver.username}`; defaultDrivers.append(driver); }); } else { const empty = document.createElement('span'); empty.className = 'bus-assignment-empty'; empty.textContent = 'Sin conductor asignado'; defaultDrivers.append(empty); } assignment.append(defaultDrivers); if (bus.currentAssignment) { const currentLabel = document.createElement('span'); currentLabel.className = 'bus-stat-label bus-operation-label'; currentLabel.textContent = 'En operación'; const currentDriver = document.createElement('strong'); currentDriver.textContent = `${bus.currentAssignment.driver.nombres} · @${bus.currentAssignment.driver.username}`; const trip = document.createElement('small'); trip.textContent = `${bus.currentAssignment.trip.code} · ${busStatusLabel(bus.currentAssignment.trip.status)}`; assignment.append(currentLabel, currentDriver, trip); } body.append(assignment);
      const stats = document.createElement('div'); stats.className = 'bus-stats'; const kmLabel = document.createElement('span'); kmLabel.className = 'bus-stat-label'; kmLabel.textContent = 'Kilometraje'; const km = document.createElement('strong'); km.className = 'bus-km'; km.textContent = `${bus.kilometraje.toLocaleString('es-ES')} km`; stats.append(kmLabel, km); body.append(stats);
       const actions = document.createElement('div'); actions.className = 'card-actions'; const maintenance = document.createElement('a'); maintenance.className = 'maintenance-link'; maintenance.href = `/admin/buses/mantenimiento?id=${encodeURIComponent(bus.id)}`; maintenance.dataset.spaLink = ''; maintenance.setAttribute('aria-label', `Registrar mantenimiento de ${bus.placa}`); maintenance.title = 'Registrar mantenimiento'; maintenance.append(makeIcon()); const maintenanceText = document.createElement('span'); maintenanceText.textContent = 'Mantenimiento'; maintenance.append(maintenanceText); const edit = document.createElement('button'); edit.className = 'link-button action-icon'; edit.type = 'button'; edit.dataset.edit = String(bus.id); edit.setAttribute('aria-label', `Editar bus ${bus.placa}`); edit.title = 'Editar bus'; edit.append(makeIcon(), makeActionLabel('Editar')); const remove = document.createElement('button'); remove.className = 'danger-link action-icon'; remove.type = 'button'; remove.dataset.delete = String(bus.id); remove.setAttribute('aria-label', `Eliminar bus ${bus.placa}`); remove.title = 'Eliminar bus'; remove.append(makeDeleteIcon(), makeActionLabel('Eliminar')); actions.append(maintenance, edit, remove); body.append(actions); card.append(body); grid.append(card);
    }); };
    const load = async () => { state.textContent = 'Actualizando flota…'; try { const result = await api('/buses'); buses = result.data ?? []; render(); } catch (cause) { state.textContent = 'No pudimos cargar la flota. Intenta actualizar.'; state.className = 'state error-state'; await feedback.error(cause instanceof Error ? cause.message : 'Error inesperado.', 'Error al cargar los buses'); } };
    let lastFocused: HTMLElement | null = null; let closeTimer: number | undefined; let closeFinish: ((event?: TransitionEvent) => void) | null = null; let transitionVersion = 0;
     const updateActiveToggle = () => { const active = $('#bus-active') as HTMLInputElement; active.setAttribute('aria-checked', String(active.checked)); const state = active.closest('.active-toggle')?.querySelector<HTMLElement>('[data-switch-state]'); if (state) state.textContent = active.checked ? 'Activa' : 'Inactiva'; };
      const open = (bus?: Bus) => { if (closeTimer !== undefined) window.clearTimeout(closeTimer); if (closeFinish) modal.removeEventListener('transitionend', closeFinish); const version = ++transitionVersion; lastFocused = document.activeElement as HTMLElement; modal.classList.remove('is-closing'); modal.hidden = false; modal.setAttribute('aria-hidden', 'false'); requestAnimationFrame(() => { if (!modal.hidden && version === transitionVersion) modal.classList.add('is-open'); }); $('#modal-title').textContent = bus ? 'Editar bus' : 'Nuevo bus'; statusField.hidden = !bus; ($('#bus-id') as HTMLInputElement).value = bus ? String(bus.id) : ''; ($('#bus-placa') as HTMLInputElement).value = bus?.placa ?? ''; ($('#bus-km') as HTMLInputElement).value = bus ? String(bus.kilometraje) : ''; ($('#bus-marca') as HTMLInputElement).value = bus?.marca ?? ''; ($('#bus-modelo') as HTMLInputElement).value = bus?.modelo ?? ''; ($('#bus-type') as HTMLSelectElement).value = bus?.busType ?? 'NORMAL'; ($('#bus-status') as HTMLSelectElement).value = bus?.manualStatus ?? (bus?.currentAssignment ? bus.currentAssignment.trip.status : 'AVAILABLE'); ($('#bus-status') as HTMLSelectElement).disabled = Boolean(bus?.currentAssignment); ($('#bus-active') as HTMLInputElement).checked = bus?.isActive ?? true; (form as PhotoForm).photoPicker?.setCurrent(bus?.photoUrl ?? ''); updateActiveToggle(); setTimeout(() => ($('#bus-placa') as HTMLInputElement).focus(), 40); };
    const close = () => { if (modal.hidden || modal.classList.contains('is-closing')) return; const version = ++transitionVersion; modal.classList.remove('is-open'); modal.classList.add('is-closing'); const finish = (event?: TransitionEvent) => { if (version !== transitionVersion || (event && (event.target !== modal || event.propertyName !== 'opacity'))) return; modal.removeEventListener('transitionend', finish); modal.classList.remove('is-open', 'is-closing'); modal.hidden = true; modal.setAttribute('aria-hidden', 'true'); lastFocused?.focus(); }; closeFinish = finish; modal.addEventListener('transitionend', finish); closeTimer = window.setTimeout(finish, 260); };
     $('#new-bus').addEventListener('click', () => open()); $('#close').addEventListener('click', close); $('#cancel').addEventListener('click', close); $('#search').addEventListener('input', render); ($('#bus-active') as HTMLInputElement).addEventListener('change', updateActiveToggle); modal.addEventListener('click', event => { if (event.target === modal) close(); }); document.addEventListener('keydown', event => { if (event.key === 'Escape' && !modal.hidden) close(); });
    grid.addEventListener('click', async event => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button'); if (!button) return; const id = Number(button.dataset.edit ?? button.dataset.delete); const bus = buses.find(item => item.id === id); if (!bus) return; if (button.dataset.edit) return open(bus); const answer = await feedback.confirm(`Se eliminará la unidad ${bus.placa} de forma permanente.`, '¿Eliminar bus?'); if (!answer.isConfirmed) return; try { feedback.loading('Eliminando bus…'); await api(`/buses/${id}`, { method: 'DELETE' }); Swal.close(); await feedback.success('La unidad fue eliminada.'); await load(); } catch (cause) { Swal.close(); await feedback.error(cause instanceof Error ? cause.message : 'Error inesperado.', 'No se pudo eliminar'); } });
    form.addEventListener('submit', async event => { event.preventDefault(); save.disabled = true; save.textContent = 'Guardando…'; const id = ($('#bus-id') as HTMLInputElement).value; const statusSelect = $('#bus-status') as HTMLSelectElement; const payload = { placa: ($('#bus-placa') as HTMLInputElement).value.trim(), kilometraje: Number(($('#bus-km') as HTMLInputElement).value), marca: ($('#bus-marca') as HTMLInputElement).value.trim(), modelo: ($('#bus-modelo') as HTMLInputElement).value.trim(), busType: ($('#bus-type') as HTMLSelectElement).value, ...(id ? { isActive: ($('#bus-active') as HTMLInputElement).checked, ...(statusSelect.disabled ? {} : { manualStatus: statusSelect.value }) } : {}) }; try { feedback.loading('Guardando unidad…'); await api(id ? `/buses/${id}` : '/buses', { method: id ? 'PATCH' : 'POST', body: JSON.stringify(payload) }); Swal.close(); close(); await feedback.success(id ? 'Los cambios fueron guardados.' : 'El bus fue añadido.'); await load(); } catch (cause) { Swal.close(); await feedback.error(cause instanceof Error ? cause.message : 'Error inesperado.', id ? 'No se pudo actualizar' : 'No se pudo crear'); } finally { save.disabled = false; save.textContent = 'Guardar bus'; } }); load();
  }
  document.addEventListener('astro:page-load', initBuses); initBuses();
</script>
