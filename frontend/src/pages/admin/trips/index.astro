---
import AdminShell from '../../../components/AdminShell.astro';
---

<AdminShell title="Viajes · flotaBus" active="trips">
  <div class="drivers-page">
    <section class="page-header drivers-hero fade-in">
      <div><div class="eyebrow">OPERACIÓN · VIAJES COMPLETOS</div><h1>Rutas <em>en control.</em></h1><p>Planifica trayectos, asigna unidad y sigue eventos operativos.</p></div>
    </section>
    <section class="glass fleet-card drivers-table-card fade-in" style="animation-delay:.08s">
      <div class="toolbar">
        <label class="search-field"><span aria-hidden="true">⌕</span><input id="trip-search" class="input" placeholder="Buscar por código, ruta u observaciones…" aria-label="Buscar viajes" /></label>
        <div class="trip-toolbar-actions"><select id="trip-filter" class="input" aria-label="Filtrar viajes por estado"><option value="">Todos los estados</option></select><button id="new-trip" class="btn btn-primary" type="button">+ Añadir viaje</button></div>
      </div>
       <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Viaje</th><th>Salida</th><th>Ruta</th><th>Estado</th><th class="table-actions">Acciones</th></tr></thead><tbody id="trip-state-body"><tr><td class="table-state" colspan="5"><div id="trip-state" class="state" role="status" aria-live="polite">Cargando viajes…</div></td></tr></tbody><tbody id="trip-list" hidden></tbody></table></div>
    </section>
  </div>

  <div id="trip-modal" class="modal-backdrop" hidden aria-hidden="true">
    <div class="glass modal-card admin-modal-card trip-modal-card" role="dialog" aria-modal="true" aria-labelledby="trip-modal-title">
      <div class="modal-heading"><div><div class="eyebrow">PLANIFICACIÓN DE VIAJE</div><h2 id="trip-modal-title" class="font-display">Nuevo viaje</h2><p class="modal-subtitle">Configura la ruta, sus trayectos y los recursos asignados.</p></div><button id="trip-close" class="icon-button" type="button" aria-label="Cerrar">×</button></div>
      <nav class="trip-stepper" aria-label="Progreso del formulario">
        <button class="trip-step is-active" type="button" data-step="0"><span>01</span><strong>Información</strong><small>Datos del viaje</small></button>
        <span class="trip-step-line" aria-hidden="true"></span>
        <button class="trip-step" type="button" data-step="1"><span>02</span><strong>Trayectos</strong><small>Ruta y tiempos</small></button>
        <span class="trip-step-line" aria-hidden="true"></span>
        <button class="trip-step" type="button" data-step="2"><span>03</span><strong>Asignación</strong><small>Revisión final</small></button>
      </nav>
      <form id="trip-form" class="trip-form">
        <input type="hidden" id="trip-id" />
        <div class="trip-form-scroll">
          <section class="trip-step-panel is-visible" data-panel="0" aria-labelledby="trip-general-title">
            <div class="trip-form-section"><div class="trip-section-title"><span class="section-index">01</span><div><h3 id="trip-general-title">Información del viaje</h3><p>Identifica el viaje y define su salida.</p></div></div>
              <div class="trip-form-grid"><label class="form-label">Código<input id="trip-code" class="input mt-2" required placeholder="V-2026-001" /></label><label class="form-label">Origen / base<input id="trip-origin" class="input mt-2" value="Bucaramanga" required /></label><label class="form-label">Fecha y hora de salida inicial<input id="trip-start" class="input mt-2" required type="datetime-local" /></label><label class="form-label readonly-field">Zona operativa<input id="trip-timezone" class="input mt-2" value="America/Bogota" disabled aria-describedby="trip-timezone-help" /><small id="trip-timezone-help" class="readonly-help">Definida por la operación del sistema · solo lectura</small></label></div>
            </div>
          </section>
          <section class="trip-step-panel" data-panel="1" aria-labelledby="trip-legs-title" hidden>
            <div class="trip-form-section trip-legs-section"><div class="trip-section-heading"><div class="trip-section-title"><span class="section-index">02</span><div><h3 id="trip-legs-title">Trayectos ordenados</h3><p>Agrega cada tramo en el orden de recorrido.</p></div></div><button id="add-leg" class="btn btn-secondary" type="button">+ Añadir trayecto</button></div><div id="trip-legs"></div><label class="form-label">Observaciones generales<textarea id="trip-notes" class="input mt-2" rows="3" placeholder="Notas para la operación…"></textarea></label></div>
          </section>
          <section class="trip-step-panel" data-panel="2" aria-labelledby="trip-assignment-title" hidden>
            <div class="trip-form-section"><div class="trip-section-title"><span class="section-index">03</span><div><h3 id="trip-assignment-title">Asignación y revisión</h3><p>Confirma los recursos antes de guardar.</p></div></div>
               <div class="trip-form-grid trip-assignment"><label class="form-label">Bus (opcional)<select id="trip-bus" class="input mt-2" aria-describedby="trip-bus-help"><option value="">Sin asignar todavía</option></select><small id="trip-bus-help" class="readonly-help"></small></label><label class="form-label">Chofer (opcional)<select id="trip-driver" class="input mt-2"><option value="">Sin asignar todavía</option></select></label></div>
              <div class="trip-review" aria-live="polite"><div><span>Viaje</span><strong id="review-trip">—</strong></div><div><span>Salida</span><strong id="review-start">—</strong></div><div><span>Ruta</span><strong id="review-route">—</strong></div><div><span>Recursos</span><strong id="review-resources">Sin asignar</strong></div></div>
            </div>
          </section>
        </div>
        <div class="form-actions"><button id="trip-cancel" class="btn btn-secondary" type="button">Cancelar</button><div class="trip-navigation"><button id="trip-back" class="btn btn-secondary" type="button" hidden>Atrás</button><button id="trip-next" class="btn btn-primary" type="button">Continuar</button><button id="trip-save" class="btn btn-primary" type="submit" hidden>Guardar viaje</button></div></div>
      </form>
    </div>
  </div>
</AdminShell>

<script>
  import { api } from '../../../lib/api';
  import { feedback, Swal } from '../../../lib/feedback';
  import { isTripEditable, TRIP_STATUS_OPTIONS, tripStatusClass, tripStatusLabel } from '../../../lib/trip-labels';

  type Leg = { id?: number; origin: string; destination: string; plannedDepartureAt?: string; plannedArrivalAt?: string; durationDays: number; notes?: string };
  type Trip = { id: number; code: string; origin: string; initialStartAt: string; timezone?: string; notes?: string; status: string; legs?: Leg[]; assignments?: Array<{ busId: number; driverId: number }> };
  type Resource = { id: number; placa?: string; marca?: string; modelo?: string; nombres?: string; username?: string; isActive?: boolean };

  const init = () => {
    const list = document.querySelector<HTMLElement>('#trip-list');
    if (!list || list.dataset.ready === 'true') return;
    list.dataset.ready = 'true';
    const $ = <T extends Element>(selector: string) => document.querySelector<T>(selector)!;
     const state = $('#trip-state'); const stateBody = document.querySelector<HTMLElement>('#trip-state-body')!; const filter = $('#trip-filter') as HTMLSelectElement; const search = $('#trip-search') as HTMLInputElement;
    const modal = $('#trip-modal') as HTMLElement; const form = $('#trip-form') as HTMLFormElement; const legs = $('#trip-legs'); const save = $('#trip-save') as HTMLButtonElement;
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.trip-step-panel')); const stepButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.trip-step[data-step]')); let currentStep = 0;
    let trips: Trip[] = []; let buses: Resource[] = []; let drivers: Resource[] = []; let lastFocused: HTMLElement | null = null; let closeTimer: number | undefined; let closeFinish: ((event?: TransitionEvent) => void) | null = null; let transitionVersion = 0;
    filter.insertAdjacentHTML('beforeend', TRIP_STATUS_OPTIONS.map(({ value, label }) => `<option value="${value}">${label}</option>`).join(''));
    const dateInput = (value?: string) => value ? new Date(value).toISOString().slice(0, 16) : '';
    const showError = (cause: unknown, title = 'No se pudo completar la acción') => feedback.error(cause instanceof Error ? cause.message : 'Error inesperado.', title);
    const legTemplate = (leg: Leg = { origin: 'Bucaramanga', destination: '', durationDays: 1, notes: '' }) => { const item = document.createElement('div'); item.className = 'trip-leg-row'; item.innerHTML = `<span class="trip-leg-number">${legs.children.length + 1}</span><div class="trip-leg-fields"><label class="form-label">Origen<input class="input mt-2 leg-origin" required value="${leg.origin}" /></label><label class="form-label">Destino<input class="input mt-2 leg-destination" required value="${leg.destination}" /></label><label class="form-label">Salida inicial<input class="input mt-2 leg-start" required type="datetime-local" value="${dateInput(leg.plannedDepartureAt)}" /></label><label class="form-label">Duración (días)<input class="input mt-2 leg-days" required type="number" min="1" step="1" value="${leg.durationDays}" /></label><label class="form-label trip-full">Observaciones<input class="input mt-2 leg-notes" value="${leg.notes ?? ''}" /></label></div><button class="icon-button remove-leg" type="button" aria-label="Eliminar trayecto">×</button>`; legs.append(item); item.querySelector('.remove-leg')?.addEventListener('click', () => { if (legs.children.length > 1) { item.remove(); Array.from(legs.children).forEach((node, index) => node.querySelector('.trip-leg-number')!.textContent = String(index + 1)); updateReview(); } }); item.addEventListener('input', updateReview); };
     const fillResources = () => { const bus = $('#trip-bus') as HTMLSelectElement; const driver = $('#trip-driver') as HTMLSelectElement; const activeBuses = buses.filter(item => item.isActive === true); bus.innerHTML = '<option value="">Sin asignar todavía</option>' + (activeBuses.length ? activeBuses.map(item => `<option value="${item.id}">${item.placa} · ${item.marca ?? ''} ${item.modelo ?? ''}</option>`).join('') : '<option value="" disabled>No hay buses activos disponibles</option>'); $('#trip-bus-help').textContent = activeBuses.length ? '' : 'No hay buses activos disponibles para asignar.'; driver.innerHTML = '<option value="">Sin asignar todavía</option>' + drivers.filter(item => item.isActive !== false).map(item => `<option value="${item.id}">${item.nombres ?? item.username ?? `Chofer ${item.id}`}</option>`).join(''); };
    const updateReview = () => { const start = ($('#trip-start') as HTMLInputElement).value; const first = legs.querySelector<HTMLInputElement>('.leg-origin')?.value || ($('#trip-origin') as HTMLInputElement).value; const last = Array.from(legs.querySelectorAll<HTMLInputElement>('.leg-destination')).at(-1)?.value || '—'; const bus = ($('#trip-bus') as HTMLSelectElement).selectedOptions[0]?.textContent?.replace('Sin asignar todavía', '').trim(); const driver = ($('#trip-driver') as HTMLSelectElement).selectedOptions[0]?.textContent?.replace('Sin asignar todavía', '').trim(); $('#review-trip').textContent = ($('#trip-code') as HTMLInputElement).value || '—'; $('#review-start').textContent = start ? new Date(start).toLocaleString('es-CO') : '—'; $('#review-route').textContent = `${first || '—'} → ${last}`; $('#review-resources').textContent = bus && driver ? `${bus} · ${driver}` : 'Sin asignar'; };
    const resetForm = () => { form.reset(); ($('#trip-id') as HTMLInputElement).value = ''; ($('#trip-timezone') as HTMLInputElement).value = 'America/Bogota'; legs.replaceChildren(); legTemplate(); fillResources(); goToStep(0); updateReview(); };
    const validateStep = (step: number) => { const fields = Array.from(panels[step].querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[required]')); return fields.every(field => field.reportValidity()); };
    function goToStep(step: number) { currentStep = Math.max(0, Math.min(2, step)); panels.forEach((panel, index) => { const active = index === currentStep; panel.hidden = !active; panel.classList.toggle('is-visible', active); }); stepButtons.forEach((button, index) => { button.classList.toggle('is-active', index === currentStep); button.classList.toggle('is-complete', index < currentStep); button.setAttribute('aria-current', index === currentStep ? 'step' : 'false'); }); ($('#trip-back') as HTMLButtonElement).hidden = currentStep === 0; ($('#trip-next') as HTMLButtonElement).hidden = currentStep === 2; save.hidden = currentStep !== 2; updateReview(); panels[currentStep].querySelector<HTMLElement>('input, select, textarea, button')?.focus({ preventScroll: true }); }
    function open(trip?: Trip) { if (closeTimer !== undefined) { window.clearTimeout(closeTimer); closeTimer = undefined; } if (closeFinish) { modal.removeEventListener('transitionend', closeFinish); closeFinish = null; } const version = ++transitionVersion; lastFocused = document.activeElement as HTMLElement; resetForm(); if (trip) { $('#trip-modal-title').textContent = 'Editar viaje'; ($('#trip-id') as HTMLInputElement).value = String(trip.id); ($('#trip-code') as HTMLInputElement).value = trip.code; ($('#trip-origin') as HTMLInputElement).value = trip.origin; ($('#trip-start') as HTMLInputElement).value = dateInput(trip.initialStartAt); ($('#trip-timezone') as HTMLInputElement).value = trip.timezone ?? 'America/Bogota'; ($('#trip-notes') as HTMLTextAreaElement).value = trip.notes ?? ''; legs.replaceChildren(); (trip.legs?.length ? trip.legs : [{ origin: trip.origin, destination: '', durationDays: 1 }]).forEach(legTemplate); const assignment = trip.assignments?.[0]; if (assignment) { ($('#trip-bus') as HTMLSelectElement).value = String(assignment.busId); ($('#trip-driver') as HTMLSelectElement).value = String(assignment.driverId); } } else { $('#trip-modal-title').textContent = 'Nuevo viaje'; } updateReview(); modal.hidden = false; modal.setAttribute('aria-hidden', 'false'); modal.classList.remove('is-closing'); requestAnimationFrame(() => { if (!modal.hidden && version === transitionVersion) modal.classList.add('is-open'); }); setTimeout(() => ($('#trip-code') as HTMLInputElement).focus(), 40); }
    function close() { if (modal.hidden || modal.classList.contains('is-closing')) return; const version = ++transitionVersion; modal.classList.remove('is-open'); modal.classList.add('is-closing'); const finish = (event?: TransitionEvent) => { if (version !== transitionVersion || (event && (event.target !== modal || event.propertyName !== 'opacity'))) return; modal.removeEventListener('transitionend', finish); closeFinish = null; if (closeTimer !== undefined) window.clearTimeout(closeTimer); modal.classList.remove('is-open', 'is-closing'); modal.hidden = true; modal.setAttribute('aria-hidden', 'true'); lastFocused?.focus(); }; closeFinish = finish; modal.addEventListener('transitionend', finish); closeTimer = window.setTimeout(finish, 260); }
      const render = () => { const query = search.value.trim().toLowerCase(); const filtered = trips.filter(trip => !query || `${trip.code} ${trip.origin} ${trip.notes ?? ''} ${trip.legs?.map(leg => `${leg.origin} ${leg.destination}`).join(' ')}`.toLowerCase().includes(query)); list.innerHTML = filtered.length ? filtered.map(trip => { const first = trip.legs?.[0]; const last = trip.legs?.at(-1); const editAction = isTripEditable(trip.status) ? `<button class="link-button" data-edit="${trip.id}" type="button">Editar</button>` : '<span class="muted" title="Sólo se puede editar un viaje que aún no ha iniciado.">Bloqueado</span>'; return `<tr><td><strong>${trip.code}</strong><small>${trip.notes || 'Sin observaciones'}</small></td><td><strong>${new Date(trip.initialStartAt).toLocaleString('es-CO')}</strong><small>${trip.timezone ?? 'America/Bogota'}</small></td><td>${first?.origin ?? trip.origin} → ${last?.destination ?? '—'}<small>${trip.legs?.length ?? 0} trayectos · llegada ${last ? new Date(last.plannedArrivalAt ?? '').toLocaleDateString('es-CO') : '—'}</small></td><td><span class="status-pill ${tripStatusClass(trip.status)}"><i></i>${tripStatusLabel(trip.status)}</span></td><td class="table-actions">${editAction}<a class="link-button" href="/admin/trips/detail?id=${encodeURIComponent(trip.id)}" data-spa-link>Ver detalle</a></td></tr>`; }).join('') : '<tr><td class="table-state" colspan="5">No hay viajes que coincidan.</td></tr>'; };
      const load = async () => { stateBody.hidden = false; list.hidden = true; state.className = 'state'; state.textContent = 'Actualizando viajes…'; try { const result = await api(`/trips${filter.value ? `?status=${filter.value}` : ''}`); trips = result.data ?? result; state.textContent = trips.length ? '' : 'No hay viajes registrados.'; stateBody.hidden = trips.length > 0; list.hidden = trips.length === 0; render(); } catch (cause) { state.className = 'state error-state'; state.textContent = 'No pudimos cargar los viajes. Intenta actualizar.'; await showError(cause, 'Error al cargar los viajes'); } };
    const loadResources = async () => { try { const [busResult, driverResult] = await Promise.all([api('/buses'), api('/drivers')]); buses = busResult.data ?? busResult; drivers = driverResult.data ?? driverResult; fillResources(); } catch { /* La asignación queda disponible aunque falle la carga de catálogos. */ } };
    $('#new-trip').addEventListener('click', () => open()); $('#trip-close').addEventListener('click', close); $('#trip-cancel').addEventListener('click', close); search.addEventListener('input', render); filter.addEventListener('change', load); modal.addEventListener('click', event => { if (event.target === modal) close(); }); document.addEventListener('keydown', event => { if (event.key === 'Escape' && !modal.hidden) close(); }); $('#add-leg').addEventListener('click', () => { const previousDestination = legs.lastElementChild?.querySelector<HTMLInputElement>('.leg-destination')?.value.trim() || ($('#trip-origin') as HTMLInputElement).value.trim() || 'Bucaramanga'; legTemplate({ origin: previousDestination, destination: '', durationDays: 1, notes: '' }); updateReview(); });
    stepButtons.forEach(button => button.addEventListener('click', () => { const target = Number(button.dataset.step); if (target > currentStep && !validateStep(currentStep)) return; goToStep(target); })); $('#trip-next').addEventListener('click', () => { if (validateStep(currentStep)) goToStep(currentStep + 1); }); $('#trip-back').addEventListener('click', () => goToStep(currentStep - 1)); form.addEventListener('input', updateReview); form.addEventListener('change', updateReview);
    list.addEventListener('click', event => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-edit]'); if (button) { const trip = trips.find(item => item.id === Number(button.dataset.edit)); if (trip) open(trip); } });
    form.addEventListener('submit', async event => { event.preventDefault(); if (!validateStep(0) || !validateStep(1)) return; const id = ($('#trip-id') as HTMLInputElement).value; const busId = Number(($('#trip-bus') as HTMLSelectElement).value); const driverId = Number(($('#trip-driver') as HTMLSelectElement).value); if ((busId && !driverId) || (!busId && driverId)) return showError(new Error('Selecciona bus y chofer para crear la asignación.')); const legPayload = Array.from(legs.children).map(item => ({ origin: (item.querySelector('.leg-origin') as HTMLInputElement).value.trim(), destination: (item.querySelector('.leg-destination') as HTMLInputElement).value.trim(), plannedDepartureAt: new Date((item.querySelector('.leg-start') as HTMLInputElement).value).toISOString(), durationDays: Number((item.querySelector('.leg-days') as HTMLInputElement).value), notes: (item.querySelector('.leg-notes') as HTMLInputElement).value.trim() })); const createPayload = { origin: ($('#trip-origin') as HTMLInputElement).value.trim(), initialStartAt: new Date(($('#trip-start') as HTMLInputElement).value).toISOString(), timezone: ($('#trip-timezone') as HTMLInputElement).value.trim(), notes: ($('#trip-notes') as HTMLTextAreaElement).value.trim() }; const updatePayload = { origin: createPayload.origin, initialStartAt: createPayload.initialStartAt, notes: createPayload.notes }; save.disabled = true; save.textContent = 'Guardando…'; try { feedback.loading(id ? 'Guardando cambios…' : 'Creando viaje…'); const trip = id ? await api(`/trips/${id}`, { method: 'PATCH', body: JSON.stringify(updatePayload) }) : await api('/trips', { method: 'POST', body: JSON.stringify({ code: ($('#trip-code') as HTMLInputElement).value.trim(), ...createPayload, legs: legPayload }) }); if (!id && busId && driverId) await api(`/trips/${trip.id}/assignments`, { method: 'POST', body: JSON.stringify({ busId, driverId }) }); Swal.close(); close(); await feedback.success(id ? 'Los cambios fueron guardados.' : 'El viaje fue añadido.', id ? 'Viaje actualizado' : 'Viaje creado'); await load(); } catch (cause) { Swal.close(); await showError(cause, id ? 'No se pudo actualizar' : 'No se pudo crear'); } finally { save.disabled = false; save.textContent = 'Guardar viaje'; } });
    loadResources(); load();
  };
  document.addEventListener('astro:page-load', init); init();
</script>
