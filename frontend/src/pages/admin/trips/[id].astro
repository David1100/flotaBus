---
import AdminShell from '../../../components/AdminShell.astro';

// The detail page is intentionally generated once. The trip id is supplied by
// /admin/trips/detail?id=123 so Astro's static output remains universal.
export function getStaticPaths() { return [{ params: { id: 'detail' } }]; }
---

<AdminShell title="Detalle de viaje · flotaBus" active="trips">
  <div class="mx-auto max-w-[1120px]">
    <section class="fade-in flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div>
        <div class="eyebrow">SEGUIMIENTO OPERATIVO</div>
        <h1 id="trip-title">Viaje <em>cargando.</em></h1>
        <p id="trip-summary">Consultando planificación e historial…</p>
      </div>
      <a class="inline-flex flex-[0_0_auto] items-center gap-[.45rem] text-[.8rem] font-bold text-[var(--cyan)] no-underline transition-all hover:-translate-x-[3px] hover:text-[var(--amber)]" href="/admin/trips" data-spa-link><span aria-hidden="true">←</span> Volver a viajes</a>
    </section>

    <div id="trip-error" class="state error-state" role="alert" hidden></div>
    <section id="trip-content" class="grid min-w-0 gap-[.85rem] lg:grid-cols-[minmax(0,1.1fr)_minmax(0,.9fr)]" hidden>
      <article class="glass fleet-card min-w-0 rounded-[1.25rem] p-[1.35rem] lg:row-span-2">
        <div class="flex items-start justify-between gap-4"><div class="min-w-0"><div class="eyebrow">RESUMEN DEL VIAJE</div><h2 class="m-0 font-display text-[1.45rem] text-[var(--ink)]">Información principal</h2></div><span id="trip-status" class="status-pill"><i></i>—</span></div>
        <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div class="grid gap-1 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.85rem]"><span class="text-[.6rem] uppercase tracking-[.12em] text-[var(--subtle)]">Origen / base</span><strong id="trip-origin" class="text-[.84rem] text-[var(--ink)]">—</strong></div>
          <div class="grid gap-1 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.85rem]"><span class="text-[.6rem] uppercase tracking-[.12em] text-[var(--subtle)]">Salida inicial</span><strong id="trip-start" class="text-[.84rem] text-[var(--ink)]">—</strong></div>
          <div class="grid gap-1 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.85rem]"><span class="text-[.6rem] uppercase tracking-[.12em] text-[var(--subtle)]">Zona operativa</span><strong id="trip-timezone" class="text-[.84rem] text-[var(--ink)]">—</strong></div>
          <div class="grid gap-1 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.85rem]"><span class="text-[.6rem] uppercase tracking-[.12em] text-[var(--subtle)]">Observaciones generales</span><strong id="trip-notes" class="text-[.84rem] text-[var(--ink)]">Sin observaciones</strong></div>
        </div>
        <div class="mt-6"><div class="mb-3"><div class="eyebrow">RECURSOS</div><h3 class="m-0 font-display text-base text-[var(--ink)]">Bus y chofer asignados</h3></div><div id="trip-assignments" class="grid gap-[.55rem]"></div></div>
      </article>

      <article class="glass fleet-card min-w-0 rounded-[1.25rem] p-[1.35rem]">
        <div class="flex items-start justify-between gap-4"><div class="min-w-0"><div class="eyebrow">PLANIFICACIÓN DE RUTA</div><h2 class="m-0 font-display text-[1.45rem] text-[var(--ink)]">Trayectos ordenados</h2></div><span id="leg-count" class="text-[.8rem] text-[var(--muted)]">—</span></div>
        <div id="trip-legs" class="mt-5 grid gap-[.55rem]"></div>
      </article>

      <article class="glass fleet-card min-w-0 rounded-[1.25rem] p-[1.35rem]">
        <div class="flex items-start justify-between gap-4"><div class="min-w-0"><div class="eyebrow">AUDITORÍA DE OPERACIÓN</div><h2 class="m-0 font-display text-[1.45rem] text-[var(--ink)]">Historial operativo</h2></div></div>
        <ol id="timeline" class="mt-5 grid list-none gap-[.55rem] p-0"></ol>
        <div class="mt-5 flex flex-wrap items-end gap-3 border-t border-[rgba(234,239,226,.1)] pt-4"><label class="grid min-w-0 flex-1 gap-[.45rem] text-[.82rem] text-[#c9d2cc]" for="event-type">Registrar nuevo evento<select id="event-type" class="input" aria-label="Tipo de evento"></select></label><button id="event" class="btn btn-primary" type="button">Registrar evento</button></div>
      </article>
    </section>
  </div>
</AdminShell>

<script>
  import { api, ApiError } from '../../../lib/api';
  import { feedback, Swal } from '../../../lib/feedback';
  import { OPERATION_EVENT_OPTIONS, operationEventLabel, tripStatusClass, tripStatusLabel } from '../../../lib/trip-labels';

  const init = () => {
     const content = document.querySelector<HTMLElement>('#trip-content');
    if (!content || content.dataset.ready === 'true') return;
    content.dataset.ready = 'true';
    const requestedId = new URLSearchParams(window.location.search).get('id');
     // This route is intentionally generated at /admin/trips/detail. The real
     // trip id always comes from the query string so the same page works for
     // direct loads and the AdminShell partial router.
     const tripId = requestedId || 'detail';
     const error = document.querySelector<HTMLElement>('#trip-error');
     const title = document.querySelector<HTMLElement>('#trip-title');
     const summary = document.querySelector<HTMLElement>('#trip-summary');
     const timeline = document.querySelector<HTMLOListElement>('#timeline');
     const eventType = document.querySelector<HTMLSelectElement>('#event-type');
     const eventButton = document.querySelector<HTMLButtonElement>('#event');
    if (!error || !title || !summary || !timeline || !eventType || !eventButton) return;

     const formatDate = (value: unknown) => value ? new Date(value as string | number | Date).toLocaleString('es-CO', { dateStyle: 'medium', timeStyle: 'short' }) : '—';
     const escape = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, character => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[character] ?? character));
     const setError = (message: string) => { error.hidden = false; error.textContent = message; content.hidden = true; };
    if (!/^\d+$/.test(tripId)) { setError('No se indicó un viaje válido.'); return; }

    eventType.innerHTML = OPERATION_EVENT_OPTIONS.map(({ value, label }) => `<option value="${value}">${label}</option>`).join('');
    const renderAssignments = (assignments = []) => {
      const active = assignments.filter(item => !item.status || item.status === 'ACTIVE');
      const target = document.querySelector('#trip-assignments');
      if (!target) return;
      target.innerHTML = active.length ? active.map(item => `<div class="grid grid-cols-[2.2rem_minmax(0,1fr)_minmax(0,1fr)] items-center gap-3 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.85rem] max-md:grid-cols-1"><span class="grid h-8 w-8 place-items-center rounded-[.55rem] border-l-2 border-[var(--cyan)] bg-[rgba(72,228,224,.06)] text-[var(--cyan)]" aria-hidden="true">▣</span><div class="grid min-w-0 gap-1"><span class="text-[.57rem] uppercase tracking-[.1em] text-[var(--subtle)]">Bus</span><strong class="truncate text-[.78rem] text-[var(--ink)]">${escape(item.bus?.placa || 'Sin asignar')}</strong><small class="truncate text-[.66rem] text-[var(--muted)]">${escape([item.bus?.marca, item.bus?.modelo].filter(Boolean).join(' · ') || 'Sin datos del vehículo')}</small></div><div class="grid min-w-0 gap-1"><span class="text-[.57rem] uppercase tracking-[.1em] text-[var(--subtle)]">Chofer</span><strong class="truncate text-[.78rem] text-[var(--ink)]">${escape(item.driver?.nombres || item.driver?.username || 'Sin asignar')}</strong><small class="truncate text-[.66rem] text-[var(--muted)]">${escape(item.driver?.username || '')}</small></div></div>`).join('') : '<p class="m-0 py-[1.35rem] text-[.73rem] text-[var(--subtle)]">Este viaje todavía no tiene bus ni chofer asignados.</p>';
    };
    const renderTimeline = (events = []) => {
      timeline.innerHTML = events.length ? events.map(item => `<li class="relative grid grid-cols-[1rem_minmax(0,1fr)] gap-3"><span class="mt-[.35rem] h-[.6rem] w-[.6rem] rounded-full bg-[var(--cyan)] shadow-[0_0_10px_rgba(72,228,224,.4)]" aria-hidden="true"></span><div class="grid min-w-0 gap-1 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.75rem_.85rem]"><div class="flex flex-wrap items-baseline justify-between gap-2"><strong class="text-[.8rem] text-[var(--ink)]">${escape(operationEventLabel(item.type))}</strong><time class="text-[.66rem] text-[var(--subtle)]">${escape(formatDate(item.occurredAt))}</time></div><p class="m-0 text-[.74rem] text-[var(--muted)]">${escape(item.notes || 'Sin observaciones')}</p><small class="text-[.64rem] text-[var(--subtle)]">Actor: ${escape(item.actor?.nombres || item.actor?.username || 'No disponible')}</small></div></li>`).join('') : '<li class="grid grid-cols-[auto_1fr] items-start gap-3 rounded-[.8rem] border border-dashed border-[rgba(234,239,226,.15)] p-4"><span aria-hidden="true" class="text-[1.2rem] text-[var(--subtle)]">◷</span><div class="grid gap-1"><strong class="text-[.8rem] text-[var(--ink)]">Aún no hay eventos operativos</strong><p class="m-0 text-[.72rem] text-[var(--muted)]">El historial aparecerá aquí cuando se registre el primer cambio de estado.</p></div></li>';
    };
     const render = (raw: any) => {
      const trip = raw.data ?? raw;
      const legs = [...(trip.legs ?? [])].sort((a, b) => a.sequence - b.sequence);
      title.innerHTML = `${escape(trip.code)} <em>${escape(tripStatusLabel(trip.status))}.</em>`;
      summary.textContent = `${trip.origin} · salida ${formatDate(trip.initialStartAt)} · ${legs.length} trayecto${legs.length === 1 ? '' : 's'}`;
      const status = document.querySelector('#trip-status');
      const origin = document.querySelector('#trip-origin');
      const start = document.querySelector('#trip-start');
      const timezone = document.querySelector('#trip-timezone');
      const notes = document.querySelector('#trip-notes');
      const legCount = document.querySelector('#leg-count');
      const legsTarget = document.querySelector('#trip-legs');
      status.className = `status-pill ${tripStatusClass(trip.status)}`;
      status.innerHTML = `<i></i>${escape(tripStatusLabel(trip.status))}`;
      origin.textContent = trip.origin || '—';
      start.textContent = formatDate(trip.initialStartAt);
      timezone.textContent = trip.timezone || 'No definida';
      notes.textContent = trip.notes || 'Sin observaciones';
      legCount.textContent = `${legs.length} trayecto${legs.length === 1 ? '' : 's'}`;
      legsTarget.innerHTML = legs.length ? legs.map(leg => `<div class="grid grid-cols-[2rem_minmax(0,1fr)] gap-3 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.85rem]"><span class="grid h-8 w-8 place-items-center rounded-lg bg-[rgba(72,228,224,.12)] font-display text-[.8rem] font-semibold text-[var(--cyan)]">${leg.sequence}</span><div class="grid min-w-0 gap-2"><strong class="text-[.8rem] text-[var(--ink)]">${escape(leg.origin)} <span aria-hidden="true" class="text-[var(--cyan)]">→</span> ${escape(leg.destination)}</strong><div class="grid gap-2 text-[.7rem] text-[var(--muted)] sm:grid-cols-3"><span class="grid gap-[.15rem]"><small class="text-[.56rem] uppercase tracking-[.1em] text-[var(--subtle)]">Salida</small>${escape(formatDate(leg.plannedDepartureAt))}</span><span class="grid gap-[.15rem]"><small class="text-[.56rem] uppercase tracking-[.1em] text-[var(--subtle)]">Duración</small>${escape(String(leg.durationDays))} día${leg.durationDays === 1 ? '' : 's'}</span><span class="grid gap-[.15rem]"><small class="text-[.56rem] uppercase tracking-[.1em] text-[var(--subtle)]">Llegada estimada</small>${escape(formatDate(leg.plannedArrivalAt))}</span></div>${leg.notes ? `<p class="m-0 text-[.72rem] text-[var(--muted)]">${escape(leg.notes)}</p>` : ''}</div></div>`).join('') : '<p class="m-0 py-[1.35rem] text-[.73rem] text-[var(--subtle)]">No hay trayectos registrados para este viaje.</p>';
      renderAssignments(trip.assignments);
      renderTimeline(trip.events);
      content.hidden = false;
    };
    const load = async () => { try { render(await api(`/trips/${tripId}`)); } catch (cause) { setError(cause instanceof ApiError && cause.status === 403 ? 'No tienes permiso para consultar este viaje.' : 'No pudimos cargar el detalle del viaje. Intenta actualizar.'); } };
    eventButton.addEventListener('click', async () => { try { eventButton.disabled = true; feedback.loading('Registrando evento…'); await api(`/trips/${tripId}/events`, { method: 'POST', body: JSON.stringify({ type: eventType.value }) }); Swal.close(); await feedback.success('El evento fue registrado.'); await load(); } catch (cause) { Swal.close(); await feedback.error(cause instanceof Error ? cause.message : 'No se pudo registrar el evento.'); } finally { eventButton.disabled = false; } });
    void load();
  };
  document.addEventListener('astro:page-load', init);
  init();
</script>
