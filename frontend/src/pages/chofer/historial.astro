---
import DriverShell from '../../components/DriverShell.astro';

export function getStaticPaths() { return [{ params: {} }]; }
---

<DriverShell title="Historial · flotaBus" active="historial">
  <div class="driver-hist grid min-w-0 grid-cols-[minmax(0,1fr)] gap-5">
    <header class="fade-in">
      <div class="eyebrow">CONDUCTOR · REGISTRO DE GASTOS</div>
      <h1 class="m-0 mt-2 font-display tracking-[-.035em] text-[var(--ink)]">Historial del <em>bus.</em></h1>
      <p class="m-0 mt-2 text-[var(--muted)]">Registra tanqueos, pinchazos, mantenimientos y otros gastos. Cada registro notifica al administrador al instante.</p>
    </header>

    <div id="error" class="state error-state" role="alert" hidden></div>

    <article class="glass fleet-card rounded-[1.25rem] p-[1.25rem]">
      <div class="eyebrow">NUEVO REGISTRO</div>
      <h2 class="m-0 mt-1 font-display text-[1.3rem] text-[var(--ink)]">¿Qué pasó con el bus?</h2>
      <form id="hist-form" class="mt-4 grid gap-4" novalidate>
        <label class="grid gap-[.45rem] text-[.82rem] text-[#c9d2cc]">Unidad
          <select id="bus" class="input" required></select>
          <small id="bus-hint" class="text-[.66rem] text-[var(--subtle)]" hidden>Esta unidad se asignó automáticamente según tu viaje activo.</small>
        </label>
        <fieldset class="m-0 grid gap-2 p-0">
          <legend class="text-[.82rem] text-[#c9d2cc]">Categoría</legend>
          <div class="grid grid-cols-2 gap-2 sm:grid-cols-4" role="radiogroup">
            <label class="block cursor-pointer"><input type="radio" name="category" value="MANTENIMIENTO" class="peer sr-only" required /><span class="grid justify-items-center gap-[.25rem] rounded-[.8rem] border border-[rgba(234,239,226,.12)] bg-[rgba(5,11,14,.3)] px-[.5rem] py-[.85rem] text-center transition-colors duration-200 peer-checked:border-[rgba(72,228,224,.45)] peer-checked:bg-[rgba(72,228,224,.1)] peer-checked:shadow-[inset_0_0_0_1px_rgba(72,228,224,.35)] peer-focus-visible:border-[var(--amber)]"><span class="text-[1.4rem] leading-none" aria-hidden="true">🛠</span><span class="text-[.72rem] font-bold text-[var(--ink)]">Mantenimiento</span></span></label>
            <label class="block cursor-pointer"><input type="radio" name="category" value="COMBUSTIBLE" class="peer sr-only" required /><span class="grid justify-items-center gap-[.25rem] rounded-[.8rem] border border-[rgba(234,239,226,.12)] bg-[rgba(5,11,14,.3)] px-[.5rem] py-[.85rem] text-center transition-colors duration-200 peer-checked:border-[rgba(72,228,224,.45)] peer-checked:bg-[rgba(72,228,224,.1)] peer-checked:shadow-[inset_0_0_0_1px_rgba(72,228,224,.35)] peer-focus-visible:border-[var(--amber)]"><span class="text-[1.4rem] leading-none" aria-hidden="true">⛽</span><span class="text-[.72rem] font-bold text-[var(--ink)]">Tanqueo</span></span></label>
            <label class="block cursor-pointer"><input type="radio" name="category" value="PINCHAZO" class="peer sr-only" required /><span class="grid justify-items-center gap-[.25rem] rounded-[.8rem] border border-[rgba(234,239,226,.12)] bg-[rgba(5,11,14,.3)] px-[.5rem] py-[.85rem] text-center transition-colors duration-200 peer-checked:border-[rgba(72,228,224,.45)] peer-checked:bg-[rgba(72,228,224,.1)] peer-checked:shadow-[inset_0_0_0_1px_rgba(72,228,224,.35)] peer-focus-visible:border-[var(--amber)]"><span class="text-[1.4rem] leading-none" aria-hidden="true">🛞</span><span class="text-[.72rem] font-bold text-[var(--ink)]">Pinchazo</span></span></label>
            <label class="block cursor-pointer"><input type="radio" name="category" value="OTRO" class="peer sr-only" required /><span class="grid justify-items-center gap-[.25rem] rounded-[.8rem] border border-[rgba(234,239,226,.12)] bg-[rgba(5,11,14,.3)] px-[.5rem] py-[.85rem] text-center transition-colors duration-200 peer-checked:border-[rgba(72,228,224,.45)] peer-checked:bg-[rgba(72,228,224,.1)] peer-checked:shadow-[inset_0_0_0_1px_rgba(72,228,224,.35)] peer-focus-visible:border-[var(--amber)]"><span class="text-[1.4rem] leading-none" aria-hidden="true">📦</span><span class="text-[.72rem] font-bold text-[var(--ink)]">Otro</span></span></label>
          </div>
        </fieldset>
        <label class="grid gap-[.45rem] text-[.82rem] text-[#c9d2cc]" id="area-wrap">Área específica
          <select id="area" class="input">
            <option value="">Sin área específica</option>
            <option value="CAJA">Caja</option>
            <option value="TRANSMISION">Transmisión</option>
            <option value="RETARDADOR">Retardador</option>
            <option value="LLANTAS">Llantas</option>
            <option value="AIRE_ACONDICIONADO">Aire acondicionado</option>
            <option value="MOTOR">Motor</option>
          </select>
        </label>
        <label class="grid gap-[.45rem] text-[.82rem] text-[#c9d2cc]">Costo (COP)
          <input id="cost" class="input" type="number" min="1" step="1" placeholder="35000" required />
        </label>
        <label class="grid gap-[.45rem] text-[.82rem] text-[#c9d2cc]">Detalle
          <textarea id="detail" class="input" rows="3" required minlength="5" placeholder="Describe el trabajo, gasto o situación…"></textarea>
        </label>
        <div class="grid gap-[.45rem] text-[.82rem] text-[#c9d2cc]">
          Foto del comprobante
          <label for="photo" id="photo-drop" class="grid min-h-[7rem] cursor-pointer place-items-center gap-[.35rem] rounded-[.8rem] border-[1.5px] border-dashed border-[rgba(234,239,226,.18)] bg-[rgba(5,11,14,.24)] px-4 py-4 text-center text-[var(--muted)] transition-colors duration-200 hover:border-[rgba(72,228,224,.4)] hover:bg-[rgba(72,228,224,.05)] [&.is-active]:border-[rgba(72,228,224,.4)] [&.is-active]:bg-[rgba(72,228,224,.05)]">
            <input id="photo" type="file" accept="image/jpeg,image/png,image/webp,image/gif" hidden />
            <span id="photo-prompt" class="text-[.78rem] leading-[1.45]">Toca para adjuntar una imagen (JPG/PNG/WEBP, máx 5MB)</span>
            <span id="photo-name" class="text-[.72rem] font-bold text-[var(--cyan)]" hidden></span>
            <img id="photo-preview" class="max-h-[12rem] rounded-[.6rem] object-cover" alt="Vista previa del comprobante" hidden />
          </label>
        </div>
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <button id="submit" class="btn btn-primary" type="submit">Guardar reporte</button>
          <button id="reset" class="btn btn-secondary" type="reset">Limpiar</button>
        </div>
      </form>
    </article>

    <article class="glass fleet-card rounded-[1.25rem] p-[1.25rem]">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <div class="eyebrow">HISTORIAL</div>
          <h2 class="m-0 mt-1 font-display text-[1.2rem] text-[var(--ink)]">Registros del bus seleccionado</h2>
        </div>
        <div id="hist-summary" class="flex flex-wrap items-center gap-2 max-md:w-full"></div>
      </div>

      <div class="mt-4 flex gap-[.35rem] overflow-x-auto rounded-[1rem] border border-[rgba(234,239,226,.08)] bg-[rgba(5,11,14,.3)] p-[.35rem] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        <button class="hist-tab inline-flex min-h-[2.4rem] flex-none items-center gap-[.35rem] whitespace-nowrap rounded-full border border-transparent px-[.85rem] py-[.5rem] text-[.75rem] font-bold text-[var(--muted)] transition-colors duration-200 hover:bg-[rgba(72,228,224,.06)] hover:text-[var(--ink)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--cyan)] [&.is-active]:border-[rgba(72,228,224,.3)] [&.is-active]:bg-[rgba(72,228,224,.16)] [&.is-active]:text-[var(--ink)]" data-filter="ALL" type="button" aria-pressed="true">Todos</button>
        <button class="hist-tab inline-flex min-h-[2.4rem] flex-none items-center gap-[.35rem] whitespace-nowrap rounded-full border border-transparent px-[.85rem] py-[.5rem] text-[.75rem] font-bold text-[var(--muted)] transition-colors duration-200 hover:bg-[rgba(72,228,224,.06)] hover:text-[var(--ink)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--cyan)] [&.is-active]:border-[rgba(72,228,224,.3)] [&.is-active]:bg-[rgba(72,228,224,.16)] [&.is-active]:text-[var(--ink)]" data-filter="MANTENIMIENTO" type="button" aria-pressed="false"><span aria-hidden="true">🛠</span>Mantenimiento</button>
        <button class="hist-tab inline-flex min-h-[2.4rem] flex-none items-center gap-[.35rem] whitespace-nowrap rounded-full border border-transparent px-[.85rem] py-[.5rem] text-[.75rem] font-bold text-[var(--muted)] transition-colors duration-200 hover:bg-[rgba(72,228,224,.06)] hover:text-[var(--ink)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--cyan)] [&.is-active]:border-[rgba(72,228,224,.3)] [&.is-active]:bg-[rgba(72,228,224,.16)] [&.is-active]:text-[var(--ink)]" data-filter="COMBUSTIBLE" type="button" aria-pressed="false"><span aria-hidden="true">⛽</span>Tanquear</button>
        <button class="hist-tab inline-flex min-h-[2.4rem] flex-none items-center gap-[.35rem] whitespace-nowrap rounded-full border border-transparent px-[.85rem] py-[.5rem] text-[.75rem] font-bold text-[var(--muted)] transition-colors duration-200 hover:bg-[rgba(72,228,224,.06)] hover:text-[var(--ink)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--cyan)] [&.is-active]:border-[rgba(72,228,224,.3)] [&.is-active]:bg-[rgba(72,228,224,.16)] [&.is-active]:text-[var(--ink)]" data-filter="PINCHAZO" type="button" aria-pressed="false"><span aria-hidden="true">🛞</span>Pinchazo</button>
        <button class="hist-tab inline-flex min-h-[2.4rem] flex-none items-center gap-[.35rem] whitespace-nowrap rounded-full border border-transparent px-[.85rem] py-[.5rem] text-[.75rem] font-bold text-[var(--muted)] transition-colors duration-200 hover:bg-[rgba(72,228,224,.06)] hover:text-[var(--ink)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--cyan)] [&.is-active]:border-[rgba(72,228,224,.3)] [&.is-active]:bg-[rgba(72,228,224,.16)] [&.is-active]:text-[var(--ink)]" data-filter="OTRO" type="button" aria-pressed="false"><span aria-hidden="true">📦</span>Otros</button>
      </div>

      <div id="history-list" class="mt-4 grid min-w-0 gap-[.5rem]"></div>
    </article>
  </div>
</DriverShell>

<script>
  import { api, ApiError } from '../../lib/api';
  import { feedback, Swal } from '../../lib/feedback';
  import { openPhotoLightbox } from '../../lib/photo-lightbox';

  const formatMoney = (value: string | number) => Number(value || 0).toLocaleString('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 });
  const escape = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] ?? c));
  const formatDate = (value: string | null | undefined) => value ? new Date(value).toLocaleString('es-CO', { dateStyle: 'medium', timeStyle: 'short' }) : '—';

  const categoryLabels: Record<string, { name: string; icon: string }> = {
    MANTENIMIENTO: { name: 'Mantenimiento', icon: '🛠' },
    COMBUSTIBLE: { name: 'Tanqueo', icon: '⛽' },
    PINCHAZO: { name: 'Pinchazo', icon: '🛞' },
    OTRO: { name: 'Otro', icon: '📦' },
  };

  type Bus = { id: number; placa: string; marca: string; modelo: string };
  type RecordItem = { id: number; busId: number; category: keyof typeof categoryLabels; area?: string | null; cost: string | number; detail: string; photoUrl: string | null; recordedAt: string };

  let currentFilter: keyof typeof categoryLabels | 'ALL' = 'ALL';
  let currentRecords: RecordItem[] = [];

  const fillBusSelect = (select: HTMLSelectElement, includeDefault = true) => {
    const buses = (window as any).__busesCache as Bus[] | undefined;
    if (!buses) { select.innerHTML = ''; return; }
    const head = includeDefault ? '<option value="">Selecciona la unidad</option>' : '';
    select.innerHTML = head + buses.map((b) => `<option value="${b.id}">${escape(b.placa)} · ${escape(b.marca)} ${escape(b.modelo)}</option>`).join('');
  };

  const loadBuses = async () => {
    const dashboard = await api('/driver-portal/dashboard');
    const busSelect = document.getElementById('bus') as HTMLSelectElement;
    const hint = document.getElementById('bus-hint');
    const currentBus = dashboard?.currentBus;
    if (currentBus && currentBus.id) {
      const busOption: Bus = { id: currentBus.id, placa: currentBus.placa, marca: currentBus.marca, modelo: currentBus.modelo };
      (window as any).__busesCache = [busOption];
      fillBusSelect(busSelect);
      busSelect.value = String(currentBus.id);
      busSelect.disabled = true;
      if (hint) { hint.textContent = 'Esta unidad se asignó automáticamente según tu viaje activo.'; hint.hidden = false; }
    } else {
      try {
        const result = await api('/buses/catalog');
        const all: Bus[] = (result?.data ?? (Array.isArray(result) ? result : [])).map((b: any) => ({ id: b.id, placa: b.placa, marca: b.marca, modelo: b.modelo }));
        (window as any).__busesCache = all;
        fillBusSelect(busSelect);
        busSelect.disabled = false;
        if (hint) { hint.textContent = 'No tienes viaje activo. Selecciona la unidad manualmente.'; hint.hidden = false; }
      } catch {
        busSelect.disabled = false;
        if (hint) { hint.textContent = 'No se pudo cargar la lista de unidades.'; hint.hidden = false; }
      }
    }
    await loadHistory();
  };

  const iconTone: Record<string, string> = {
    MANTENIMIENTO: 'bg-[rgba(72,228,224,.16)]',
    COMBUSTIBLE: 'bg-[rgba(245,173,75,.18)]',
    PINCHAZO: 'bg-[rgba(255,116,116,.16)]',
    OTRO: 'bg-[rgba(234,239,226,.1)]',
  };

  const renderHistory = () => {
    const list = document.getElementById('history-list') as HTMLElement;
    const filtered = currentFilter === 'ALL' ? currentRecords : currentRecords.filter((r) => r.category === currentFilter);
    if (!filtered.length) { list.innerHTML = '<div class="rounded-[.8rem] border border-dashed border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.18)] px-[.85rem] py-[1.75rem] text-center text-[.78rem] text-[var(--subtle)]">Sin registros en esta categoría.</div>'; return; }
    list.innerHTML = filtered.map((m) => {
      const cat = categoryLabels[m.category] ?? { name: m.category, icon: '📦' };
      const thumb = m.photoUrl ? `<img src="${escape(m.photoUrl)}" alt="Foto del reporte ${escape(cat.name)}" class="h-full w-full object-cover" loading="lazy" />` : `<span class="text-[1.5rem] leading-none" aria-hidden="true">${cat.icon}</span>`;
      const areaPill = m.area ? `<span class="inline-flex items-center gap-[.25rem] rounded-[.35rem] border border-[rgba(72,228,224,.2)] bg-[rgba(72,228,224,.1)] px-[.45rem] py-[.12rem] text-[.62rem] font-bold uppercase tracking-[.04em] text-[var(--cyan)]">${escape(m.area)}</span>` : '';
      const firstLine = m.detail.split('\n')[0];
      const photoBtn = m.photoUrl ? `<button class="photo-view-btn mt-[.25rem] self-start" type="button" data-photo="${escape(m.photoUrl)}" aria-label="Ver foto del reporte en grande">Ver foto</button>` : '';
      return `<div class="grid grid-cols-[3.5rem_minmax(0,1fr)] items-center gap-3 rounded-[1.1rem] border border-[rgba(234,239,226,.08)] bg-[rgba(5,11,14,.24)] p-[.85rem] transition-colors duration-200 hover:border-[rgba(72,228,224,.32)] hover:bg-[rgba(72,228,224,.05)] sm:grid-cols-[3.5rem_minmax(0,1fr)_auto]"><span class="grid h-14 w-14 place-items-center overflow-hidden rounded-[1rem] ${iconTone[m.category] ?? 'bg-[rgba(234,239,226,.1)]'}">${thumb}</span><div class="grid min-w-0 gap-[.35rem]"><div class="flex flex-wrap items-center gap-[.4rem]"><strong class="text-[.92rem] font-bold leading-[1.25] tracking-[-.01em] text-[var(--ink)]">${escape(cat.name)}</strong>${areaPill}</div><p class="m-0 line-clamp-2 text-[.78rem] leading-[1.45] text-[var(--muted)] [overflow-wrap:anywhere]">${escape(firstLine)}</p>${photoBtn}</div><div class="col-span-2 flex flex-wrap items-center justify-between gap-2 sm:col-span-1 sm:grid sm:justify-items-end sm:gap-[.35rem]"><strong class="font-display text-[1.1rem] font-extrabold tracking-[-.02em] text-[var(--amber)]">${escape(formatMoney(m.cost))}</strong><span class="inline-flex items-center gap-[.25rem] rounded-[999px] border border-[rgba(234,239,226,.1)] bg-[rgba(234,239,226,.06)] px-[.5rem] py-[.15rem] text-[.62rem] text-[var(--subtle)] [font-variant-numeric:tabular-nums]">${escape(formatDate(m.recordedAt))}</span></div></div>`;
    }).join('');
  };

  const setupLightbox = () => {
    const list = document.getElementById('history-list');
    if (!list) return;
    list.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-photo]');
      if (trigger) openPhotoLightbox(trigger.dataset.photo);
    });
  };

  const renderSummary = () => {
    const summary = document.getElementById('hist-summary');
    if (!summary) return;
    const totalCount = currentRecords.length;
    const totalCost = currentRecords.reduce((sum, r) => sum + Number(r.cost || 0), 0);
    const byCategory = currentRecords.reduce<Record<string, number>>((acc, r) => { acc[r.category] = (acc[r.category] ?? 0) + Number(r.cost || 0); return acc; }, {});
    if (totalCount === 0) { summary.innerHTML = ''; return; }
    const parts = [
      `<span class="inline-flex items-center gap-[.35rem] rounded-full border border-[rgba(72,228,224,.22)] bg-[rgba(72,228,224,.08)] px-[.7rem] py-[.35rem] text-[.72rem] font-bold text-[var(--ink)]"><strong class="font-display text-[var(--cyan)]">${totalCount}</strong> registros</span>`,
      `<span class="inline-flex items-center gap-[.35rem] rounded-full border border-[rgba(72,228,224,.22)] bg-[rgba(72,228,224,.08)] px-[.7rem] py-[.35rem] text-[.72rem] font-bold text-[var(--ink)]">Total <strong class="font-display text-[var(--cyan)]">${escape(formatMoney(totalCost))}</strong></span>`,
    ];
    for (const [key, value] of Object.entries(byCategory)) {
      const label = categoryLabels[key]?.name ?? key;
      parts.push(`<span class="inline-flex items-center gap-[.35rem] rounded-full border border-[rgba(72,228,224,.22)] bg-[rgba(72,228,224,.08)] px-[.7rem] py-[.35rem] text-[.72rem] font-bold text-[var(--ink)]">${escape(label)} <strong class="font-display text-[var(--cyan)]">${escape(formatMoney(value))}</strong></span>`);
    }
    summary.innerHTML = parts.join('');
  };

  const loadHistory = async () => {
    const busId = (document.getElementById('bus') as HTMLSelectElement).value;
    const list = document.getElementById('history-list') as HTMLElement;
    if (!busId) { list.innerHTML = '<div class="rounded-[.8rem] border border-dashed border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.18)] px-[.85rem] py-[1.75rem] text-center text-[.78rem] text-[var(--subtle)]"><strong class="mb-[.25rem] block text-[.9rem] text-[var(--ink)]">Sin unidad seleccionada</strong>Elige un bus arriba para ver su historial.</div>'; currentRecords = []; renderSummary(); return; }
    try {
      currentRecords = await api(`/maintenance-records/buses/${busId}/all`);
      renderHistory();
      renderSummary();
    } catch { list.innerHTML = '<div class="rounded-[.8rem] border border-dashed border-[rgba(255,116,116,.25)] bg-[rgba(255,116,116,.06)] px-[.85rem] py-[1.75rem] text-center text-[.78rem] text-[#ff9daa]"><strong class="mb-[.25rem] block text-[.9rem]">Error</strong>No se pudo cargar el historial. Intenta de nuevo.</div>'; }
  };

  const setupCategoryLogic = () => {
    const areaWrap = document.getElementById('area-wrap');
    if (!areaWrap) return;
    const update = () => {
      const selected = (document.querySelector<HTMLInputElement>('input[name="category"]:checked')?.value ?? '') as keyof typeof categoryLabels;
      areaWrap.hidden = selected !== 'MANTENIMIENTO';
    };
    document.querySelectorAll<HTMLInputElement>('input[name="category"]').forEach((input) => input.addEventListener('change', update));
    update();
  };

  const setupPhotoDrop = () => {
    const drop = document.getElementById('photo-drop') as HTMLElement;
    const input = document.getElementById('photo') as HTMLInputElement;
    const name = document.getElementById('photo-name') as HTMLElement;
    const preview = document.getElementById('photo-preview') as HTMLImageElement;
    const prompt = document.getElementById('photo-prompt') as HTMLElement;
    const update = (file?: File) => {
      if (!file) return;
      name.textContent = file.name;
      name.hidden = false;
      prompt.hidden = true;
      const reader = new FileReader();
      reader.onload = (event) => { preview.src = String(event.target?.result ?? ''); preview.hidden = false; };
      reader.readAsDataURL(file);
    };
    input.addEventListener('change', () => update(input.files?.[0]));
    drop.addEventListener('click', () => input.click());
    drop.addEventListener('dragover', (event) => { event.preventDefault(); drop.classList.add('is-active'); });
    drop.addEventListener('dragleave', () => drop.classList.remove('is-active'));
    drop.addEventListener('drop', (event) => {
      event.preventDefault(); drop.classList.remove('is-active');
      const file = event.dataTransfer?.files?.[0]; if (!file) return;
      const dt = new DataTransfer(); dt.items.add(file); input.files = dt.files; update(file);
    });
  };

  const setupForm = () => {
    const form = document.getElementById('hist-form') as HTMLFormElement;
    const submit = document.getElementById('submit') as HTMLButtonElement;
    const error = document.getElementById('error') as HTMLElement;
    if (!form || (form as any).__bound) return;
    (form as any).__bound = true;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      error.hidden = true;
      const busId = (document.getElementById('bus') as HTMLSelectElement).value;
      const category = (document.querySelector<HTMLInputElement>('input[name="category"]:checked')?.value ?? '') as 'MANTENIMIENTO' | 'COMBUSTIBLE' | 'PINCHAZO' | 'OTRO';
      const area = (document.getElementById('area') as HTMLSelectElement).value || undefined;
      const cost = (document.getElementById('cost') as HTMLInputElement).value;
      const detail = (document.getElementById('detail') as HTMLTextAreaElement).value.trim();
      const photo = (document.getElementById('photo') as HTMLInputElement).files?.[0];
      if (!busId || !category || !cost || !detail) {
        error.hidden = false; error.textContent = 'Completa unidad, categoría, costo y detalle.'; return;
      }
      const incidentFlow = (window as any).__incidentFlow === true;
      submit.disabled = true;
      try {
        feedback.loading('Guardando reporte…');
        let photoUrl: string | undefined;
        if (photo) {
          const data = new FormData(); data.append('photo', photo);
          photoUrl = (await api(`/maintenance-records/buses/${busId}/photo`, { method: 'POST', body: data })).photoUrl;
        }
        const payload: { category: string; cost: string; detail: string; area?: string; photoUrl?: string } = { category, cost, detail };
        if (category === 'MANTENIMIENTO' && area) payload.area = area;
        if (photoUrl) payload.photoUrl = photoUrl;
        await api(`/maintenance-records/buses/${busId}`, { method: 'POST', body: JSON.stringify(payload) });
        if (incidentFlow) {
          try {
            const tripId = (await api('/driver-portal/dashboard')).activeTrip?.id;
            if (tripId) {
              await api(`/trips/${tripId}/events`, { method: 'POST', body: JSON.stringify({ type: 'INCIDENT', notes: detail }) });
            }
          } catch (cause) {
            await feedback.error('El reporte se guardó pero no pudimos actualizar el estado del viaje. Avisa al administrador.', 'Aviso');
          }
          (window as any).__incidentFlow = false;
        }
        Swal.close();
        await feedback.success(incidentFlow ? 'Incidencia registrada y viaje actualizado.' : 'Reporte guardado. El administrador fue notificado.', 'Listo');
        form.reset();
        (document.getElementById('photo-name') as HTMLElement).hidden = true;
        (document.getElementById('photo-preview') as HTMLElement).hidden = true;
        (document.getElementById('photo-prompt') as HTMLElement).hidden = false;
        setupCategoryLogic();
        currentFilter = 'ALL';
        document.querySelectorAll<HTMLButtonElement>('.hist-tab').forEach((b) => {
          const active = b.dataset.filter === 'ALL';
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        await loadHistory();
      } catch (cause) {
        Swal.close();
        const message = cause instanceof ApiError ? cause.message : 'Error inesperado.';
        error.hidden = false; error.textContent = message;
        await feedback.error(message, 'No se pudo guardar');
      } finally {
        submit.disabled = false;
      }
    });
    document.getElementById('reset')?.addEventListener('click', () => setTimeout(setupCategoryLogic, 0));
    document.getElementById('history-bus')?.addEventListener('change', () => { void loadHistory(); });
    document.querySelectorAll<HTMLButtonElement>('.hist-tab').forEach((button) => {
      button.addEventListener('click', () => {
        currentFilter = (button.dataset.filter ?? 'ALL') as typeof currentFilter;
        document.querySelectorAll<HTMLButtonElement>('.hist-tab').forEach((b) => {
          const active = b === button;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        renderHistory();
      });
    });
    (document.getElementById('bus') as HTMLSelectElement)?.addEventListener('change', () => { void loadHistory(); });
  };

  const init = async () => {
    const root = document.getElementById('hist-form');
    if (!root) return;
    setupCategoryLogic();
    setupPhotoDrop();
    setupForm();
    setupLightbox();
    try { await loadBuses(); }
    catch (cause) {
      await feedback.error(cause instanceof Error ? cause.message : 'Error inesperado.', 'No se pudo cargar');
      return;
    }
    const params = new URLSearchParams(window.location.search);
    if (params.get('incident') === '1') {
      (window as any).__incidentFlow = true;
      const busId = (document.getElementById('bus') as HTMLSelectElement).value;
      const detail = document.getElementById('detail') as HTMLTextAreaElement | null;
      const formCategory = document.querySelector<HTMLInputElement>('input[name="category"][value="MANTENIMIENTO"]');
      formCategory?.click();
      if (detail) { detail.value = 'Incidencia durante la ruta: '; detail.focus(); detail.setSelectionRange(detail.value.length, detail.value.length); }
      const banner = document.createElement('div');
      banner.id = 'incident-banner';
      banner.className = 'rounded-[.8rem] border border-[rgba(255,116,116,.35)] bg-[rgba(255,116,116,.08)] px-4 py-3 text-[.78rem] text-[#ff9daa]';
      banner.innerHTML = '<strong>Modo incidencia.</strong> Completa el reporte para registrar el cambio de estado del viaje. Si cancelas, el viaje sigue igual.';
      const formEl = document.getElementById('hist-form');
      formEl?.parentElement?.insertBefore(banner, formEl);
      window.history.replaceState({}, '', busId ? `/chofer/historial?busId=${busId}` : '/chofer/historial');
    } else {
      (window as any).__incidentFlow = false;
    }
  }

  if (!(window as any).__driverHistInitBound) {
    (window as any).__driverHistInitBound = true;
    document.addEventListener('astro:page-load', () => { void init(); });
  }
  void init();
</script>