---
import DriverShell from '../../components/DriverShell.astro';

export function getStaticPaths() { return [{ params: {} }]; }
---

<DriverShell title="Mi ruta · flotaBus" active="dashboard">
  <div class="driver-dashboard grid gap-5">
    <header class="fade-in">
      <div class="eyebrow">CONDUCTOR · PANEL DE OPERACIONES</div>
      <h1 id="dashboard-greeting" class="m-0 mt-2 font-display tracking-[-.035em] text-[var(--ink)]">Hola, <em id="dashboard-name">cargando.</em></h1>
      <p id="dashboard-subtitle" class="m-0 mt-2 text-[var(--muted)]">Cargando tu información…</p>
    </header>

    <article id="active-trip-card" class="glass fleet-card rounded-[1.25rem] p-[1.25rem]" hidden>
      <div class="flex items-start justify-between gap-3">
        <div>
          <div class="eyebrow">VIAJE ACTIVO</div>
          <h2 id="active-trip-code" class="m-0 mt-1 font-display text-[1.5rem] tracking-[-.03em] text-[var(--ink)]">—</h2>
        </div>
        <span id="active-trip-status" class="status-pill"><i></i>—</span>
      </div>
      <p id="active-trip-route" class="m-0 mt-3 text-[.82rem] text-[var(--muted)]">—</p>
      <dl class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
        <div class="grid gap-1 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.85rem]">
          <dt class="text-[.58rem] uppercase tracking-[.12em] text-[var(--subtle)]">Salida</dt>
          <dd id="active-trip-departure" class="m-0 text-[.82rem] font-extrabold text-[var(--ink)]">—</dd>
        </div>
        <div class="grid gap-1 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.85rem]">
          <dt class="text-[.58rem] uppercase tracking-[.12em] text-[var(--subtle)]">Trayectos</dt>
          <dd id="active-trip-legs" class="m-0 text-[.82rem] font-extrabold text-[var(--ink)]">—</dd>
        </div>
        <div class="grid gap-1 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.85rem]">
          <dt class="text-[.58rem] uppercase tracking-[.12em] text-[var(--subtle)]">Notas</dt>
          <dd id="active-trip-notes" class="m-0 text-[.82rem] text-[var(--muted)]">—</dd>
        </div>
      </dl>
      <div id="leg-current" class="mt-4 grid gap-3 rounded-[1rem] border border-[rgba(72,228,224,.25)] bg-[linear-gradient(135deg,rgba(72,228,224,.08),rgba(72,228,224,.02))] p-4">
        <div class="flex items-start justify-between gap-2">
          <div>
            <span id="leg-label" class="text-[.58rem] font-bold uppercase tracking-[.12em] text-[var(--cyan)]">Tramo 1</span>
            <strong id="leg-title" class="block mt-1 text-[var(--ink)] text-[.92rem] font-bold leading-[1.3]">—</strong>
          </div>
          <span id="leg-status" class="inline-flex items-center gap-[.25rem] px-[.55rem] py-[.2rem] rounded-[.5rem] text-[.62rem] font-bold uppercase tracking-[.04em] border border-[rgba(245,173,75,.25)] bg-[rgba(245,173,75,.08)] text-[var(--amber)] whitespace-nowrap">Pendiente</span>
        </div>
        <div id="leg-actions" class="flex flex-wrap gap-[.55rem]"></div>
      </div>
      <div id="leg-progress" class="mt-3 flex items-center gap-[.35rem]"></div>
    </article>

    <article id="bus-card" class="glass fleet-card rounded-[1.25rem] p-[1.25rem]" hidden>
      <div class="flex items-start justify-between gap-3">
        <div>
          <div class="eyebrow">MI VEHÍCULO</div>
          <h2 id="bus-title" class="m-0 mt-1 font-display text-[1.5rem] tracking-[-.03em] text-[var(--ink)]">—</h2>
        </div>
        <span id="bus-status" class="status-pill"><i></i>—</span>
      </div>
      <dl class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
        <div class="grid gap-1 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.85rem]">
          <dt class="text-[.58rem] uppercase tracking-[.12em] text-[var(--subtle)]">Marca / Modelo</dt>
          <dd id="bus-brand" class="m-0 text-[.82rem] font-extrabold text-[var(--ink)]">—</dd>
        </div>
        <div class="grid gap-1 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.85rem]">
          <dt class="text-[.58rem] uppercase tracking-[.12em] text-[var(--subtle)]">Kilometraje</dt>
          <dd id="bus-km" class="m-0 text-[.82rem] font-extrabold text-[var(--cyan)]">—</dd>
        </div>
        <div class="grid gap-1 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.85rem]">
          <dt class="text-[.58rem] uppercase tracking-[.12em] text-[var(--subtle)]">Tipo</dt>
          <dd id="bus-type" class="m-0 text-[.82rem] text-[var(--ink)]">—</dd>
        </div>
      </dl>
      <div class="mt-4 flex flex-wrap gap-[.5rem]">
        <a id="bus-maint-link" class="btn btn-primary" href="/chofer/historial" data-spa-link><span class="mr-2 inline-flex" aria-hidden="true">🔧</span>Registrar mantenimiento</a>
        <a class="btn btn-secondary" href="/chofer/mensajes" data-spa-link><span class="mr-2 inline-flex" aria-hidden="true">✉</span>Enviar mensaje al administrador</a>
      </div>
    </article>

    <section class="grid gap-4 md:grid-cols-2">
      <article class="glass fleet-card rounded-[1.25rem] p-[1.25rem]">
        <div class="flex items-start justify-between gap-3 flex-wrap">
          <div>
            <div class="eyebrow">MIS RUTAS</div>
            <h2 class="m-0 mt-1 font-display text-[1.2rem] text-[var(--ink)]">Viajes asignados</h2>
          </div>
          <div class="flex items-center gap-1 rounded-full border border-[rgba(234,239,226,.08)] bg-[rgba(5,11,14,.3)] p-1">
            <button class="route-tab px-[.75rem] py-[.35rem] rounded-full border border-transparent bg-transparent text-[var(--muted)] text-[.72rem] font-bold cursor-pointer transition-all duration-200 hover:text-[var(--ink)] hover:bg-[rgba(72,228,224,.06)] is-active:text-[var(--ink)] is-active:bg-[rgba(72,228,224,.16)] is-active:border-[rgba(72,228,224,.3)]" data-route-filter="IN_PROGRESS" type="button">En curso</button>
            <button class="route-tab px-[.75rem] py-[.35rem] rounded-full border border-transparent bg-transparent text-[var(--muted)] text-[.72rem] font-bold cursor-pointer transition-all duration-200 hover:text-[var(--ink)] hover:bg-[rgba(72,228,224,.06)] is-active:text-[var(--ink)] is-active:bg-[rgba(72,228,224,.16)] is-active:border-[rgba(72,228,224,.3)]" data-route-filter="UPCOMING" type="button">Próximos</button>
            <button class="route-tab px-[.75rem] py-[.35rem] rounded-full border border-transparent bg-transparent text-[var(--muted)] text-[.72rem] font-bold cursor-pointer transition-all duration-200 hover:text-[var(--ink)] hover:bg-[rgba(72,228,224,.06)] is-active:text-[var(--ink)] is-active:bg-[rgba(72,228,224,.16)] is-active:border-[rgba(72,228,224,.3)]" data-route-filter="COMPLETED" type="button">Completados</button>
          </div>
        </div>
        <div id="upcoming-list" class="mt-4 grid gap-[.5rem]"></div>
      </article>
      <article class="glass fleet-card rounded-[1.25rem] p-[1.25rem]">
        <div class="eyebrow">MANTENIMIENTO RECIENTE</div>
        <h2 class="m-0 mt-1 font-display text-[1.2rem] text-[var(--ink)]">Últimos reportes</h2>
        <div id="maintenance-list" class="mt-4 grid gap-[.5rem]"></div>
      </article>
    </section>

    <div id="empty-state" class="glass fleet-card rounded-[1.25rem] p-[1.5rem] text-center" hidden>
      <h2 class="m-0 font-display text-[1.3rem] text-[var(--ink)]">Sin viajes asignados</h2>
      <p class="m-0 mt-2 text-[.82rem] text-[var(--muted)]">Cuando se te asigne un viaje aparecerá aquí con todos los detalles.</p>
    </div>
  </div>
</DriverShell>

<style>
  [hidden] { display: none !important; }
</style>

<script>
  import { api, ApiError } from '../../lib/api';
  import { feedback, Swal } from '../../lib/feedback';
  import { OPERATION_EVENT_GROUPS, operationEventLabel, tripStatusClass, tripStatusLabel } from '../../lib/trip-labels';

  const formatDate = (value: string | null | undefined) => value ? new Date(value).toLocaleString('es-CO', { dateStyle: 'medium', timeStyle: 'short' }) : '—';
  const formatMoney = (value: string | number) => Number(value || 0).toLocaleString('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 });

  type RouteFilter = 'IN_PROGRESS' | 'UPCOMING' | 'COMPLETED';
  let currentRouteFilter: RouteFilter = 'IN_PROGRESS';
  let allTripsCache: any[] = [];
  const escape = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] ?? c));

  const init = async () => {
    const greeting = document.getElementById('dashboard-greeting');
    const nameEl = document.getElementById('dashboard-name');
    const subtitle = document.getElementById('dashboard-subtitle');
    const tripCard = document.getElementById('active-trip-card') as HTMLElement | null;
    const busCard = document.getElementById('bus-card') as HTMLElement | null;
    const emptyState = document.getElementById('empty-state') as HTMLElement | null;
    const upcomingList = document.getElementById('upcoming-list') as HTMLElement | null;
    const maintenanceList = document.getElementById('maintenance-list') as HTMLElement | null;
    if (!greeting || !tripCard || !busCard || !emptyState || !upcomingList || !maintenanceList) return;

    const setText = (id: string, value: string) => { const el = document.getElementById(id); if (el) el.textContent = value; };
    const setStatusPill = (id: string, status: string) => { const el = document.getElementById(id); if (!el) return; el.className = `status-pill ${tripStatusClass(status)}`; el.innerHTML = `<i></i>${tripStatusLabel(status)}`; };

    try {
      const data = await api('/driver-portal/dashboard');
      const driver = data?.driver;
      if (nameEl && driver?.nombres) nameEl.textContent = driver.nombres;
      if (subtitle && driver?.codigo) subtitle.textContent = `Código ${driver.codigo} · Listo para operar`;

      const activeTrip = data?.activeTrip;
      const currentBus = data?.currentBus;
      const upcoming = data?.upcomingTrips ?? [];
      const allTrips = data?.allTrips ?? [];
      const maintenance = data?.recentMaintenance ?? [];

      if (!activeTrip && !currentBus) {
        emptyState.hidden = false;
        tripCard.hidden = true;
        busCard.hidden = true;
      }

      if (activeTrip) {
        tripCard.hidden = false;
        setText('active-trip-code', activeTrip.code);
        setStatusPill('active-trip-status', activeTrip.status);
        const lastLeg = activeTrip.legs?.at(-1);
        setText('active-trip-route', `${activeTrip.origin}${lastLeg ? ` → ${lastLeg.destination}` : ''}`);
        setText('active-trip-departure', formatDate(activeTrip.initialStartAt));
        setText('active-trip-legs', `${activeTrip.legs?.length ?? 0} tramos`);
        setText('active-trip-notes', activeTrip.notes || 'Sin observaciones');
        renderLegControls(activeTrip);
      }

      if (currentBus) {
        busCard.hidden = false;
        setText('bus-title', currentBus.placa);
        setStatusPill('bus-status', currentBus.status);
        setText('bus-brand', `${currentBus.marca} · ${currentBus.modelo}`);
        setText('bus-km', `${Number(currentBus.kilometraje).toLocaleString('es-ES')} km`);
        setText('bus-type', currentBus.busType === 'DOBLE_PISO' ? 'Doble piso' : 'Normal');
        const link = document.getElementById('bus-maint-link') as HTMLAnchorElement | null;
        if (link) link.href = `/chofer/historial?busId=${encodeURIComponent(currentBus.id)}`;
      }

allTripsCache = allTrips;
      renderRouteList(allTrips);

      maintenanceList.innerHTML = maintenance.length
          ? maintenance.map((m: any) => `<div class="grid grid-cols-[auto_1fr_auto] items-center gap-3 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.85rem]"><span class="grid h-[1.9rem] w-[1.9rem] place-items-center rounded-[.55rem] bg-[rgba(245,173,75,.12)] font-display text-[.7rem] font-extrabold text-[var(--amber)]">${escape((m.area || '').slice(0, 2).toUpperCase())}</span><div class="grid min-w-0 gap-1"><strong class="truncate text-[.82rem] text-[var(--ink)]">${escape(m.area)}</strong><small class="text-[.66rem] text-[var(--muted)]">${escape(formatDate(m.recordedAt))}</small></div><strong class="font-display text-[.82rem] text-[var(--amber)]">${escape(formatMoney(m.cost))}</strong></div>`).join('')
          : '<div class="grid place-items-center px-5 py-3.5 border border-dashed border-[rgba(234,239,226,.1)] rounded-xl text-[var(--subtle)] text-[.78rem] text-center">Sin mantenimientos recientes.</div>';

      greeting.dataset.ready = 'true';
    } catch (cause) {
      if (subtitle) subtitle.textContent = 'No pudimos cargar tu panel. Intenta actualizar.';
      await feedback.error(cause instanceof ApiError ? cause.message : 'Error inesperado.', 'Sin conexión con el servidor');
    }
  };

  const renderLegControls = (activeTrip: any) => {
    const legs: any[] = activeTrip.legs ?? [];
    const tripStatus: string = activeTrip.status;
    if (!legs.length) return;
    const currentLeg = legs.find((l) => !l.execution || l.execution.status === 'NOT_STARTED' || l.execution.status === 'RUNNING') ?? legs[legs.length - 1];
    const legStatus = currentLeg.execution?.status ?? 'NOT_STARTED';
    const isFirstPending = legs.filter((l) => l.execution?.status !== 'FINISHED').length === legs.length;
    const allFinished = legs.every((l) => l.execution?.status === 'FINISHED');
    const tripFinished = ['RETURNED', 'CANCELLED'].includes(tripStatus);
    const tripIsPaused = tripStatus === 'PAUSED_LUNCH';
    const tripIsStopped = tripStatus === 'STOPPED';
    const tripInTransit = tripStatus === 'IN_TRANSIT';

    const legLabel = document.getElementById('leg-label');
    const legTitle = document.getElementById('leg-title');
    const legStatusEl = document.getElementById('leg-status');
    const legActions = document.getElementById('leg-actions');
    const legProgress = document.getElementById('leg-progress');
    if (legLabel) legLabel.textContent = `Tramo ${currentLeg.sequence} de ${legs.length}`;
    if (legTitle) legTitle.textContent = `${currentLeg.origin} → ${currentLeg.destination}`;
    if (legStatusEl) {
      const statusMap: Record<string, { label: string; classes: string }> = {
        NOT_STARTED: { label: 'Pendiente', classes: 'border-[rgba(245,173,75,.25)] bg-[rgba(245,173,75,.08)] text-[var(--amber)]' },
        RUNNING: { label: 'En curso', classes: 'border-[rgba(72,228,224,.3)] bg-[rgba(72,228,224,.12)] text-[var(--cyan)]' },
        FINISHED: { label: '✓ Listo', classes: 'border-[rgba(94,197,146,.25)] bg-[rgba(94,197,146,.08)] text-[#5ec592]' },
      };
      const ms = statusMap[legStatus] ?? statusMap.NOT_STARTED;
      legStatusEl.textContent = ms.label;
      legStatusEl.className = `inline-flex items-center gap-[.25rem] px-[.55rem] py-[.2rem] rounded-[.5rem] text-[.62rem] font-bold uppercase tracking-[.04em] border whitespace-nowrap ${ms.classes}`;
    }
    const buttons: string[] = [];
    const btnBase = 'inline-flex items-center gap-2 min-h-[2.6rem] px-[.9rem] py-[.55rem] rounded-[.75rem] text-[.78rem] font-bold cursor-pointer transition-all duration-200 active:translate-y-[1px] border';
    const toneClass: Record<string, string> = {
      cyan: 'border-[rgba(72,228,224,.3)] bg-[rgba(72,228,224,.08)] text-[var(--cyan)] hover:border-[rgba(72,228,224,.45)] hover:bg-[rgba(72,228,224,.16)]',
      amber: 'border-[rgba(245,173,75,.35)] bg-[rgba(5,11,14,.35)] text-[var(--amber)] hover:border-[rgba(245,173,75,.55)] hover:bg-[rgba(245,173,75,.08)]',
      gray: 'border-[rgba(234,239,226,.18)] bg-[rgba(5,11,14,.35)] text-[var(--ink)] hover:border-[rgba(72,228,224,.4)] hover:bg-[rgba(72,228,224,.06)]',
      success: 'border-[rgba(94,197,146,.35)] bg-[rgba(94,197,146,.08)] text-[#5ec592] hover:border-[rgba(94,197,146,.55)] hover:bg-[rgba(94,197,146,.16)]',
      warn: 'border-[rgba(255,116,116,.35)] bg-[rgba(5,11,14,.35)] text-[#ff9daa] hover:border-[rgba(255,116,116,.55)] hover:bg-[rgba(255,116,116,.08)]',
    };
    const primaryTone: Record<string, string> = {
      STARTED: 'cyan', RESUME: 'cyan', STOPPED: 'amber', ARRIVED: 'success', FINISH: 'success', INCIDENT: 'warn',
    };
    const dotColor: Record<string, string> = {
      STARTED: 'var(--cyan)', RESUME: 'var(--cyan)', STOPPED: '#d4a72c', ARRIVED: '#5ec592', FINISH: 'var(--amber)', INCIDENT: '#ff7474',
    };
    const primaryBtn = (type: string) => {
      const tone = primaryTone[type] ?? 'cyan';
      const dot = dotColor[type] ?? 'var(--cyan)';
      return `<button class="${btnBase} ${toneClass[tone]}" data-event="${type}" type="button"><span class="inline-block w-[.55rem] h-[.55rem] rounded-full" style="background:${dot}" aria-hidden="true"></span>${operationEventLabel(type)}</button>`;
    };
    const incidentBtn = primaryBtn('INCIDENT');

    if (tripFinished) {
      buttons.push(`<div class="text-[.78rem] text-[#5ec592] font-bold">✓ Viaje finalizado</div>`);
    } else {
      if (tripIsStopped) buttons.push(primaryBtn('RESUME'));
      else if (tripIsPaused) buttons.push(primaryBtn('RESUME'));
      else if (legStatus === 'NOT_STARTED' && isFirstPending) buttons.push(primaryBtn('STARTED'));
      else if (legStatus === 'RUNNING') {
        buttons.push(primaryBtn('STOPPED'));
        buttons.push(primaryBtn('ARRIVED'));
      } else if (allFinished) buttons.push(primaryBtn('FINISH'));
      buttons.push(incidentBtn);
    }
    if (legActions) {
      legActions.innerHTML = buttons.join('');
      legActions.querySelectorAll<HTMLButtonElement>('[data-event]').forEach((button) => {
        button.addEventListener('click', () => { void sendEvent(button); });
      });
    }
    if (legProgress) {
      const finished = legs.filter((l) => l.execution?.status === 'FINISHED').length;
      legProgress.innerHTML = legs.map((l: any) => `<span class="inline-block w-[1.4rem] h-[.35rem] rounded-full ${l.execution?.status === 'FINISHED' ? 'bg-[#5ec592]' : l.execution?.status === 'RUNNING' ? 'bg-[var(--cyan)]' : 'bg-[rgba(234,239,226,.15)]'}" title="Tramo ${l.sequence}: ${l.execution?.status ?? 'NOT_STARTED'}"></span>`).join('');
      legProgress.innerHTML += `<small class="ml-2 text-[.66rem] text-[var(--subtle)]">${finished} / ${legs.length}</small>`;
    }
  };

  async function sendEvent(button: HTMLButtonElement) {
    const type = button.dataset.event ?? '';
    const allowed = [...OPERATION_EVENT_GROUPS.primary, ...OPERATION_EVENT_GROUPS.always];
    if (!allowed.includes(type as (typeof allowed)[number])) return;
    if (type === 'INCIDENT') {
      const dashboard = await api('/driver-portal/dashboard');
      const activeTrip = dashboard?.activeTrip;
      const currentBus = dashboard?.currentBus;
      if (!activeTrip) {
        await feedback.error('No hay viaje activo.', 'No se puede reportar');
        return;
      }
      const busId = currentBus?.id ?? activeTrip.assignments?.[0]?.busId;
      if (!busId) {
        await feedback.error('No se pudo identificar la unidad del viaje.', 'No se puede reportar');
        return;
      }
      window.location.assign(`/chofer/historial?busId=${busId}&incident=1`);
      return;
    }
    button.disabled = true;
    try {
      feedback.loading(`${operationEventLabel(type)}…`);
      const tripId = (await api('/driver-portal/dashboard')).activeTrip?.id;
      if (!tripId) throw new Error('No hay viaje activo.');
      await api(`/trips/${tripId}/events`, { method: 'POST', body: JSON.stringify({ type }) });
      Swal.close();
      await feedback.success(`${operationEventLabel(type)} registrado. El administrador fue notificado.`, 'Listo');
      await init();
    } catch (cause) {
      Swal.close();
      await feedback.error(cause instanceof ApiError ? cause.message : 'Error inesperado.', 'No se pudo registrar');
    } finally {
      button.disabled = false;
    }
  }

  function renderRouteList(trips: any[]) {
    const list = document.getElementById('upcoming-list') as HTMLElement | null;
    if (!list) return;
    const filter = currentRouteFilter;
    const filtered = trips.filter((t: any) => {
      if (filter === 'IN_PROGRESS') return ['IN_TRANSIT', 'STOPPED', 'PAUSED_LUNCH', 'ARRIVED'].includes(t.trip.status);
      if (filter === 'UPCOMING') return t.trip.status === 'ASSIGNED';
      if (filter === 'COMPLETED') return ['RETURNED', 'CANCELLED'].includes(t.trip.status);
      return false;
    });
    if (!filtered.length) { list.innerHTML = `<div class="grid place-items-center px-5 py-3.5 border border-dashed border-[rgba(234,239,226,.1)] rounded-xl text-[var(--subtle)] text-[.78rem] text-center">${emptyMessage(filter)}</div>`; return; }
    list.innerHTML = filtered.map((t: any) => {
      const actionBtn = `<span class="text-[.68rem] font-bold text-[var(--cyan)] px-[.65rem] py-[.3rem] rounded-[.55rem] border border-[rgba(72,228,224,.3)] bg-[rgba(72,228,224,.08)] pointer-events-none opacity-65">${escape(tripStatusLabel(t.trip.status))}</span>`;
      return `<div class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-[.85rem] p-[.8rem_.95rem] rounded-2xl border border-[rgba(234,239,226,.08)] bg-[rgba(5,11,14,.24)] transition-all duration-200 hover:border-[rgba(72,228,224,.32)] hover:bg-[rgba(72,228,224,.05)]"><span class="grid h-[1.9rem] w-[1.9rem] place-items-center rounded-[.55rem] bg-[rgba(72,228,224,.12)] font-display text-[.7rem] font-extrabold text-[var(--cyan)]" aria-hidden="true">→</span><div class="grid min-w-0 gap-1"><strong class="truncate text-[.82rem] text-[var(--ink)]">${escape(t.trip.code)}</strong><small class="text-[.66rem] text-[var(--muted)]">${escape(formatDate(t.trip.initialStartAt))} · ${escape(t.trip.origin)}${t.trip.firstDestination ? ` → ${escape(t.trip.firstDestination)}` : ''}</small></div><div class="grid justify-items-end gap-[.25rem]">${actionBtn}<span class="status-pill ${tripStatusClass(t.trip.status)}"><i></i>${tripStatusLabel(t.trip.status)}</span></div></div>`;
    }).join('');
  }

  function emptyMessage(filter: string) {
    if (filter === 'IN_PROGRESS') return 'No tienes viajes en curso.';
    if (filter === 'UPCOMING') return 'No tienes viajes próximos asignados.';
    return 'Aún no has completado viajes.';
  }

  function bindRouteTabs() {
    document.querySelectorAll<HTMLButtonElement>('.route-tab').forEach((button) => {
      if (button.dataset.bound === 'true') return;
      button.dataset.bound = 'true';
      button.addEventListener('click', () => {
        currentRouteFilter = (button.dataset.routeFilter ?? 'IN_PROGRESS') as RouteFilter;
        document.querySelectorAll<HTMLButtonElement>('.route-tab').forEach((b) => b.classList.toggle('is-active', b === button));
        const list = document.getElementById('upcoming-list');
        renderRouteList(list ? allTripsCache : []);
      });
    });
  }

  const start = () => {
    bindRouteTabs();
    void init();
  };

  document.addEventListener('astro:page-load', start);
  start();
</script>