---
import DriverShell from '../../components/DriverShell.astro';

export function getStaticPaths() { return [{ params: {} }]; }
---

<DriverShell title="Mantenimiento · flotaBus" active="mantenimiento">
  <div class="driver-maint grid gap-5">
    <header class="fade-in">
      <div class="eyebrow">CONDUCTOR · REPORTE DE GASTOS</div>
      <h1 class="m-0 mt-2 font-display tracking-[-.035em] text-[var(--ink)]">Registrar <em>mantenimiento.</em></h1>
      <p class="m-0 mt-2 text-[var(--muted)]">Sube una foto, indica el costo y deja el detalle. El administrador verá el reporte al instante.</p>
    </header>

    <div id="error" class="state error-state" role="alert" hidden></div>

    <article class="glass fleet-card rounded-[1.25rem] p-[1.25rem]">
      <form id="maint-form" class="grid gap-4" novalidate>
        <label class="grid gap-[.45rem] text-[.82rem] text-[#c9d2cc]">Unidad
          <select id="bus" class="input" required></select>
        </label>
        <label class="grid gap-[.45rem] text-[.82rem] text-[#c9d2cc]">Área
          <select id="area" class="input" required>
            <option value="">Selecciona el área</option>
            <option value="CAJA">Caja</option>
            <option value="TRANSMISION">Transmisión</option>
            <option value="RETARDADOR">Retardador</option>
            <option value="LLANTAS">Llantas</option>
            <option value="AIRE_ACONDICIONADO">Aire acondicionado</option>
            <option value="MOTOR">Motor</option>
          </select>
        </label>
        <label class="grid gap-[.45rem] text-[.82rem] text-[#c9d2cc]">Costo (COP)
          <input id="cost" class="input" type="number" min="1" step="1" placeholder="35000" required />
        </label>
        <label class="grid gap-[.45rem] text-[.82rem] text-[#c9d2cc]">Detalle
          <textarea id="detail" class="input" rows="4" required minlength="5" placeholder="Describe el trabajo o gasto realizado…"></textarea>
        </label>
        <div class="grid gap-[.45rem] text-[.82rem] text-[#c9d2cc]">
          Foto del comprobante
          <label for="photo" class="photo-drop" id="photo-drop">
            <input id="photo" type="file" accept="image/jpeg,image/png,image/webp,image/gif" hidden />
            <span class="photo-drop-prompt">Toca para adjuntar una imagen (JPG/PNG/WEBP, máx 5MB)</span>
            <span class="photo-drop-name" id="photo-name" hidden></span>
            <img id="photo-preview" class="photo-drop-preview" alt="Vista previa del comprobante" hidden />
          </label>
        </div>
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <button id="submit" class="btn btn-primary" type="submit">Guardar reporte</button>
          <button id="reset" class="btn btn-secondary" type="reset">Limpiar</button>
        </div>
      </form>
    </article>

    <article class="glass fleet-card rounded-[1.25rem] p-[1.25rem]">
      <div class="flex items-start justify-between gap-3">
        <div>
          <div class="eyebrow">HISTORIAL</div>
          <h2 class="m-0 mt-1 font-display text-[1.2rem] text-[var(--ink)]">Reportes recientes</h2>
        </div>
        <select id="history-bus" class="input w-auto min-w-40 max-md:w-full"></select>
      </div>
      <div id="history-list" class="mt-4 grid gap-[.5rem]"></div>
    </article>
  </div>
</DriverShell>

<style>
  .photo-drop { display: grid; gap: .35rem; place-items: center; min-height: 7rem; padding: 1rem; border: 1.5px dashed rgba(234,239,226,.18); border-radius: .8rem; background: rgba(5,11,14,.24); color: var(--muted); text-align: center; cursor: pointer; transition: border-color .2s, background .2s; }
  .photo-drop:hover, .photo-drop.is-active { border-color: rgba(72,228,224,.4); background: rgba(72,228,224,.05); }
  .photo-drop-preview { max-height: 12rem; border-radius: .6rem; object-fit: cover; }
  .photo-drop-name { font-size: .72rem; color: var(--cyan); }
</style>

<script>
  import { api, ApiError } from '../../lib/api';
  import { feedback, Swal } from '../../lib/feedback';

  const formatMoney = (value: string | number) => Number(value || 0).toLocaleString('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 });
  const escape = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] ?? c));
  const formatDate = (value: string | null | undefined) => value ? new Date(value).toLocaleString('es-CO', { dateStyle: 'medium', timeStyle: 'short' }) : '—';

  type Bus = { id: number; placa: string; marca: string; modelo: string };
  type Maintenance = { id: number; area: string; cost: string | number; detail: string; photoUrl: string | null; recordedAt: string };

  let buses: Bus[] = [];

  const fillBusSelect = (select: HTMLSelectElement) => {
    select.innerHTML = '<option value="">Selecciona la unidad</option>' + buses.map((b) => `<option value="${b.id}">${escape(b.placa)} · ${escape(b.marca)} ${escape(b.modelo)}</option>`).join('');
  };

  const loadBuses = async () => {
    const dashboard = await api('/driver-portal/dashboard');
    const upcoming = dashboard?.upcomingTrips ?? [];
    const active = dashboard?.activeTrip;
    const ids = new Set<number>();
    if (dashboard?.currentBus?.id) ids.add(dashboard.currentBus.id);
    if (active && dashboard.currentBus?.id) ids.add(dashboard.currentBus.id);
    upcoming.forEach((u: any) => { /* upcoming no trae busId directamente, pero los datos vienen del dashboard */ });
    const result = await api('/buses/catalog').catch(() => ({ data: [] }));
    const all: Bus[] = (result?.data ?? []).map((b: any) => ({ id: b.id, placa: b.placa, marca: b.marca, modelo: b.modelo }));
    buses = all;
    fillBusSelect(document.getElementById('bus') as HTMLSelectElement);
    fillBusSelect(document.getElementById('history-bus') as HTMLSelectElement);

    const params = new URLSearchParams(window.location.search);
    const presetBus = params.get('busId');
    if (presetBus) {
      (document.getElementById('bus') as HTMLSelectElement).value = presetBus;
      (document.getElementById('history-bus') as HTMLSelectElement).value = presetBus;
      await loadHistory();
    }
  };

  const loadHistory = async () => {
    const busId = (document.getElementById('history-bus') as HTMLSelectElement).value;
    const list = document.getElementById('history-list') as HTMLElement;
    if (!busId) { list.innerHTML = '<div class="empty-row">Selecciona una unidad para ver su historial.</div>'; return; }
    const areas = ['CAJA', 'TRANSMISION', 'RETARDADOR', 'LLANTAS', 'AIRE_ACONDICIONADO', 'MOTOR'];
    const results = await Promise.all(areas.map((area) => api(`/maintenance-records?busId=${busId}&area=${area}`).catch(() => ({ data: [] }))));
    const items: Maintenance[] = ([] as Maintenance[]).concat(...results.map((r: any) => r.data ?? []));
    items.sort((a, b) => new Date(b.recordedAt).getTime() - new Date(a.recordedAt).getTime());
    list.innerHTML = items.length
        ? items.slice(0, 10).map((m) => `<div class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-3 rounded-[.8rem] border border-[rgba(234,239,226,.1)] bg-[rgba(5,11,14,.24)] p-[.85rem]">${m.photoUrl ? `<img src="${m.photoUrl}" alt="" class="h-[2.4rem] w-[2.4rem] rounded-[.55rem] object-cover" loading="lazy" />` : `<span class="grid h-[2.4rem] w-[2.4rem] place-items-center rounded-[.55rem] bg-[rgba(245,173,75,.12)] font-display text-[.65rem] font-extrabold text-[var(--amber)]">${escape((m.area || '').slice(0, 2).toUpperCase())}</span>`}<div class="grid min-w-0 gap-1"><strong class="text-[.82rem] text-[var(--ink)]">${escape(m.area)}</strong><small class="text-[.66rem] text-[var(--muted)]">${escape(formatDate(m.recordedAt))}</small><p class="m-0 truncate text-[.72rem] text-[var(--muted)]">${escape(m.detail)}</p></div><strong class="font-display text-[.85rem] text-[var(--amber)]">${escape(formatMoney(m.cost))}</strong></div>`).join('')
        : '<div class="empty-row">Aún no hay reportes para esta unidad.</div>';
  };

  const setupPhotoDrop = () => {
    const drop = document.getElementById('photo-drop') as HTMLElement;
    const input = document.getElementById('photo') as HTMLInputElement;
    const name = document.getElementById('photo-name') as HTMLElement;
    const preview = document.getElementById('photo-preview') as HTMLImageElement;
    const prompt = drop.querySelector('.photo-drop-prompt') as HTMLElement;

    const update = (file?: File) => {
      if (!file) return;
      name.textContent = file.name;
      name.hidden = false;
      prompt.hidden = true;
      const reader = new FileReader();
      reader.onload = (event) => {
        preview.src = String(event.target?.result ?? '');
        preview.hidden = false;
      };
      reader.readAsDataURL(file);
    };

    input.addEventListener('change', () => update(input.files?.[0]));
    drop.addEventListener('click', () => input.click());
    drop.addEventListener('dragover', (event) => { event.preventDefault(); drop.classList.add('is-active'); });
    drop.addEventListener('dragleave', () => drop.classList.remove('is-active'));
    drop.addEventListener('drop', (event) => {
      event.preventDefault();
      drop.classList.remove('is-active');
      const file = event.dataTransfer?.files?.[0];
      if (!file) return;
      const dt = new DataTransfer();
      dt.items.add(file);
      input.files = dt.files;
      update(file);
    });
  };

  const setupForm = () => {
    const form = document.getElementById('maint-form') as HTMLFormElement;
    const submit = document.getElementById('submit') as HTMLButtonElement;
    const error = document.getElementById('error') as HTMLElement;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      error.hidden = true;
      const busId = (document.getElementById('bus') as HTMLSelectElement).value;
      const area = (document.getElementById('area') as HTMLSelectElement).value;
      const cost = (document.getElementById('cost') as HTMLInputElement).value;
      const detail = (document.getElementById('detail') as HTMLTextAreaElement).value.trim();
      const photo = (document.getElementById('photo') as HTMLInputElement).files?.[0];
      if (!busId || !area || !cost || !detail) {
        error.hidden = false; error.textContent = 'Completa todos los campos antes de guardar.'; return;
      }
      submit.disabled = true;
      try {
        feedback.loading('Subiendo reporte…');
        await api(`/maintenance-records/buses/${busId}`, { method: 'POST', body: JSON.stringify({ area, cost, detail }) });
        if (photo) {
          const data = new FormData(); data.append('photo', photo);
          await api(`/maintenance-records/buses/${busId}/photo`, { method: 'POST', body: data });
        }
        Swal.close();
        await feedback.success('Reporte guardado. El administrador ya lo puede revisar.', 'Listo');
        form.reset();
        (document.getElementById('photo-name') as HTMLElement).hidden = true;
        (document.getElementById('photo-preview') as HTMLElement).hidden = true;
        (document.querySelector('.photo-drop-prompt') as HTMLElement).hidden = false;
        (document.getElementById('history-bus') as HTMLSelectElement).value = busId;
        await loadHistory();
      } catch (cause) {
        Swal.close();
        const message = cause instanceof ApiError ? cause.message : 'Error inesperado.';
        error.hidden = false; error.textContent = message;
        await feedback.error(message, 'No se pudo guardar');
      } finally {
        submit.disabled = false;
      }
    });
    document.getElementById('history-bus')?.addEventListener('change', () => { void loadHistory(); });
  };

  const init = async () => {
    setupPhotoDrop();
    setupForm();
    try { await loadBuses(); }
    catch (cause) {
      await feedback.error(cause instanceof Error ? cause.message : 'Error inesperado.', 'No se pudo cargar');
    }
  };

  document.addEventListener('astro:page-load', () => { void init(); });
  void init();
</script>