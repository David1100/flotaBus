---
import '../styles/global.css';
const {title='flotaBus'}=Astro.props;
---
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#080d11" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="flotaBus" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/icons/icon-192.svg" />
    <link rel="apple-touch-icon" href="/icons/icon-192.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      // Keep modal scroll isolated from the document, including iOS Safari where
      // overflow:hidden alone can still move the page behind a fixed backdrop.
      (() => {
        let scrollY = 0;
        const getDialog = () => document.querySelector<HTMLElement>('.modal-backdrop:not([hidden])[aria-hidden="false"] [role="dialog"]');
        const sync = () => {
          const locked = Boolean(getDialog());
          if (locked === document.body.classList.contains('modal-lock')) return;
          if (locked) {
            scrollY = window.scrollY;
            document.documentElement.classList.add('modal-lock');
            document.body.classList.add('modal-lock');
            document.body.style.top = `-${scrollY}px`;
          } else {
            document.documentElement.classList.remove('modal-lock');
            document.body.classList.remove('modal-lock');
            document.body.style.removeProperty('top');
            window.scrollTo(0, scrollY);
          }
        };
        const focusables = (dialog: HTMLElement) => Array.from(dialog.querySelectorAll<HTMLElement>('button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])')).filter((element) => !element.hidden && element.offsetParent !== null);
        const observer = new MutationObserver(sync);
        observer.observe(document.body, { subtree: true, childList: true, attributes: true, attributeFilter: ['hidden', 'aria-hidden', 'class'] });
        document.addEventListener('keydown', (event) => {
          const dialog = getDialog();
          if (!dialog || event.key !== 'Tab') return;
          const items = focusables(dialog);
          if (!items.length) return;
          const first = items[0]; const last = items[items.length - 1];
          if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
          else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
        });
        sync();
      })();
      // Registration is deliberately production-only: local Astro development
      // must never be affected by a stale worker from a previous build.
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        void navigator.serviceWorker.getRegistration('/').then((registration) => {
          if (!registration) return navigator.serviceWorker.register('/sw.js', { scope: '/' });
          return registration;
        }).catch(() => {
          // A worker is an enhancement; an unavailable worker must not block UI.
        });
      }
    </script>
  </body>
</html>
