---
import '../styles/global.css';
const {title='flotaBus'}=Astro.props;
---
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#080d11" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="flotaBus" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/icons/icon-192.svg" />
    <link rel="apple-touch-icon" href="/icons/icon-192.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      // Registration is deliberately production-only: local Astro development
      // must never be affected by a stale worker from a previous build.
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        void navigator.serviceWorker.getRegistration('/').then((registration) => {
          if (!registration) return navigator.serviceWorker.register('/sw.js', { scope: '/' });
          return registration;
        }).catch(() => {
          // A worker is an enhancement; an unavailable worker must not block UI.
        });
      }
    </script>
  </body>
</html>
