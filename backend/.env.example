# Render service environment (never commit real values).
# Direct PostgreSQL connection for the normal Prisma engine.
# Use postgresql:// (or postgres://), never prisma://, for this deployment.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Optional separate PostgreSQL URL used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"
COOKIE_SECURE="false"
CORS_ORIGIN="http://localhost:4321"
NODE_ENV="development"
PORT="3000"
# Render uses GET /health for its health check.
# In production use: NODE_ENV=production, COOKIE_SECURE=true,
# CORS_ORIGIN=https://your-frontend.vercel.app and HTTPS PostgreSQL URLs.
ADMIN_USERNAME="admin"
ADMIN_NAMES="Fleet Administrator"
ADMIN_PHONE="000000000"
ADMIN_PASSWORD="replace-with-a-local-development-password"
